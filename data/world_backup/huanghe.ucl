# Zone: huanghe

    rooms "gulang" {
      name = "古浪"
      description = "古浪城建于西周，本名鬼武，后整修于汉，更名古浪。古浪是西北 地区的毛皮集散地，当初的紫羊羔皮袄，一出于张家口，另一出处就是 古浪了，过了古浪再往西四十里，跨过纪水河即到兰州。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "gulang" {
    room_id = rooms.gulang.id
