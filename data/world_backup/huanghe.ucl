  message = "店小二一下挡在楼梯前，白眼一翻：怎麽着，想白住啊！"
}
,
{
   # 阻挡条件（原样保留）： me->query_temp("rent_paid") && dir == "west" 
direction = "west"
  message = "店小二跑到门边拦住：客官已经付了银子，怎麽不住店就住 旁人还以为小店伺候不周呢！"
}

]
    }

