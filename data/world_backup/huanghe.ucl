    rooms "dacaigou" {
      name = "打柴沟"
      description = "打柴沟地势不如乌鞘岭那样险要，比较平坦，官道两边全是密林， 时常有樵夫砍柴的声音从林中传出。"
  x = 0
  y = 0
  z = 0
    }

