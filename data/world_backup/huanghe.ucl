    rooms "huangtu" {
      name = "黄土高原"
      description = "黄河像一把厉刃将黄土高原切开。无数条小溪流夹带着泥沙汇入黄 河，形成千沟万壑。沟壑之间的一块块平地叫做台塬。黄河沿蒙古高原 南边向东流淌，遇太行山脉的阻拦，便转头南下，形成晋陕的分界。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "huangtu" {
    room_id = rooms.huangtu.id
  northeast = rooms.hetao.id
  southwest = rooms.huanghe_2.id  }

# Generated from C:/files/git/mud/d/huanghe/jingyuan.c by LPCConverter
# Zone: huanghe

    rooms "jingyuan" {
      name = "靖远"
      description = "靖远是个不大不小的城镇，黄沙在离城四十里的地方被一排排的钻天 白杨树给挡住了。因此这里有了一块较大的绿洲，聚集了不少从别处来的 移民。这些白杨据说是当年唐朝李靖赶走了突厥后在这里屯兵时所种。这 也是靖远得名的由来。西边不远就是黄河，南面是一大片沙漠。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "jingyuan" {
    room_id = rooms.jingyuan.id
  north = rooms.hongshanxia.id
  south = rooms.shamo.id  }

# Generated from C:/files/git/mud/d/huanghe/kedian.c by LPCConverter
# Zone: huanghe

    rooms "kedian" {
      name = "客店"
      description = "这是一家当地居民开的鸡毛小店，楼下卖些卤菜和劣酒，楼上则是 客房。这是在进祈连山区前的唯一休息之处，贩夫走卒，采药客等皆在 此休憩，不时还可看见一两个寻仙访道之辈。墙上有一块牌子(paizi)， 西面是一间马厩。"
  x = 0
  y = 0
  z = 0
item_desc = {
 paizi = "楼上雅房，每夜五两白银。"
}
valid_leave = [
{
   # 阻挡条件（原样保留）： !me->query_temp("rent_paid") && dir == "up" 
