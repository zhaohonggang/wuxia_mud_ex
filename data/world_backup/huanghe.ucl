zones "huanghe" {
  name = "huanghe"
}

# Generated from C:/files/git/mud/d/huanghe/bingcao.c by LPCConverter
# Zone: huanghe

    rooms "bingcao" {
      name = "冰草湾"
      description = "冰草湾在营盘水的西南，平时人迹少至，因当地沙漠里长 着一种神奇的药草--冰草而得名。据说这种药草能解百毒，所 以偶有人来采这种草，不过常有毒虫出没，极为危险。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "bingcao" {
    room_id = rooms.bingcao.id
  southwest = rooms.shixiazi.id
  northeast = rooms.yinpanshui.id  }




  room_items "bingcao" {
    room_id = rooms.bingcao.id
    items = [
      { id = items.qianjiewugong.id }    ]
  }

# Generated from C:/files/git/mud/d/huanghe/caodi1.c by LPCConverter
# Zone: huanghe

    rooms "caodi1" {
      name = "草地"
      description = "这里是一遍绿茵茵的草地，像是一方绿色的毯子铺在地上。草丛中 开着一些不知名的小花，有红的、黄的，还有紫的。花瓣上、草叶上的 露珠闪着晶莹的光。东面是扬州城的北门。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "caodi1" {
    room_id = rooms.caodi1.id
  east = city.rooms.beimen.id
  west = rooms.caodi2.id  }

