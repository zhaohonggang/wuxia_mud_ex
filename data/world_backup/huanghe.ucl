# Zone: huanghe

    rooms "huanghe_2" {
      name = "黄河"
      description = "黄河出了青海，经甘肃之后，向东受到黄土高原的阻挡，转而向东 北流去。在流经黄土高原的过程中泥沙含量猛增，水色澄黄，就被称为 黄河。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "huanghe_2" {
    room_id = rooms.huanghe_2.id
  west = rooms.huanghe_3.id
  northeast = rooms.huangtu.id  }

# Generated from C:/files/git/mud/d/huanghe/huanghe_3.c by LPCConverter
# Zone: huanghe

    rooms "huanghe_3" {
      name = "黄河"
      description = "葛水过了古浪，和源于酒泉西北的洪水河于新城合流。到了这里， 河水的去势逐渐加强，挟带着千万吨的高原泥沙，势不可挡地向西南奔 去。由于此处水流湍急，这里的鱼大多肉厚脂丰。名扬天下的黄河大鲤 鱼即产于此。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "huanghe_3" {
    room_id = rooms.huanghe_3.id
  east = rooms.huanghe_2.id
  west = rooms.yongdeng.id  }

# Generated from C:/files/git/mud/d/huanghe/huanghegate.c by LPCConverter
# Zone: huanghe

    rooms "huanghegate" {
      name = "黄河帮寨门"
      description = "这是一所气势壮观的寨门，正中高挂着一面扁额--写着「黄河帮」 三个大字。寨里旗帜高挂，规模不小。黄河帮是黄河沿岸的一个大帮会， 平日飞扬跋扈，欺压百姓，做恶多端。帮主沙通天武功深湛，并与彭连 虎、梁子翁和灵智上人等高手结交，因此声势浩大。据闻其与金人勾结， 欲侵略中土。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "huanghegate" {
    room_id = rooms.huanghegate.id
  east = rooms.huanghe1.id
  west = rooms.guangchang.id  }


