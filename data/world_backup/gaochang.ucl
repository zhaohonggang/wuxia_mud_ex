zones "gaochang" {
  name = "gaochang"
}

# Generated from C:/files/git/mud/d/gaochang/dadian.c by LPCConverter
# Zone: gaochang

    rooms "dadian" {
      name = "高昌大殿"
      description = "这里就是传说中埋藏着无数宝藏高昌迷宫的大殿，四壁供 的都是泥塑木雕的佛像(fo).大殿之上有一个大大的龙椅，大堂 之上透着一股威严，有一块大匾，上书：          ##==================================##         ##                                  ##         ##     文     成      武     德     ##         ##                                  ##         ##==================================##  东西两面都是殿堂。"
  x = 0
  y = 0
  z = 0
item_desc = {
 fo = "这些佛像都摆着奇怪的姿势，你感觉可以参悟(think)基本拳脚的真意。"
}
    }

  room_exits "dadian" {
    room_id = rooms.dadian.id
  west = rooms.wroom1.id
  east = rooms.eroom1.id  }

# Generated from C:/files/git/mud/d/gaochang/entrance.c by LPCConverter
# Zone: gaochang

    rooms "entrance" {
      name = "高昌大门"
      description = "你转过了一排树木，来到这里。只见一座石山上嵌著两扇 铁铸的大门。两扇大门看样子重逾千钧，据说是古代高昌国王 为了抵御强敌而设计的。铁门上铁锈斑驳，显是历时已久的旧 物。但是门上的门环(huan)。铁门上写着：      ##==================================##     ##                                  ##     ##     高     昌      大     殿     ##     ##                                  ##     ##==================================##"
  x = 0
  y = 0
  z = 0
item_desc = {
 huan = "一只锈迹斑斑的金属门环，看样子似乎可以扭(turn)动。"
}
    }

  room_exits "entrance" {
    room_id = rooms.entrance.id
  southdown = rooms.shijie3.id  }

# Generated from C:/files/git/mud/d/gaochang/eroom1.c by LPCConverter
# Zone: gaochang

    rooms "eroom1" {
      name = "东大殿"
      description = "每一间房中大都供有佛像。偶然在壁上见到几个汉文，写 的是高昌国国王，文泰，大唐贞观十三年等等字样。有一座殿 堂中供的都是汉人塑像，匾上写着大成至圣先师孔子位，左右 各有数十人，写着颜回、子路、子贡、子夏、子张等名字。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "eroom1" {
    room_id = rooms.eroom1.id
  north = rooms.eroom2.id
  west = rooms.dadian.id  }

