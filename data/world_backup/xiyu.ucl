    characters "afanti" {
      name = "阿凡提"
      description = "他头上包着头巾，长着向上翘的八字胡，最喜欢 捉弄巴依、帮助穷人。他常给别人出谜语。"
  gender = "男性"
  age = 48
  shen_type = 1

  combat = {
    attitude = "peaceful"
    combat_exp = 2500
    con = 17
    dex = 20
    int = 15
    str = 25
  }

  inquiries = [
    { key = "here" value = "这里可真是个好地方。" },
    { key = "name" value = "我就是纳苏尔的阿凡提。" },
    { key = "小毛驴" value = "我的小毛驴在我到沙漠里骗巴依种金子时走丢了。" },
    { key = "巴依" value = "他把我关在这里，有吃有喝，我就不走了。巴依是个坏蛋，愿胡大惩罚他。" },
    { key = "毛驴" value = "我的小毛驴在我到沙漠里骗巴依种金子时走丢了。" },
    { key = "真主" value = "真主至大，万物非主，唯有真主。穆罕默德是真主的使者。" },
    { key = "纳苏尔" value = "是我出生的地方。" },
    { key = "胡大" value = "就是真主。又名安拉或阿拉。" },
    { key = "驴" value = "我的小毛驴在我到沙漠里骗巴依种金子时走丢了。" }
  ]

  skills = [
    { skill = "unarmed" level = 30 },
    { skill = "dodge" level = 25 }
  ]


  carry = [
    { id = items.wcloth.id },
    { id = items.dongbula.id }
  ]


  accept = [
    { kind = "any" accept = true msg = ["阿凡提笑得嘴都合不上了，说：多谢这位的帮助。"] }
  ]
    }

