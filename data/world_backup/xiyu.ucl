# Generated from C:/files/git/mud/d/xiyu/kedian.c by LPCConverter
# Zone: xiyu

    rooms "kedian" {
      name = "客店"
      description = "这是座落在丝绸之路上的一个小客栈，客栈虽小，不过如 果你要长途跋涉，在这里休息一下更好。墙上挂着一个牌子。"
  x = 0
  y = 0
  z = 0
item_desc = {
 paizi = "楼上住宿，每夜五两白银。"
}
valid_leave = [
{
   # 阻挡条件（原样保留）：! me->query_temp("rent_paid") && dir == "up"
direction = "up"
  message = "维吾尔少女连忙挡在楼梯前，急道：客官，您得先付钱啊！"
}
,
{
   # 阻挡条件（原样保留）：me->query_temp("rent_paid") && dir == "west"
direction = "west"
  message = "维吾尔少女跑到门边拦住：您付了银子，怎麽不住店就走了呢？"
}

]
    }

