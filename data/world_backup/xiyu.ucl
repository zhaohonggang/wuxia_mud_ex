      name = "马厩"
      description = "这是北疆小镇的马厩，常年供应新鲜草料。这里地处会疆 边民古朴而好客，把所有远方来宾均作兄弟看待。马夫们会把 马牵到马厩好生照看，将它们喂饱饮足，再梳理得清清爽爽直 伺候到客人上路。马厩木柱钉着块破木牌 (paizi)。马厩中堆 放著几堆草料，正中有一口泔槽。"
  x = 0
  y = 0
  z = 0
    }

