    rooms "jiayuguan" {
      name = "嘉峪关"
      description = "这是长城最西的关隘。岁月沧桑，仍掩不住它的风采。群 山环抱之下，更显它的雄浑。由于西域安定，久无战事，边关 守军已大为减少。一条大道向东延伸通向中原。出关向西，便 是著名的丝绸之路。"
  x = 0
  y = 0
  z = 0
    }

