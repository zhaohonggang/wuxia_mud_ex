    { kind = "money" accept = true msg = "对{npc}施了一礼。" },
    { kind = "any" accept = false msg = ["对{npc}施了一礼。"] }
  ]

  engage = {
    fight = { accept = false msg = "{npc}吓了一跳，慌忙对{name}道：“小的不敢，小的不敢！”" }
    hit = { accept = false msg = "{npc}愁眉苦脸的对{name}道：“可不要和我开这种玩笑！”" }
    kill = { accept = false msg = "{npc}一声长叹，道：“既然主人不留我了，罢罢罢！合则留，不合则去！我走了。” 说罢，老人丢下扫把，飘然而去。" }
  }
    }

