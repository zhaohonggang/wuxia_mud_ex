    rooms "chapu" {
      name = "聚朋茶馆"
      description = "几张方桌，几个方凳，茶馆的设施虽然简陋，却是一个大 好去处，许多人在这里谈天说地，你可以在这里打听到许多的 奇闻佚事，所以城里城外的人没事都会来这里座一座，抽上几 口水烟，天南地北的聊聊。"
  x = 0
