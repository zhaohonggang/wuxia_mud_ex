# Zone: kunming

    rooms "lianhua" {
      name = "莲花峰"
      description = "你爬上莲花峰，整个石林的风光尽收眼底，眼见北边不远 刻有一大字(zi)，峰壁上刻有一小诗 (shi)，向下观望，只见 脚下一潭碧水荡漾。奇景迭出，险象环生，峰回路转，异境天 开，常使人心动神驰，乐而忘返矣。"
  x = 0
  y = 0
  z = 0
item_desc = {
 zi = "########           ##    ##           ## 天 ##           ##    ##           ## 下 ##           ##    ##           ## 第 ##           ##    ##           ## 一 ##           ##    ##           ## 奇 ##           ##    ##           ## 观 ##           ##    ##           ########"
 shi = "攀登直欲夺天工              一顶凌云挈众峰              不是猱升挥汗水              何来双手抚晴空"
}
    }

