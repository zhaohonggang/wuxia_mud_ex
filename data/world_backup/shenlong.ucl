# Generated from C:/files/git/mud/d/shenlong/chufang.c by LPCConverter
# Zone: shenlong

    rooms "chufang" {
      name = "厨房"
      description = "这是神龙岛的厨房，中央摆着大圆桌，周围则放着几张竹椅。神 龙岛的弟子都在这里用餐。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "chufang" {
    room_id = rooms.chufang.id
  west = rooms.zoulang.id  }




