zones "shenlong" {
  name = "shenlong"
}

# Generated from C:/files/git/mud/d/shenlong/caodi.c by LPCConverter
# Zone: shenlong

    rooms "caodi" {
      name = "草地"
      description = "这里是一片青青的草地，有几个少年在玩耍。四周开满了各色的 鲜花，一阵凉风吹过，清新的空气中传来几缕淡淡的花香。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "caodi" {
    room_id = rooms.caodi.id
  south = rooms.kongdi.id
  north = rooms.xiaowu.id  }

