# Zone: shenlong

    rooms "houting" {
      name = "神龙教后厅"
      description = "这是神龙教的议事场所--潜龙厅。此厅较小，前面有两张大竹椅， 两边摆着五个小凳，看来是神龙教五龙使平时所坐的位置。"
  x = 0
  y = 0
  z = 0
    }

