# Generated from C:/files/git/mud/d/shenlong/npc/boy.c by LPCConverter
# Zone: shenlong

    characters "boy" {
      name = "年轻弟子"
      description = "这是一个神龙教弟子，一袭黄衣，混身透着一股邪气。"
  title = "神龙教黄龙使座下弟子"
  gender = "男性"

  combat = {
    attitude = "peaceful"
    max_jing = 150
    max_neili = 200
    max_qi = 200
  }

  chat_chance = 3
chats = [
    "年轻弟子忽然高声叫道：教主宝训，时刻在心，建功克敌，无事不成！",
    "年轻弟子忽然齐声叫道：众志齐心可成城，威震天下无比伦！",
    "年轻弟子忽然齐声叫道：神龙飞天齐仰望，教主声威盖八方！",
    "年轻弟子忽然齐声叫道：乘风破浪逞英豪，教主如同日月光！",
    "年轻弟子齐声叫道：教主永享仙福，寿与天齐！"
]


  skills = [
    { skill = "force" level = 40 },
    { skill = "dodge" level = 40 },
    { skill = "unarmed" level = 40 },
    { skill = "parry" level = 40 },
    { skill = "sword" level = 60 },
    { skill = "shedao-qigong" level = 30 },
    { type = "sword" skill = "shedao-qigong" }
  ]


  carry = [
    { id = items.xionghuang.id },
    { id = items.duanjian.id },
    { id = items.cloth.id }
  ]

    }

