# Zone: item

    characters "zhang" {
      name = "张天师"
      description = "这是一位仙风神骨，道貌岸然的法师。"
  nickname = "消息灵通"
  gender = "男性"
  age = 57

  combat = {
    attitude = "peaceful"
    con = 38
    dex = 31
    int = 35
    max_jing = 8000
    max_neili = 8000
    max_qi = 8000
    str = 28
  }

  inquiries = [
    { key = "仙术" value = "仙术只好算是中乘，还是不能和道术相比。" },
    { key = "妖术" value = "妖术啊，趋于下乘，不足为提。" },
    { key = "开光" value = "(: ask_me :)" },
    { key = "没钱" value = "没钱就去赚，跟我说什么。" },
    { key = "法术" value = "法术还分很多种呢，道术、妖术、仙术不一而足。" },
    { key = "浸入" value = "你要是不行我可以帮你看看(show)浸入需要用什么物品。" },
    { key = "穷" value = "看你也是一副穷命。" },
    { key = "道术" value = "道术？这可是本源正宗！" },
    { key = "魔法" value = "魔法？什么玩艺？" }
  ]

  skills = [
    { skill = "magic" level = 200 },
    { skill = "taoism" level = 350 }
  ]


  carry = [
    { id = items.dao_cloth.id }
  ]


  init = {
    greet_delay = 0
    add_actions = ["show", "summon"]
  }

  accept = [
    { kind = "money" accept = true msg = "这玩艺我可没啥兴趣！" },
    { kind = "any" accept = true msg = ["这玩艺我可没啥兴趣！", "算是给观里的香火么？那我就收下了！", "唉！看你也算有点心意，我就替你开一次光吧！", "好...好...这么照顾本观，我能帮你点什么？"] }
  ]

  engage = {
    fight = { accept = false msg = "没兴趣。" }
  }
    }

