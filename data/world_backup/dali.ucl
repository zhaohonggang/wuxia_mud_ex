      description = "球状，无人像，四角挂有黄铜铸灵鹫。四只灵鹫，口角噙有一枚 两头有孔的铜管，管内有金属簧片，鹫口、鹫颈、鹫腹皆是空心。每 当劲风吹来，经鹫嘴内铜管，在鹫腹内空气回旋荡扬，便发出悦耳的 鸣叫。不但平增灵鹫的神密气氛，亦可想见能工巧匠们的精湛技艺。"
  x = 0
  y = 0
  z = 0
