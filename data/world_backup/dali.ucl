    rooms "bingying" {
      name = "兵营"
      description = "大理国虽小，却重视精兵良将。然屈人必先屈志，兵戈 乃下下之策，段氏大理先与北邻宋朝修和，再以姻亲拉拢当 地人，多年无战事。这是城里的铁骑营，为皇族的嫡系，装 备给养无不优于中原地方。军士们严缜以待，盔甲鲜明，刀 剑锋利。"
  x = 0
  y = 0
  z = 0
    }

