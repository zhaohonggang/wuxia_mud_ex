zones "dali" {
  name = "dali"
}

# Generated from C:/files/git/mud/d/dali/atoubu.c by LPCConverter
# Zone: dali

    rooms "atoubu" {
      name = "阿头部"
      description = "阿头部是乌杂蛮的部落，和附近的乌蛮一样，也属于乌 夷。这里山高林密，不熟的人轻率进山，很容易迷路而导致 丧命。深山对猎人来说却是聚宝盆，山中野物皆是美味。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "atoubu" {
    room_id = rooms.atoubu.id
  north = rooms.lushui.id
  westup = rooms.gaolishan1.id
  southeast = rooms.yixibu.id  }


  room_characters "atoubu" {
    room_id = rooms.atoubu.id
    characters = [
      { id = characters.lieren.id }    ]
  }

# Generated from C:/files/git/mud/d/dali/badidian.c by LPCConverter
# Zone: dali

    rooms "badidian" {
      name = "巴的甸"
      description = "这里就是大理西部要镇巴的甸，是乌夷的重要治府，多 个乌夷部落分布在附近。坐于东泸水谷地正中，巴的甸四周 多农田，以此为中心，道路四通八达连接各方的部落。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "badidian" {
    room_id = rooms.badidian.id
  north = rooms.zhenxiong.id
  south = rooms.lushui.id
  eastup = rooms.lushuieast.id  }

# Generated from C:/files/git/mud/d/dali/baiyiminju.c by LPCConverter
# Zone: dali

    rooms "baiyiminju" {
      name = "摆夷民居"
      description = "摆夷是大理第一大族，大多散布在苍山洱海附近。摆夷 民居是以石块垒成，别局风格。朝花节那天，家家户户都把 盆栽花木摆在门口，摆搭成一座座的「花山」，招引四野乡 村的人来观花街。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "baiyiminju" {
    room_id = rooms.baiyiminju.id
  north = rooms.dahejieeast.id  }


  room_characters "baiyiminju" {
    room_id = rooms.baiyiminju.id
    characters = [
      { id = characters.oldman.id },
      { id = characters.girl1.id },
      { id = characters.girl1.id }    ]
  }

# Generated from C:/files/git/mud/d/dali/baiyiziguan.c by LPCConverter
# Zone: dali

    rooms "baiyiziguan" {
      name = "摆夷字馆"
      description = "摆夷文字有悠久的历史。撒尼叙事长诗「阿诗玛」，武 定石刻「风诏碑」，禄劝石刻「镌字崖」都是著名的摆夷文 献。摆夷文一般是由左向右竖行书写，用毛笔或竹签写在纸 或白布上。这儿就有一摆夷学者为人代写书信，告文，契约 等等。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "baiyiziguan" {
    room_id = rooms.baiyiziguan.id
  south = rooms.dahejieeast.id  }

# Generated from C:/files/git/mud/d/dali/banshan.c by LPCConverter
# Zone: dali

    rooms "banshan" {
      name = "半山竹林"
      description = "一大片茂密的成年竹林生长在半山腰的缓坡上。竹子对 大理地区各民族来说是，既是重要的建筑材料，也是日常生 活用品的原材料。山下的村庄里的摆夷人经常上山来采伐竹 子。北面山上有溪流下，到这里水流已经颇大，山民经常把 砍伐下的竹子丢在溪中，任其顺水飘流，到村子附近的溪水 里再捞起来。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "banshan" {
    room_id = rooms.banshan.id
  northup = rooms.shanjian.id
  east = rooms.buxiongbu.id  }


  room_characters "banshan" {
    room_id = rooms.banshan.id
    characters = [
      { id = characters.kanzhuren.id },
      { id = characters.kanzhuren.id }    ]
  }

# Generated from C:/files/git/mud/d/dali/bijishan.c by LPCConverter
# Zone: dali

    rooms "bijishan" {
      name = "碧鸡山顶"
      description = "碧鸡山坐在滇池的西岸上，与拓东城隔水相望。山势高 耸入云，山形如公鸡，漫山树木苍翠欲滴。此处乃极顶，已 达云端，东眺滇池一片汪洋，美不胜收。山下属大理国的昆 州。东西皆有下山之路。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "bijishan" {
