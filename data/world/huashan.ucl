# Generated from C:/files/git/mud/d/huashan/jianzhong.c by LPCConverter
# Zone: huashan

    rooms "jianzhong" {
      name = "剑冢"
      description = "只见许多石块堆著一个大坟。这坟（fen）背向山谷，俯仰空阔。 坟 旁立有一大石（stone），上刻：「剑冢」二字。站在此处， 山风刺骨， 俯瞰莲花峰（lianhua）下景色壮丽无比。"
  x = 0
  y = 0
  z = 2
item_desc = {
 fir_sword = "你拿起这柄剑，只觉着手轻飘飘的浑似无物，原来是柄竹剑。但见剑下的石刻道： 「四十岁後，不滞於物，草木竹石均可为剑。自此精修，渐进於无剑胜有剑之境。 」"
 piece = "你拿起长条石片 ，见石片下的青石上也刻有两行小字： 「紫薇软剑，三十岁前所用，误伤义不祥，乃弃之深谷。」"
 sec_piece = "细看石刻，见两行小字道：「重剑无锋，大巧不工。四十岁前恃之横行天下。」"
 thi_piece = "石上刻有两行小字：「凌厉刚猛，无坚不摧，弱冠前以之与河朔群雄争锋。」"
 big_stone = "一堆石头，似乎独孤求败所遗留之剑就在下面。"
 lianhua = "景色壮丽无比，可以从这里（jump lianhua）到莲花峰。"
}
    }
  room_exits "jianzhong" {
    room_id = rooms.jianzhong.id
    down = rooms.doctorroom.id
    up = rooms.jinshedong.id
    }

