zones "huashan" {
  name = "huashan"
}

# Generated from C:/files/git/mud/d/huashan/baichi.c by LPCConverter
# Zone: huashan

    rooms "baichi" {
      name = "百尺峡"
      description = "走过千尺幢，前面又见另一要命的百尺峡，百尺峡不似千尺幢般险峻 ，但亦十分陡峭，岩壁两侧设有铁索以作扶拦。百尺峡又称百丈崖，是一 座壁立千仞的悬崖。崖底到上面的最低的垭口处约百尺，故有是名。"
  x = -3
  y = 3
  z = -7
    }

  room_exits "baichi" {
    room_id = rooms.baichi.id
    eastup = rooms.pingxinshi.id
    northdown = rooms.qianchi.id
    }

# Generated from C:/files/git/mud/d/huashan/bingqifang.c by LPCConverter
# Zone: huashan

    rooms "bingqifang" {
      name = "兵器房"
      description = "这里是华山派的兵器房，四周放这几个兵器架，上面是华山派各弟子 平时练剑用的竹剑。"
  x = 1
  y = 0
  z = 0
valid_leave = [
{
   condition = "j > 1"
direction = ~
  message = "这位别那麽贪心，带走一把竹剑就够啦。"
}

]
    }

  room_exits "bingqifang" {
    room_id = rooms.bingqifang.id
    west = rooms.square.id
    }




  room_items "bingqifang" {
    room_id = rooms.bingqifang.id
    items = [
      { id = items.zhujian.id }    ]
  }

# Generated from C:/files/git/mud/d/huashan/buwei1.c by LPCConverter
# Zone: huashan

    rooms "buwei1" {
      name = "有所不为轩"
      description = "这就是华山掌门岳不群的居所「有所不为轩」，此处乃是 前厅，厅上挂着「正气堂」三字匾额。厅中很宽敞，却没什么 摆设，靠墙放着两把交椅。这里乃是岳不群议事及授徒的地方 后面是寝室。"
  x = 0
  y = 2
  z = 0
behavior = "guarded_exit"
behavior_config = {
  guard_npc = "lu dayou"
  exempt_directions = ["south"]
  permit_module = "Kantele.Npc.Guarder"
  permit_function = "permit_pass"
}
    }

  room_exits "buwei1" {
    room_id = rooms.buwei1.id
    east = rooms.buwei3.id
    west = rooms.garden.id
    south = rooms.qunxianguan.id
    north = rooms.buwei2.id
    }


  room_characters "buwei1" {
    room_id = rooms.buwei1.id
    characters = [
      { id = characters.dayou.id }    ]
  }



  room_items "buwei1" {
    room_id = rooms.buwei1.id
    items = [
      { id = items.hou.id }    ]
  }

# Generated from C:/files/git/mud/d/huashan/buwei2.c by LPCConverter
# Zone: huashan

    rooms "buwei2" {
      name = "寝室"
      description = "这里是岳不群的寝室，岳不群在江湖上人称「君子剑」，他虽为一大 派掌门，可他的卧室却布置的很简单。除了一张床，几只箱子，墙角有张 化妆台，只有靠墙一张红木书桌(desk)还显得略有气派。"
  x = 0
  y = 3
  z = 0
item_desc = {
 desk = "这是一张很结实的红木书桌，桌面上摆着几只狼毫笔，磨了一半的墨， 还有一叠未用的白纸。"
}
    }

  room_exits "buwei2" {
    room_id = rooms.buwei2.id
    south = rooms.buwei1.id
    }

# Generated from C:/files/git/mud/d/huashan/buwei3.c by LPCConverter
# Zone: huashan

    rooms "buwei3" {
      name = "偏厅"
      description = "偏厅里供奉着华山历代祖师的神位。正中神案的墙上是华山派开山祖 师风祖师的画象。画象神情清隽，非常传神。神案上香炉里插着三柱清香， 香烟袅袅上升，散发着一股檀香味。西面有扇门通往外面的正厅。"
  x = 1
  y = 2
  z = 0
    }

  room_exits "buwei3" {
    room_id = rooms.buwei3.id
    west = rooms.buwei1.id
    }

# Generated from C:/files/git/mud/d/huashan/canglong.c by LPCConverter
# Zone: huashan

    rooms "canglong" {
      name = "苍龙岭"
      description = "华山五峰中最惊险的是北峰，北峰之上最陡峭的则是苍龙岭。此岭高 约百米，宽仅一米，而登山之路则在其山脊之上，两侧脊坡光滑挺拔，其 下悬崖深邃，云涛隐伏，岭体蜿蜒逶迤，体青背黑，如苍龙腾空，故有是 名。岭侧有一石碑(shibei)。     从这里往东是下山的路，再往南是上其它四峰的路，西面是华山极险 处之一，叫做“舍身崖”。"
  x = -2
  y = 1
  z = -2
item_desc = {
 shibei = "石碑刻着几个大字：「韩退之投书处」，据说当年韩愈爬上此岭之后，再 也不敢下来，自以为要死在山上，就在山上写信投下来，和家人诀别。后 来还是华阴县的县官派人上山拿绳子把他捆着吊下来的。"
}
    }

  room_exits "canglong" {
    room_id = rooms.canglong.id
    westup = rooms.sheshen.id
    northup = rooms.yuntai.id
    eastdown = rooms.shangtianti.id
    }


  room_characters "canglong" {
    room_id = rooms.canglong.id
    characters = [
      { id = characters.liang_fa.id }    ]
  }

