# Generated from C:/files/git/mud/d/huashan/yuntai.c by LPCConverter
# Zone: huashan

    rooms "yuntai" {
      name = "云台峰"
      description = "太华北峰又名云台峰，它和南面的诸峰连成一条崎岖的长岭，构成 了一条鱼椎脊似的登峰天梯。香炉峰和梁张峰拱立左右，峥嵘兀突。云 台四面都是悬崖绝壁，十分险峻。峰顶建有真武宫，朝南通道上立着石 牌楼两座，高镶“北峰顶”三字。"
  x = -2
  y = 2
  z = -1
    }

  room_exits "yuntai" {
    room_id = rooms.yuntai.id
    southdown = rooms.canglong.id
    }

# Generated from C:/files/git/mud/d/huashan/yunu.c by LPCConverter
# Zone: huashan

    rooms "yunu" {
      name = "玉女峰"
      description = "这里是华山的中峰，玉女峰。传说春秋时隐士萧史善吹洞箫，箫声引 动了秦穆公女儿弄玉的爱慕，抛弃了宫廷生活，跟萧史来此隐居，故称玉 女峰。这里地势略为平缓，不似其它四峰般险峻，江湖上赫赫有名的华山 剑派就在此处。东边有所小小的庙宇，那就是玉女祠了。北面稀稀落落有 十几间房子，是华山派的地方，闲杂游客最好别往那里去。"
  x = 0
  y = -1
  z = 0
    }

  room_exits "yunu" {
    room_id = rooms.yunu.id
    northeast = rooms.xiaolu1.id
    southdown = rooms.yunupath1.id
    north = rooms.square.id
    west = rooms.yunuci.id
    westdown = rooms.zhenyue.id
    }


  room_characters "yunu" {
    room_id = rooms.yunu.id
    characters = [
      { id = characters.yue_lingshan.id }    ]
  }

# Generated from C:/files/git/mud/d/huashan/yunuci.c by LPCConverter
# Zone: huashan

    rooms "yunuci" {
      name = "玉女祠"
      description = "玉女祠里供奉的到底是哪位玉女，有许多不同的说法，现在所能看到 的只一尊呆板的石像。祠中大石上有一处深陷，凹处积水清碧，这是玉女 的洗脸盆，碧水终年不干。玉女祠左边是一处山崖(cliff)，很是陡峭。"
  x = -1
  y = -1
  z = 0
item_desc = {
 cliff = "玉女祠下的山崖很是陡峭，似乎连接了一条小路。"
}
    }

  room_exits "yunuci" {
    room_id = rooms.yunuci.id
    east = rooms.yunu.id
    }

