    rooms "yuquan" {
      name = "玉泉院"
      description = "这里因屋后的玉泉而得名，是宋代陈希夷隐居的地方。周围生着十二 株大龙藤，夭矫多姿，枝干中空，就如飞龙相似，相传是希夷先生陈抟老 祖所植。院内绿荫蔽日，泉石如画，流水萦回，回廊曲折。院中有清泉一 股，泉水甘冽，传与山顶镇岳宫玉井相通，故名玉泉，玉泉院因此得名。"
  x = -6
  y = 8
  z = -12
    }

