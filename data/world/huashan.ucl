      description = "传说华山三圣母爱上了一个叫刘彦昌的书生，结为夫妇，其兄二郎神 反对他们结合，将她压在华山下，她的儿子沉香长大后用斧子劈开华山， 救出了母亲。旁边有一块中间裂开的大石，象用斧子劈开的一般，叫做斧 劈石。传说就是沉香劈山救母的地方。"
  x = -4
  y = -2
  z = 1
    }

  room_exits "chengxiang" {
    room_id = rooms.chengxiang.id
    eastdown = rooms.lianpath2.id
