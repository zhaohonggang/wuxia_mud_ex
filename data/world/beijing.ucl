    rooms "cabinet" {
      name = "威武阁"
      description = "迎门的一幅山水画非凡脱俗，定是名家手笔，画上有一块大匾，匾上书着 三个大字：“威武阁”。小几上的一对羊脂玉瓶里插的满满的都是晶莹剔透的 白菊，不知哪里放了个香炉，吐着一缕似有似无的暗香。一位镖师站在楼梯口， 守着上楼的路。也不知楼上住的是什么人。"
  x = -1
  y = 8
  z = 0
