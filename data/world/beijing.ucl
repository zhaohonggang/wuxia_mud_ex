    characters "zhuangyu" {
      name = "庄允城"
      description = "这是个饱读诗书，却手无搏鸡之力的书生。 因编辑‘明史辑略’，被吴之荣告发，全家逮入京中。"
  gender = "男性"
  age = 40

  combat = {
    attitude = "peaceful"
    int = 28
  }

  inquiries = [
    { key = "吴之荣" value = "把他送到庄府去有好处。" },
    { key = "威望" value = "(: ask_weiwang :)" },
    { key = "江湖威望" value = "(: ask_weiwang :)" }
  ]

  chat_chance = 5
chats = [
    "庄允城说道：只怪我当初好心，在书中夹了金叶送与他， 谁想这狼心狗肺的家伙竟然就去告发了我。唉...",
    "庄允城说道：谁要把吴之荣抓到庄府就好了。",
    "庄允城突然说道: 江湖威望很重要，威望高大有好处啊。",
    "庄允城叹了口气，说道：我知道鳌拜书房的秘密，只可惜我出不去啊。",
    "庄允城说道：谁要救了我，我一定把我知道的都告诉他。"
]


  skills = [
    { skill = "literate" level = 100 }
  ]


  carry = [
    { id = items.cloth.id }
  ]


  accept = [
    { kind = "item_name" name = "明史辑略" accept = true msg = ["庄允城笑到：书里有金叶子，难道你不知道吗？", "庄允城说：替我把吴之荣这厮抓到庄府去吧，我不行了。", "庄允城喘了口气，又说：庄府在京城东北边。"] },
    { kind = "any" accept = true msg = ["庄允城笑到：书里有金叶子，难道你不知道吗？", "庄允城说：替我把吴之荣这厮抓到庄府去吧，我不行了。", "庄允城喘了口气，又说：庄府在京城东北边。"] fail_msg = ["你没有这件东西。"] }
  ]
    }

