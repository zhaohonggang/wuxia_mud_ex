# Generated from C:/files/git/mud/d/beijing/aofu_dating.c by LPCConverter
# Zone: beijing

    rooms "aofu_dating" {
      name = "鳌府大厅"
      description = "这里是鳌拜府的大厅，大厅相当的宽敞明亮，四周的墙上悬挂满了各朝名 人的真迹，正堂坐着一个满面虬须，身材魁梧，身着黄马褂的中年男子，看来 那就是当朝第一大臣，被御封为“满洲第一勇士”的鳌拜了。大厅往北是一条 走廊，那是通往鳌府的后院所在。"
  x = -2
  y = 4
  z = 0
valid_leave = [
{
   # 阻挡条件（原样保留）：objectp(ob = present("ao bai", environment(me))) && living(ob) && dir == "north"
direction = "north"
  message = "鳌拜大声喝道：他奶奶的，你要干嘛？"
}

]
    }

  room_exits "aofu_dating" {
    room_id = rooms.aofu_dating.id
    south = rooms.aofu_dayuan.id
    north = rooms.aofu_zoulang2.id
    }


  room_characters "aofu_dating" {
    room_id = rooms.aofu_dating.id
    characters = [
      { id = characters.aobai.id },
      { id = characters.yahuan_a.id }    ]
  }

