    rooms "chashi" {
      name = "茶室"
      description = "满屋的果香和茶香，沁人心脾。山西面的茶农们因感激武 当弟子保护他们免受土匪的骚乱和官府的苛捐杂税，每年开春 采茶季节，总要送来上好的茶叶。这茶叶由少女在三更至日出 间采摘，放在怀中用体温焙制，得天地精华，汇处子体香，故 名女儿香，据说喝了能提精补神，十分珍贵。"
  x = 2
  y = -2
  z = 0
    }

