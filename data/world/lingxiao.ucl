# Generated from C:/files/git/mud/d/lingxiao/npc/dizi.c by LPCConverter
# Zone: lingxiao

    characters "dizi" {
      name = "凌霄弟子"
      aliases = ["lingxiao dizi", "dizi", "lingxiao"]
      description = "这是一个凌霄城的普通弟子。"
  gender = "男性"
  age = 20
  shen_type = 0
  score = 50000

  combat = {
    attitude = "peaceful"
    combat_exp = 20000
    con = 30
    dex = 30
    int = 30
    max_jing = 400
    max_neili = 500
    max_qi = 800
    str = 30
  }

  chat_chance = 3
chats = [
    "一位凌霄弟子小声说道：听说老爷子发疯了，还把封师叔的膀子卸了下来，不知道是真是假。",
    "一位凌霄弟子冷笑道：打起来了好啊，这下子半年一次的论剑也不用开了，免得挨骂。",
    "一位凌霄城弟子哼了一声，道：师父一向说我们凌霄城的剑法天下无双，改天我要让那些江湖中人见识一下。",
    "一位凌霄城弟子不屑道：老爷子的病是气出来的，你们不知道吧。",
    "一位凌霄城弟子哼了一声，道：马上赏善罚恶使者要来了，我们还是先跑路吧。",
    "一位凌霄城弟子摇摇头，道：就算赏善罚恶使者来了，只要有人接令牌，我们这些小人物也没事。",
    "一位凌霄城弟子打了个哈欠，道：昨天轮到老子守城，差点被冷死。",
    "一位凌霄城弟子搓了搓手，道：昨天我从师父的柜子里偷了瓶参阳玉酒，嘿嘿……真他妈的不错。",
    "一位凌霄城弟子看看四周，小声说道：上次谢烟客来的时候，带的那个狗杂种，听说是长乐帮的帮主。",
    "一位凌霄城弟子摆了个架势，大声说：武当少林算什么！老爷子说了，武林中就我们凌霄城最厉害！",
    "一位凌霄城弟子掏出一瓶酒，喝了两口，红着眼睛说：老爷子是被成师叔祖他们暗算了！我等会就去把他救出来！",
    "一位凌霄城弟子低声对另一位弟子说，要想进地牢，就必须先拿到寒玉牌啊。",
    "一位凌霄城弟子愤愤说道：那个狗杂种，上次竟想对阿绣非礼，要是让我遇见，哼哼哼！"
]


  skills = [
    { skill = "unarmed" level = 100 },
