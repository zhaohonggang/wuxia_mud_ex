# Generated from C:/files/git/mud/d/lingxiao/didi.c by LPCConverter
# Zone: lingxiao

    rooms "didi" {
      name = "地底"
      description = "这里按地势而言，早已深入地底，乃是大雪山的山腹之中了。 四周土地潮湿，充满了一股浓浓的泥土味。墙上依然插着几支火 把，照得四周亮堂堂的。一个腰悬利剑，神情警惕的剑士，正守 在一扇巨大的石门(men)旁。"
  x = 1
  y = -2
  z = -2
item_desc = {
 men = "一扇厚厚的石门，怕有千斤之重。看样子很难推(push)开。"
}
    }

