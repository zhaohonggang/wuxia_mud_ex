# Generated from C:/files/git/mud/d/lingxiao/houyuan1.c by LPCConverter
# Zone: lingxiao

    rooms "houyuan1" {
      name = "后园"
      description = "这里是凌霄派的后园。小桥流水，菏塘低阁。层台耸翠，上 出重霄。飞阁流丹，下临无地。在这万里雪山之上，象这种温暖 如春的地方，实不多见，也难怪当年凌霄祖师要建派于此了。菏 塘中的一方假山上，一缕清泉汩汩流出，雾气蔼蔼，如梦如幻。"
  x = 0
  y = 3
  z = 0
    }

