      { id = characters.dizi.id },
      { id = characters.dizi.id }    ]
  }

# Generated from C:/files/git/mud/d/lingxiao/bridge.c by LPCConverter
# Zone: lingxiao

    rooms "bridge" {
      name = "小桥"
      description = "这是一座江南园林似的小桥，桥下莲叶田田，清波荡漾，水 滑栏碧，池鱼自得。城外虽有雪花飞舞之姿，朔风呼号之势，此 处却得地气温暖之润，得天独厚，有如江南之景，现于西域大漠 之地。"
  x = 0
  y = 5
  z = 0
    }

  room_exits "bridge" {
    room_id = rooms.bridge.id
    north = rooms.book.id
    south = rooms.houyuan2.id
    }

# Generated from C:/files/git/mud/d/lingxiao/car.c by LPCConverter
# Zone: lingxiao

    rooms "car" {
      name = "冰车"
      description = "这里是凌霄城的冰车 (che)下山之处，此冰车是凌霄城为了 能直达山脚，所特制而成，能从这雪山之巅飞速滑下，是从雪山 去往山下的交通工具。你可以乘坐(take)它下山。"
  x = -1
  y = -2
  z = 0
item_desc = {
 che = "一台以上好的红杉木所制的冰车，是凌霄弟子下山之用。"
}
    }

