zones "lingxiao" {
  name = "lingxiao"
}

# Generated from C:/files/git/mud/d/lingxiao/bar.c by LPCConverter
# Zone: lingxiao

    rooms "bar" {
      name = "石崖客栈"
      description = "这里是雪山山路上的一间客栈，虽然店面简单朴实，平日也 不可能有什么游客来这雪域游山玩水，但在这大雪山上，却也是 独一无二的客栈。到了这地方，要是不想被活活冻死在这万里冰 川上，只怕还是得照顾一下这里的生意。所以这家客栈倒也是生 意兴隆。"
  x = 0
  y = 0
  z = 1
    }

  room_exits "bar" {
    room_id = rooms.bar.id
    up = rooms.dilao.id
    down = rooms.dadian.id
    west = rooms.shiya.id
    }


  room_characters "bar" {
    room_id = rooms.bar.id
    characters = [
      { id = characters.xiaoer2.id },
      { id = characters.walker.id },
      { id = characters.dizi.id },
      { id = characters.dizi.id }    ]
  }

# Generated from C:/files/git/mud/d/lingxiao/bingti.c by LPCConverter
# Zone: lingxiao

    rooms "bingti" {
      name = "冰梯"
      description = "这里是一座晶莹剔透的冰梯。此处地处万里雪山顶峰，连接 凌霄城的天险防线分天崖。悬在这里，只觉罡风凛冽，如利刃割 体，身侧寒云渺渺，白烟氤氲。桥下万载寒冰，在日光下闪烁生 辉。山寒水冷，众鸟飞尽，惟有朵朵白雪，依旧飘零。这里往往 有伤心失意人跳崖自尽。"
  x = -1
  y = 4
  z = 5
    }

  room_exits "bingti" {
    room_id = rooms.bingti.id
    down = rooms.fentianya.id
    up = rooms.shanya.id
    }

# Generated from C:/files/git/mud/d/lingxiao/book.c by LPCConverter
# Zone: lingxiao

    rooms "book" {
      name = "书房"
      description = "这里是白自在的书房，一室之内，放满了各类书籍。白自在 虽然狂妄自大，但说到他学问，却当真也是饱读诗书，学富五车。 这里的书架，大大小小，总有十几个吧。白自在的书童正在这为 他整理。"
  x = 0
  y = 6
  z = 0
    }

  room_exits "book" {
    room_id = rooms.book.id
    south = rooms.bridge.id
    north = rooms.weideju.id
    }


  room_characters "book" {
    room_id = rooms.book.id
    characters = [
      { id = characters.su.id }    ]
  }

# Generated from C:/files/git/mud/d/lingxiao/boot.c by LPCConverter
# Zone: lingxiao

    rooms "boot" {
      name = "山路"
      description = "这里是一座大山的山麓，抬头仰望，山上积雪皑皑，在日光 下映得闪烁生辉。山上云海迷茫，雪峰林立，阳光交辉在白云与 飞雪之间，隐隐能看见有一座城在山顶。路旁有一块木板(sign)。"
  x = -1
  y = -2
  z = -3
item_desc = {
 sign = "万  古  凌  霄  一  羽  毛"
}
    }

  room_exits "boot" {
    room_id = rooms.boot.id
    westup = rooms.sroad1.id
    southeast = xuedao.rooms.sroad1.id
    }


