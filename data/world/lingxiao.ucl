# Generated from C:/files/git/mud/d/lingxiao/yudong.c by LPCConverter
# Zone: lingxiao

    rooms "yudong" {
      name = "玉洞"
      description = "如果说外面的冰洞象梦幻的世界一样，那么，这里就是真正 的天堂。整个洞内，无论洞壁洞顶，全是墨绿的玉石。玉质温润 细滑，竟是和田之玉。就算在权贵之家，和田玉也是了不起的财 富。一块手掌般大的和田玉，就够一户中等人家过上一辈子。但 是，这里最吸引人的，还是中间的玉台上天然所生的一块珠子， 它散发出幽幽光泽，照的满室皆绿。"
  x = 0
  y = 0
  z = 6
    }

  room_exits "yudong" {
    room_id = rooms.yudong.id
    down = rooms.yuan.id
    out = rooms.wave.id
    }

