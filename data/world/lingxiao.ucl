    rooms "yuan" {
      name = "分天渊侧"
      description = "过了分天崖，回头望望，白云寥寥，云气弥漫，想想还有点 后怕，但毕竟过来了。往前看，就是凌霄城了，这座武林中传说 的名城，终于出现在你面前了，赶快进去看看吧。"
  x = 0
  y = 0
  z = 5
    }

