    rooms "cheng" {
      name = "居室"
      description = "这是成自学的房间。成自学虽和四位师弟一样，由白自在代 师授艺，但在四位师兄弟中，他和白自在关系最好。同时他为人 方正，刚严不曲，最得白自在信任，所以白自在在失踪以前，把 凌霄城的寒玉牌交给他保管。这间屋子整洁典雅，只在桌上放着 一卷未写完的帛卷。"
  x = 1
