# Generated from C:/files/git/mud/d/lingxiao/gate.c by LPCConverter
# Zone: lingxiao

    rooms "gate" {
      name = "凌霄内门"
      description = "这里是凌霄城的城门。本来凌霄城少有外敌入侵，但由于地 处西域，隆冬之际常有饿狼前来侵袭，故修筑此大城以做为抵挡。 向城内望去，只见人头攘攘，很是繁华，想不到在这西域雪山绝 顶，却有着一个如此去处。内门前那张厚厚的吊桥(bridge)正紧 紧关闭着。如果想要进入的话，必须要请人开(open)才行。"
  x = 0
  y = -5
  z = 0
item_desc = {
 bridge = "这是一张极大的吊桥，乃是凌霄城的一道防线。"
}
valid_leave = [
{
   condition = "(objectp(present('wen wanfu',environment(me)))) && dir == 'north'"
direction = ~
  message = "闻万夫身形一展，挡住你道：凌霄城历年来的规矩，外人入城不得佩带兵刃。"
}

]
    }

  room_exits "gate" {
    room_id = rooms.gate.id
    north = rooms.iceroad1.id
    westup = rooms.wallw1.id
    eastup = rooms.walle1.id
    }


  room_characters "gate" {
    room_id = rooms.gate.id
    characters = [{ id = characters.dizi.id },
      { id = characters.dizi.id },
      { id = characters.dizi.id }, { id = characters.wen_wanfu.id },
      { id = characters.lingxiao_wenwanfu.id }]
  }




# Generated from C:/files/git/mud/d/lingxiao/hotel.c by LPCConverter
# Zone: lingxiao

    rooms "hotel" {
      name = "冰雪轩"
      description = "这里是凌霄城里最大的酒楼冰雪轩，同时也是凌霄城的名迹 之一。大凡过往旅客，不管是贩夫走卒，还是文人墨客，迁客骚 人，都要到此一醉。当年谢烟客独闯凌霄城，在此狂饮十八坛烈 酒之后，杀入凌霄内城。从此，凌霄城冰雪轩的大名，便是名闻 四海。"
  x = -1
