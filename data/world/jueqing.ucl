    rooms "dating" {
      name = "大厅"
      description = "绝情谷大厅正中摆放着一个红棕色茶几，四周并排着几个 椅子，椅背上刻有些许图案，虽单调了点，但也显得非常别致， 厅角的几盆花木散发出阵阵清香。"
  x = 0
  y = 0
  z = 0
    }

