# Generated from C:/files/git/mud/d/jueqing/chufang.c by LPCConverter
# Zone: jueqing

    rooms "chufang" {
      name = "厨房"
      description = "这里是绝情谷内堂西侧一间厨房，平常绝情谷的弟子们饿 了便可以到这里来要(serve)些食物吃。房中灶火正旺，一个 厨师正忙的满头大汗。屋角放着一个大水缸。"
  x = -1
  y = 1
  z = 0
    }

