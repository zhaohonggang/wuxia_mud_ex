# Generated from C:/files/git/mud/d/jueqing/duanchang.c by LPCConverter
# Zone: jueqing

    rooms "duanchang" {
      name = "断肠崖"
      description = "到得此处只见崖壁上刻了“断肠崖”三字，自此而上，数 十丈光溜溜的寸草不生，终年云雾环绕，天风猛烈，便飞鸟也 甚难在峰顶停足。山崖下临深渊，自渊口下望，黑黝黝的深不 见底。“断肠崖”前后风景清幽，只因地势实在太险，山石滑 溜溜，极易掉入深渊崖，俯视深谷，但见灰雾茫茫四下里山石 嶙峋，树木茂密。隐约可见崖壁上用利器刻着两行字(zi)。抬 头见一座山峰冲天而起，正是绝险之地的绝情峰。"
  x = -5
  y = 5
  z = 1
    }

  room_exits "duanchang" {
    room_id = rooms.duanchang.id
    north = rooms.shanlu7.id
    east = rooms.shulin2.id
    southdown = rooms.shanlu5.id
    }

# Generated from C:/files/git/mud/d/jueqing/eyutan1.c by LPCConverter
# Zone: jueqing

    rooms "eyutan1" {
      name = "鄂鱼潭岸上"
      description = "鄂鱼潭深处地底，寒似冰窟。潭中(tan)一团黑子晃动，仔 细一看竟是许多凶猛的鄂鱼。 只见不远处似有一个洞口，但由 于深潭相隔，不知如何过去。"
  x = 0
  y = 0
  z = 1
item_desc = {
 tan = "潭中鄂鱼成群，凶猛无比。 恐怕只有施展轻功穿(cross)过去了。"
}
    }
  room_exits "eyutan1" {
    room_id = rooms.eyutan1.id
    down = rooms.dating.id
    up = rooms.eyutan2.id
    }

