# Generated from C:/files/git/mud/d/jueqing/danfang.c by LPCConverter
# Zone: jueqing

    rooms "danfang" {
      name = "丹房"
      description = "行至这里，顿感炽热更盛，只见里面是间丈许见方的石室。 石室中央摆有一个一人多高的火炉(huo lu)。两名粗工正在搬 堆柴炭，这两人上身赤膊，下身只穿一条牛头短裤，全身大汗 淋漓。"
  x = -2
  y = 2
  z = 0
    }

  room_exits "danfang" {
    room_id = rooms.danfang.id
    west = rooms.zhulin3.id
    south = rooms.huohuanshi.id
    }

