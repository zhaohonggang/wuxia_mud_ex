# Generated from C:/files/git/mud/d/changan/bank.c by LPCConverter
# Zone: changan

    rooms "bank" {
      name = "四海钱庄"
      description = "这是长安城的一家老字号钱庄，老板是山西人，这家钱庄从他的祖 先来到这里时就开始办起，一直传到他的手里。钱庄的信誉非常好，而 且在全国各地都开了分店。它发行的银票通行全国。钱庄的门口挂有一 块牌子(paizi)。"
  x = 1
  y = 1
  z = 0
item_desc = {
 paizi = "本钱庄提供的服务有： -------------------------------- check(chazhang)        查帐 -------------------------------- deposit(cun)           存款 -------------------------------- withdraw(qu)           取款 -------------------------------- convert(duihuan)       兑换钱币 --------------------------------"
}
    }

  room_exits "bank" {
    room_id = rooms.bank.id
    south = rooms.qixiang4.id
    }


  room_characters "bank" {
    room_id = rooms.bank.id
    characters = [
      { id = characters.tiegongji.id }    ]
  }

