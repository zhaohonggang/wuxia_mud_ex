    rooms "baodian" {
      name = "大雄宝殿"
      description = "大雄宝殿内，金壁辉煌，雕梁画洞，殿两侧共安放了六尊古佛，古 佛之後有释伽与天龙诸部的壁画。大雄宝殿为历朝皇帝招见僧侣、读经 念佛的所在，是以陈设与其馀诸殿大不相同，倒像是庄严肃穆的佛堂一 般。"
  x = -1
  y = -8
  z = 0
    }

