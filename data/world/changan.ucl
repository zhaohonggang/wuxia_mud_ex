    rooms "baihu1" {
      name = "白虎街"
      description = "白虎街是长安城中心大街，青石板路笔直的伸展出去，一路上行人 比肩，笙歌处处。景物之美，直如神仙境地。西边是扶风道。北面 则是阴森森的大牢，有几个狱卒百无聊赖的呆在门口。"
  x = -1
  y = -2
  z = 0
    }

  room_exits "baihu1" {
    room_id = rooms.baihu1.id
    east = rooms.baihu2.id
    west = rooms.fufeng1.id
    }


