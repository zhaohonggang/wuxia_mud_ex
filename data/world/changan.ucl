      description = "这里是长安城里维持治安的巡捕工作的地方。房门口放着两个青铜 狮，房内是一个大厅，墙上漆着白色的漆，漆得很厚，仿佛不愿人看出 这墙是石壁，是土，还是铜铁所做。有几个横眉立目，嘴脸凶顽的巡捕 坐在一起，似乎在商量着什么。南边有一个小门，似乎上了锁。"
  x = 3
  y = -6
