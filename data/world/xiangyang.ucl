zones "xiangyang" {
  name = "xiangyang"
}

# Generated from C:/files/git/mud/d/xiangyang/anfugate.c by LPCConverter
# Zone: xiangyang

    rooms "anfugate" {
      name = "安抚使衙门"
      description = "这是安抚使衙门的大门，铜皮包门似乎极为沉重，上面有 两个明晃晃的铜环；大门紧闭，里面却传出一阵阵嬉笑声，和 门口的肃杀很不协调。想来这个安抚使大人的日子还是过得蛮 滋润的。"
  x = 0
  y = 2
  z = 0
    }

  room_exits "anfugate" {
    room_id = rooms.anfugate.id
    south = rooms.anfupailou.id
    }

# Generated from C:/files/git/mud/d/xiangyang/anfupailou.c by LPCConverter
# Zone: xiangyang

    rooms "anfupailou" {
      name = "安抚府牌楼"
      description = "这里是安抚使府前的一座牌楼，高达二丈，由黄玉制成， 和东面的将军府屋顶的琉璃瓦在阳光的照耀下黄白掩映，金碧 辉煌，令人目为之眩，感觉分外巍峨庄严。你抬头望去，但见 牌楼上四个大金字“安抚使府”。牌楼下站着两派手那刀枪的 宋兵，紧紧盯着每一个靠近这儿的人。北面就是安抚府大院了。 南面就是襄阳的中央广场。"
  x = 0
  y = 1
  z = 0
    }

  room_exits "anfupailou" {
    room_id = rooms.anfupailou.id
    north = rooms.anfugate.id
    south = rooms.guangchang.id
    }

# Generated from C:/files/git/mud/d/xiangyang/biaoju.c by LPCConverter
# Zone: xiangyang

    rooms "biaoju" {
      name = "福威镖局"
      description = "你来到一座结构宏伟的建筑前，左右石坛上各插着一根两 丈多高的旗杆，杆上青旗飘扬。右首旗子用金线绣着一头张牙 舞爪的狮子，狮子上头有一只蝙蝠飞翔。左首旗子上写着“福 威镖局襄阳分号”八个黑字，银钩铁划，刚劲非凡。入口排着 两条长凳，几名镖头坐着把守。"
  x = 1
  y = 2
  z = 0
    }

  room_exits "biaoju" {
    room_id = rooms.biaoju.id
    southeast = rooms.eastroad1.id
    }


  room_characters "biaoju" {
    room_id = rooms.biaoju.id
    characters = [
      { id = characters.biaotou.id },
      { id = characters.biaotou.id }    ]
  }

# Generated from C:/files/git/mud/d/xiangyang/bingying1.c by LPCConverter
# Zone: xiangyang

    rooms "bingying1" {
      name = "兵营"
      description = "这里是兵营，密密麻麻到处都是官兵，有的在武将的指挥 下列队操练，有的独自在练功，有的坐着、躺着正在休息。南 墙下坐着主帅，不动声色地寻视着四周。看到你进来，他们全 都向你瞪大眼睛盯着你。"
  x = -1
  y = 4
  z = 0
    }

  room_exits "bingying1" {
    room_id = rooms.bingying1.id
    east = rooms.northjie.id
    }


  room_characters "bingying1" {
    room_id = rooms.bingying1.id
    characters = [
      { id = characters.pian.id },
      { id = characters.zuo.id },
      { id = characters.bing.id },
      { id = characters.bing.id }    ]
  }

