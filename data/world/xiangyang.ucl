# Zone: xiangyang

    rooms "dingzi" {
      name = "丁字街口"
      description = "这里是襄阳城北部的丁字街口。向北一直通向玄武门，东 面和西面是一条笔直的青石大街，通向城内。南面是一堵上盖 红色琉璃瓦的高墙，里面是襄阳安抚使吕文德的府邸。"
  x = 0
  y = 3
  z = 0
    }

