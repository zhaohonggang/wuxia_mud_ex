# Generated from C:/files/git/mud/d/xiangyang/chaguan.c by LPCConverter
# Zone: xiangyang

    rooms "chaguan" {
      name = "茶馆"
      description = "你一走进来，就闻到一股茶香沁入心脾，精神为之一爽。 几张八仙桌一字排开，坐满了客人，或高声谈论战局，或交头 接耳元兵势大。你要想打听什么，恐怕不是时候。"
  x = 1
  y = 4
  z = 0
    }

  room_exits "chaguan" {
    room_id = rooms.chaguan.id
    west = rooms.northjie.id
    }

# Generated from C:/files/git/mud/d/xiangyang/dajiaochang.c by LPCConverter
# Zone: xiangyang

    rooms "dajiaochang" {
      name = "大校场"
      description = "这是襄阳守军用来校阅军士的地方。只见校场正中巍巍搭 着一座高台，台南排列着千余张椅子板凳。台前竖着两根旗杆， 旗杆顶上有着硕大的旗斗。校场里聚集着数百个四袋以上的丐 帮弟子。他们都是来竞选新任丐帮帮主的。"
  x = -3
  y = -1
  z = 0
    }

  room_exits "dajiaochang" {
    room_id = rooms.dajiaochang.id
    north = rooms.westjie3.id
    }

# Generated from C:/files/git/mud/d/xiangyang/dangpu.c by LPCConverter
# Zone: xiangyang

    rooms "dangpu" {
      name = "当铺"
      description = "这是家远近闻名的当铺，三开间的门面，一块写着『邱航 当铺』四个金字的黑匾，足足七尺高的紫檀木的柜台被磨得光 可照人，你一进去就有一种压抑和悲怅的感觉，柜台后的老板 邱航头也不抬的只顾拨拉着算盘，柜台上方挂着一块花木牌子 (paizi) 。据街坊们说铁面当铺给的价还不算最坏，并且从不 问货的来处，除了活人什么都收，所以生意很不错。"
  x = -1
  y = -1
  z = 0
item_desc = {
 paizi = "你情我愿，概不赊欠。"
}
    }

  room_exits "dangpu" {
    room_id = rooms.dangpu.id
    north = rooms.westjie1.id
    }


