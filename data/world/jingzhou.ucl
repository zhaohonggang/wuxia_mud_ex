# Generated from C:/files/git/mud/d/jingzhou/afang.c by LPCConverter
# Zone: jingzhou

    characters "afang" {
      name = "阿芳"
      aliases = ["afang", "fang"]
      description = "阿芳貌似鲜花，可不知道的原因，迟迟不嫁，惹得爷儿们心痒痒。"
  title = "茶僚老板"
  nickname = "消息灵通"
  gender = "女性"
  age = 20
  shen_type = 1
  brain = brains.dealer

  combat = {
    attitude = "friendly"
    combat_exp = 500
    str = 30
  }

  goods = [
    { id = items.peanut.id },
    { id = items.tofu.id }
  ]

  inquiries = [
    { key = "生意" value = "这个么……。还将就。" },
    { key = "结婚" value = "结婚？你有几万两黄金？？筹够了来找我吧。嘻嘻！" }
  ]

  carry = [
    { id = items.cloth.id }
  ]


  init = {
    greet_delay = 1
    add_actions = ["list", "buy"]
  }

  greetings = [
    { line = "阿芳笑眯眯地说道：这位{respect}，快请进来喝杯热茶。" },
    { line = "阿芳说道：哟！这位{respect}您来了啊！" }
  ]
    }

