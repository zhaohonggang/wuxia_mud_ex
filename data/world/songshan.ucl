# Zone: songshan

    rooms "junjigate" {
      name = "峻极禅院山门"
      description = "嵩山绝顶，古称 '峻极' 。这里是本是佛教大寺，但百年 来却已成为嵩山派掌门人的住所。西上可以到达封禅台。"
  x = 1
  y = 6
  z = 6
    }

