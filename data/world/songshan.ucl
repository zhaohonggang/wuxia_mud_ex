# Zone: songshan

    rooms "kefang" {
      name = "嵩山派客房"
      description = "这是一间很大的客房，是嵩山派供前来祭神的游客暂住的 房间陈设十分简陋。 靠墙放了十几张小木床。 虽然简陋了点 但是总比在荒山中露宿强得多了。"
  x = 3
  y = 7
  z = 7
    }

  room_exits "kefang" {
    room_id = rooms.kefang.id
    west = rooms.changlang.id
    }

# Generated from C:/files/git/mud/d/songshan/luyanpubu.c by LPCConverter
# Zone: songshan

    rooms "luyanpubu" {
      name = "芦岩瀑布"
      description = "忽听水声如雷，峭壁上两条玉龙直挂下来，双瀑并泄，屈 曲回旋，飞跃奔逸，水花映日，淡淡冕生。瀑布一侧有一小小 芦岩寺，瀑布斜过就是胜观峰。瀑布之侧有路可上。"
  x = 1
  y = 2
  z = 1
valid_leave = [
{
  direction = "up"
  message = "你使劲儿一蹦，离瀑布顶还有数丈远就掉了下来，摔的鼻青脸肿。"
}
,
{
  direction = "up"
  message = "你奋力一跃，却离瀑布顶还有一丈多远，看来是白费力气。"
}
,
{
  direction = "up"
  message = "你纵身而起，离瀑布顶只差一点点了，再加把劲。"
}

]
    }

  room_exits "luyanpubu" {
    room_id = rooms.luyanpubu.id
    up = rooms.tieliang.id
    southwest = rooms.shandao1.id
    }




  room_items "luyanpubu" {
