# Zone: songshan

    rooms "qimushi" {
      name = "启母石"
      description = "这里有一壁三丈巨石当道。相传大禹治水时要打通辕擐山， 大禹化熊扒挖不止。大禹之妻涂山氏送饭时不慎撞破，失惊而 逃，到此化石。其时涂山已有身孕，大禹追及唤子，巨石北裂 一口，夏启呱呱落地。巨石因此唤作启母石。"
  x = -1
  y = 2
  z = 1
    }

