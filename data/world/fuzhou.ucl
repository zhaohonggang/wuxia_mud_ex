    rooms "beidajie" {
      name = "北大街"
      description = "街道两侧，榕木参天。福州盛夏苦热，广植榕树以纳凉 爽，别名“榕城”。南面是一个大路口，北上就是屏山。"
  x = 0
  y = 1
  z = 0
    }

