    rooms "fuzhou_shop" {
      name = "腾龙斋"
      description = "腾龙斋是福州城内有名的店铺，店堂正中挂着的一块匾额上写着「腾蛟起风」四个大字，令人肃然起敬。不过店里的货柜上却空无一物，看样子已经很久没人来打理了。"
  flags = [
    "no_fight"
  ]
  x = 1
  y = 2
  z = 1
    }

  room_exits "fuzhou_shop" {
    room_id = rooms.fuzhou_shop.id
    down = rooms.majiu.id
    }

