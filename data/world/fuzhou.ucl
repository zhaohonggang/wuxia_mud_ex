# Zone: fuzhou

    rooms "biaoju" {
      name = "福威镖局"
      description = "朱漆大门上茶杯大小的铜钉闪闪发光，门顶匾额写着“ 福威镖局”四个金漆大字，下面横书“总号”两个小字。进 门处两排长凳，分坐八名劲装汉子，个个腰板笔挺，显出一 股英悍之气。"
  x = -1
  y = 1
  z = 0
    }

  room_exits "biaoju" {
    room_id = rooms.biaoju.id
    in = rooms.biaojudy.id
