    rooms "yongquan" {
      name = "涌泉寺"
      description = "涌泉寺为闽中第一丛林。构筑宏伟，气势磅礴，工艺精 巧，冠绝一时。寺东胜境灵源深处，悬崖峭壁，峥嵘奇巧， 古树参天，宁静幽雅，其中千载碑林，多朱熹、蔡襄遗墨。 寺北绝顶峰，远望东海烟波，近瞰闽江流带，福州平原一派 田园风光尽收眼底。"
  x = 5
  y = 1
  z = 1
    }

  room_exits "yongquan" {
    room_id = rooms.yongquan.id
    south = rooms.gushan.id
    }


  room_characters "yongquan" {
    room_id = rooms.yongquan.id
    characters = [
      { id = characters.seng.id }    ]
  }

# Generated from C:/files/git/mud/d/fuzhou/yushan.c by LPCConverter
# Zone: fuzhou

    rooms "yushan" {
      name = "福州于山"
      description = "于山因战国时于越族在此居住而得名。相传闽越王无诸 曾于九月九日大宴于此，又称“九日山”，于山之麓的白塔， 又称定光塔，系唐王审知为了向死去的父母报恩而建。登上 白塔榕城历历如画。"
  x = 1
  y = -1
  z = 1
    }

  room_exits "yushan" {
    room_id = rooms.yushan.id
    northdown = rooms.dongdajie.id
    }

