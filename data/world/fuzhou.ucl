    characters "waiter" {
      name = "伙计"
      description = "一个忙前忙后的店伙计。"
  # brain = brains.vendor  <- 转换器 infer_brain 编造，data/brains 无此定义；注释掉前后都是 NullNode（见 docs/lpc-port-gaps.zh-CN.md §一之一）

  carry = [
    { id = clone_lib.items.cloth.id }
  ]

  init = {
    add_actions = ["list", "buy"]
  }
    }

  room_characters "fuzhou_shop" {
    room_id = rooms.fuzhou_shop.id
    characters = [
      { id = characters.waiter.id }    ]
  }

    characters "zaohongma" {
      name = "枣红马"
      # LPC 的 clone/horse/zaohongma.c **没有** set("long")，
      # 而 characters 块的 description 是必填字段，故此处给一句占位。
      description = "一匹枣红马。"
      aliases = ["zaohongma"]
      age = 5

      combat = {
        attitude = "peaceful"
        max_qi = 300
        combat_exp = 50000
      }

      # LPC: clone/horse/zaohongma.c
      #   inherit NPC; set("age",5); set("max_qi",300);
      #   set("attitude","peaceful"); set("combat_exp",50000);
      # 无 set_skill；LPC 也没写 set("gender")，故此处不写。
    }

    characters "huangbiaoma" {
      name = "黄骠马"
      # LPC 的 clone/horse/huangbiaoma.c **没有** set("long")，
      # 而 characters 块的 description 是必填字段，故此处给一句占位。
      description = "一匹黄骠马。"
      aliases = ["huangbiaoma"]
      gender = "雄性"
      age = 2

      combat = {
        attitude = "peaceful"
        max_qi = 300
        combat_exp = 50000
      }

      # LPC: clone/horse/huangbiaoma.c
      #   inherit NPC; set("gender","雄性");
      #   注意：上面的 gender 会被 loader **静默丢弃** —— NonPlayerMeta 结构体
      #   根本没有 :gender 字段（顶层 gender / nickname / class 都一样）。
      #   全库 NPC 都如此，这里保持一致，只作留档。
      #   set("age", random(3));      <- 随机年龄，数据里取上限 2
      #   set("max_qi",300); set("attitude","peaceful"); set("combat_exp",50000);
      # 无 set_skill
    }

    characters "ziliuma" {
      name = "紫骝马"
      # LPC 的 clone/horse/ziliuma.c **没有** set("long")，
      # 而 characters 块的 description 是必填字段，故此处给一句占位。
      description = "一匹紫骝马。"
      aliases = ["ziliuma"]
      gender = "雄性"
      age = 4

      combat = {
        attitude = "peaceful"
        max_qi = 300
        combat_exp = 50000
      }

      # LPC: clone/horse/ziliuma.c
      #   inherit NPC; set("gender","雄性");
      #   注意：上面的 gender 会被 loader **静默丢弃** —— NonPlayerMeta 结构体
      #   根本没有 :gender 字段（顶层 gender / nickname / class 都一样）。
      #   全库 NPC 都如此，这里保持一致，只作留档。
      #   set("age", 2+random(3));    <- 随机年龄，数据里取上限 4
      #   set("max_qi",300); set("attitude","peaceful"); set("combat_exp",50000);
      # 无 set_skill
    }

    characters "wubushe" {
      name = "五步蛇"
      aliases = ["wubushe", "wubu she", "wubu", "she"]
      description = "五步蛇是福建地方毒蛇，相传中毒行路五步即行倒毙。"
      age = 1

      combat = {
        # inherit SNAKE -> mud/inherit/char/snake.c 的 setup() 里是 aggressive
        attitude = "aggressive"
        str = 15
        dex = 40
        max_qi = 700
        combat_exp = 10000
      }

      # LPC: clone/beast/wubushe.c
      #   inherit SNAKE  ->  mud/include/globals.h: #define SNAKE "/inherit/char/snake"
      #                     该基类 setup()：set("race","野兽")、set("attitude","aggressive")、
      #                     set("verbs",({"bite"}))
      #   无 set_skill
      #   set("snake_poison", ...)、set("power", ...) 的蛇毒机制未移植
    }


