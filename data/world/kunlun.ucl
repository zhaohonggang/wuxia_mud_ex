zones "kunlun" {
  name = "kunlun"
}

# Generated from C:/files/git/mud/d/kunlun/bainiushan.c by LPCConverter
# Zone: kunlun

    rooms "bainiushan" {
      name = "白牛山"
      description = "这座山因终年覆盖白雪，且形状远望如一头正在吃草的牛 而得名。这里寒风呼啸，凛冽刺骨，你不禁打了个寒颤。山顶 有一处平地，放有一块青色的巨石(stone)。"
  x = -2
  y = -2
  z = 1
item_desc = {
 stone = "这块巨石很大，可以卧(wo)下一个人。巨石的表面十分平整光 滑，似乎常有人摩挲一般。"
}
    }

  room_exits "bainiushan" {
    room_id = rooms.bainiushan.id
    southwest = rooms.fufengshan.id
    }

# Generated from C:/files/git/mud/d/kunlun/bayankala.c by LPCConverter
# Zone: kunlun

    rooms "bayankala" {
      name = "巴颜喀拉山"
      description = "巴颜喀拉山山势低平，西接昆仑山垭口，又与通天河支流 德曲相隔，沼泽遍布。在山脚下放眼望去，随处可见一处处沼 泽草甸，乃是放牧各类牲畜的好地方。远处散布着一顶顶牧民 的蒙古包。"
  x = 2
  y = 2
  z = -5
    }

  room_exits "bayankala" {
    room_id = rooms.bayankala.id
    west = rooms.kekexili.id
    northdown = rooms.shanlu2.id
    }




  room_items "bayankala" {
    room_id = rooms.bayankala.id
    items = [
      { id = items.da_shitou.id }    ]
  }

# Generated from C:/files/git/mud/d/kunlun/chufang.c by LPCConverter
# Zone: kunlun

    rooms "chufang" {
      name = "厨房"
      description = "这里是昆仑派弟子用餐的地方。由于天长日久，墙壁都被 烟熏黑了。屋里摆着几张桌椅，几位昆仑派的弟子正在这里大 吃大喝，行酒猜拳。"
  x = 1
  y = -5
  z = 1
    }

  room_exits "chufang" {
    room_id = rooms.chufang.id
    northwest = rooms.xiuxishi.id
    west = rooms.liangong.id
    }


  room_characters "chufang" {
    room_id = rooms.chufang.id
    characters = [
      { id = characters.puren.id }    ]
  }



  room_items "chufang" {
    room_id = rooms.chufang.id
    items = [
      { id = items.rice.id },
      { id = items.xiangcha.id },
      { id = items.kaoya.id }    ]
  }

# Generated from C:/files/git/mud/d/kunlun/conglinggu.c by LPCConverter
# Zone: kunlun

    rooms "conglinggu" {
      name = "葱岭谷"
      description = "你的眼前突然为之一亮，只见一条象被一刀劈开的峡谷岩 石间，高山的雪水泻落到千丈以下的山涧里去，溅起的密密的 飞沫激起一种惊心动魄的震憾。就在这深山野谷的溪流边，却 长满了各种各样的花草树木，春天繁花开遍峡谷秋天果实压满 山腰，人迹罕至，正是鸟兽们的乐园。"
  x = 0
  y = -3
  z = 1
    }

  room_exits "conglinggu" {
    room_id = rooms.conglinggu.id
    south = [rooms.shanlin1.id,rooms.shanlin2.id,rooms.shanlin3.id,rooms.shanlin4.id,rooms.shanlin5.id]
    }




  room_items "conglinggu" {
    room_id = rooms.conglinggu.id
    items = [
      { id = items.huangqi.id },
      { id = items.chongcao.id },
      { id = items.qianjinzi.id },
      { id = items.fuzi.id },
      { id = items.renshen.id },
      { id = items.mahuang.id }    ]
  }

# Generated from C:/files/git/mud/d/kunlun/elang01.c by LPCConverter
# Zone: kunlun

    rooms "elang01" {
      name = "长廊"
      description = "这是一条长廊，连接前厅和客房，不断看见各种打扮的江 湖人士走过，看过廊外，是一片青色的树林，幽静雅致，只听 见不断传来的鸟鸣声。"
  x = 1
  y = -2
  z = 0
    }

  room_exits "elang01" {
    room_id = rooms.elang01.id
    east = rooms.keting1.id
    west = rooms.qianting.id
    }

# Generated from C:/files/git/mud/d/kunlun/fufengshan.c by LPCConverter
# Zone: kunlun

    rooms "fufengshan" {
      name = "扶峰山"
      description = "扶峰山的山壁 (cliff)极高且十分陡峭，山腰以上尽没入 茫茫云海，峰顶终年积雪，山腰以下却是郁郁苍苍，林木茂密 花团锦簇，春意烂漫。"
  x = -3
  y = -3
  z = 1
item_desc = {
 cliff = "扶峰山山壁很是陡峭，看样子要攀爬(climb)上去并不容易。"
}
    }

  room_exits "fufengshan" {
    room_id = rooms.fufengshan.id
    northeast = rooms.bainiushan.id
    in = rooms.houyuan.id
    }

