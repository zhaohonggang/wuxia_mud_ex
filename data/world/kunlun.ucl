      description = "这里是座大厅，高檐大瓦，十分的简朴壮阔，厅内摆几张 高背方椅，一张八仙桌，看来是接待客人的地方，西面和东面 也是客厅，供客人歇息，南面一条长廊通向后面。"
  x = 0
  y = -2
