# Generated from C:/files/git/mud/d/kunlun/sanshengao.c by LPCConverter
# Zone: kunlun

    rooms "sanshengao" {
      name = "三圣坳"
      description = "但见遍地绿草如锦，到处果树香花。原来那三圣坳四周都 是插天高山，挡住了寒气。昆仑派历代掌门人曾花了极大力气 整顿这个山坳，派遣弟子东至江南，西至天竺，搬移奇花异树 前来种植。忽听得山坳后隐隐传出一阵琴声。"
  x = 0
  y = -1
  z = 1
    }

  room_exits "sanshengao" {
    room_id = rooms.sanshengao.id
    down = rooms.fufengshan.id
    north = rooms.jingshenfeng.id
    }

# Generated from C:/files/git/mud/d/kunlun/sanshengtang.c by LPCConverter
# Zone: kunlun

    rooms "sanshengtang" {
      name = "三圣堂"
      description = "昆仑山三圣堂乃“昆仑三圣”何足道所建，原为了修身养 性，读书练功。随着昆仑派日益壮大，名声远播，这里便成了 昆仑派聚众议事，接待各路江湖英雄的地方。「昆仑三圣」也 只好另觅安静所在了。"
  x = 0
  y = -6
  z = 1
    }

  room_exits "sanshengtang" {
    room_id = rooms.sanshengtang.id
    northwest = rooms.jiuqulang2.id
    north = rooms.liangong.id
    northdown = rooms.lang2.id
