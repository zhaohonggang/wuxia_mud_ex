# Generated from C:/files/git/mud/d/kunlun/houyuan.c by LPCConverter
# Zone: kunlun

    rooms "houyuan" {
      name = "后院"
      description = "由于这里一向少有人来，渐渐被人忘记，也就很久没有被 打扫过了。落叶满地，踩上去软绵绵的。墙壁已有些残破，檐 下结满了蜘蛛网，角落里的一扇小门因为日晒雨淋，开始朽烂。"
  x = -3
  y = -3
  z = 1
    }

  room_exits "houyuan" {
    room_id = rooms.houyuan.id
    south = rooms.shanlin2.id
    out = rooms.fufengshan.id
    }

# Generated from C:/files/git/mud/d/kunlun/huayuan1.c by LPCConverter
# Zone: kunlun

    rooms "huayuan1" {
      name = "花园"
      description = "这是一条铺的十分平整的石板路，路面被打扫的干干净净 南面过去是个花圆，传来阵阵花香，西面是静修室，东面传来 些读书声，看来那里是书房了。"
  x = 0
  y = -4
  z = 0
    }

  room_exits "huayuan1" {
    room_id = rooms.huayuan1.id
    south = rooms.lang2.id
    north = rooms.shilu1.id
    }

# Generated from C:/files/git/mud/d/kunlun/jingshenfeng.c by LPCConverter
# Zone: kunlun

    rooms "jingshenfeng" {
      name = "Room"
      description = "你折而向北，又过了一岭，只见古柏三把百余章，皆挺直 端秀，凌霄托根树旁，作花柏顶，灿若云荼。走出十余丈，只 听得琴声之中杂有着无数鸟语，细细的听来，琴声竟似和鸟语 互相应答，间间关关，宛转啼鸣。只见三株大松树下一个白衣 男子背向而坐，膝上放这一张焦尾琴，整自弹奏。他身周树木 上停满了鸟雀，黄莺，杜鹃，喜鹊，八哥，还有许多不知其名 的，和琴声或一问一答，或齐声和唱。"
  x = 0
  y = 0
  z = 1
    }

  room_exits "jingshenfeng" {
    room_id = rooms.jingshenfeng.id
    up = rooms.keding1.id
    down = rooms.guangchang.id
    south = rooms.sanshengao.id
    }




  room_items "jingshenfeng" {
    room_id = rooms.jingshenfeng.id
    items = [
      { id = items.hezudao.id }    ]
  }

