# Zone: kunlun

    rooms "klshanlu" {
      name = "昆仑山麓"
      description = "整个昆仑山脉雪山连绵，冰河垂悬。远望昆仑，有如横卧 云彩间的银色玉龙。每年春天以后，冰雪融化，汇成一股股清 澈溪流，流入长江，黄河。"
  x = -1
  y = 3
  z = -5
    }

