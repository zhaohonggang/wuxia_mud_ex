    rooms "pubu" {
      name = "长白瀑布"
      description = "天池水从两百余尺高飞流跌落，轰鸣之声远传数里，水花直落大嶂谷， 与天然屏障玉壁、金壁相映，恰似白练当空，水柱扑向深深的谷底，溅起几 丈高的飞浪，犹如仙女散花，阳光照射下，虹飞氤跃，璀灿壮观之极。古人 诗云：“白河两岸景清幽，碧水悬崖万古留；疑似龙池喷瑞雪，如同天际挂 飞流。不须鞭石渡沧海，直可乘槎问斗牛？欲识林泉真乐趣，明朝结伴再来 游。”"
  x = 0
  y = 2
  z = 0
    }

