    rooms "laolongtou" {
      name = "老龙头"
      description = "老龙头是万里长城最东端。澄海楼巍峨高踞城头，楼上“雄襟万里”的 横匾居高临下，直俯大海。自澄海楼筑有一石城逐级而下伸入大海，站在石 城终端楼平台上四眺，海天一色，无边无际，气象万千。"
  x = -4
