# Zone: guanwai

    rooms "huandi1" {
      name = "荒路"
      description = "这是城东的一条荒路，路旁杂乱的长着齐膝的荒草，远近荒无一人。两 旁干枯的老树上落满了成群的乌鸦，凄凉的鸣叫声在荒野上远远传去，一派 凄凉的景象。"
  x = 2
  y = 0
