zones "guanwai" {
  name = "guanwai"
}

# Generated from C:/files/git/mud/d/guanwai/baihe.c by LPCConverter
# Zone: guanwai

    rooms "baihe" {
      name = "白河"
      description = "这里是长白山下的一个小村，只有四，五间粗陋的小木屋。这里并没有 固定的居民，木屋都是进山采参的参客所盖，为的是在进山前能在这里好好 的休息一下。东面就是巍峨耸立的长白大山。"
  x = -5
  y = 3
  z = -4
    }

  room_exits "baihe" {
    room_id = rooms.baihe.id
    north = rooms.xiaoyuan.id
    east = rooms.milin1.id
    west = rooms.caoguduo.id
    }


  room_characters "baihe" {
    room_id = rooms.baihe.id
    characters = [
      { id = characters.walker.id }    ]
  }

# Generated from C:/files/git/mud/d/guanwai/baiyun.c by LPCConverter
# Zone: guanwai

    rooms "baiyun" {
      name = "白云峰"
      description = "白云峰在天池之西，鹿鸣峰之南，为长白山主峰。山峰圆而高大，临天 池而耸立，巍峨磅礴，如一口宝剑直插云天。天气晴好，天池十六峰毕露， 惟独此峰常有烟云缭绕，终日不散。古人有“看罢归来回首顾，白山依旧白 云封”的赞语。登临此峰，诚有飘飘欲仙之感。"
  x = -1
  y = -1
  z = 0
    }

  room_exits "baiyun" {
    room_id = rooms.baiyun.id
    southwest = rooms.yuzhu.id
    eastdown = rooms.tianchi1.id
    north = rooms.luming.id
    }

# Generated from C:/files/git/mud/d/guanwai/beicheng.c by LPCConverter
# Zone: guanwai

    rooms "beicheng" {
      name = "北城"
      description = "这里是用黄土铺就的街道，街上的行人不多，看起来很冷清。偶尔有几 个身着异域服饰的行人走过，看起来是满族，鲜祖的居民。西面有一条幽深 的小巷，不知通向何处。"
  x = 0
  y = 0
  z = 1
    }

  room_exits "beicheng" {
    room_id = rooms.beicheng.id
    up = rooms.bingmian.id
    down = rooms.longmen.id
    south = rooms.jishi.id
    west = rooms.xiaoxiang.id
    }


  room_characters "beicheng" {
    room_id = rooms.beicheng.id
    characters = [
      { id = characters.xiucai.id },
      { id = characters.walker.id }    ]
  }

# Generated from C:/files/git/mud/d/guanwai/bingmian.c by LPCConverter
# Zone: guanwai

    rooms "bingmian" {
      name = "冰面"
      description = "这里是松花江的江面，现已冻成了几尺厚的坚冰。行人或马匹，车辆均 可横逾江面而绝无危险。冰面上留有厚厚的积雪，与两岸连成一片，只有中 间经常行走之出，露出一条青色的冰路。"
  x = 0
  y = 0
  z = 2
    }

  room_exits "bingmian" {
    room_id = rooms.bingmian.id
    up = rooms.liangong.id
    down = rooms.beicheng.id
    east = rooms.damenkan.id
    west = rooms.chuanchang.id
    }

# Generated from C:/files/git/mud/d/guanwai/caoguduo.c by LPCConverter
# Zone: guanwai

    rooms "caoguduo" {
      name = "谷草垛"
      description = "经过一番艰苦的跋涉，你的眼前出现了一片低矮的丘陵。远远看去象秋 收后堆成的谷草垛，密密麻麻，数不清有多少个。翻过这片丘陵再向东行， 就可进入长白大山了。东面的天边有一缕炊烟，看来似乎有人。"
  x = -6
  y = 3
  z = -4
    }

  room_exits "caoguduo" {
    room_id = rooms.caoguduo.id
    east = rooms.baihe.id
    northwest = rooms.mantianxing.id
    }

# Generated from C:/files/git/mud/d/guanwai/chuanchang.c by LPCConverter
# Zone: guanwai

    rooms "chuanchang" {
      name = "船厂"
      description = "这里是古镇船厂。船厂是位于关外大平原中部的一个古老 的小镇，此镇西、南、北、三面是以高墙垒筑利于坚守。东面 临松花江天成天险，乃兵家必争的要地。松花江 (river)在冬 春时结冰可通行，夏秋化冻你只好找船家帮忙了。"
  x = 4
  y = 1
  z = 1
  # River actions: yell [boat] / cross
  # - yell boat: summons river_boat to arrive_room (3s)
  # - cross: requires dodge>=270 & neili>=300, moves to arrive_room
    }

  room_exits "chuanchang" {
    room_id = rooms.chuanchang.id
    river = rooms.damenkan.id
    south = rooms.xuedi3.id
    }


  room_characters "chuanchang" {
    room_id = rooms.chuanchang.id
    characters = [
      { id = characters.chuanfu.id }    ]
  }

# Generated from C:/files/git/mud/d/guanwai/chufang.c by LPCConverter
# Zone: guanwai

    rooms "chufang" {
      name = "厨房"
      description = "炊烟缭绕，蒸汽腾腾，香味扑鼻而来。靠墙有一个灶台，支着一 口大锅，里面煮着香喷喷的米粥，旁边的一个火上蒸着白面馒头。一 个老仆人聚精会神的整理着厨房里面物什。"
  x = -6
  y = 7
  z = -4
    }

  room_exits "chufang" {
    room_id = rooms.chufang.id
    east = rooms.shizilu.id
    }




  room_items "chufang" {
    room_id = rooms.chufang.id
    items = [
      { id = items.wan.id },
      { id = items.mantou.id }    ]
  }

# Generated from C:/files/git/mud/d/guanwai/damen.c by LPCConverter
# Zone: guanwai

    rooms "damen" {
      name = "达门"
      description = "天池三面壅注不流，惟独北面偏东一线斜垂，白练飞舞，这就是达门。 池水经达门外流，水流清冷，在石壁间冲撞有声。"
  x = 1
  y = 1
  z = 0
    }

  room_exits "damen" {
    room_id = rooms.damen.id
    northwest = rooms.pubu.id
    southwest = rooms.longmen.id
    }

# Generated from C:/files/git/mud/d/guanwai/damenkan.c by LPCConverter
# Zone: guanwai

    rooms "damenkan" {
      name = "大门坎子"
      description = "这里是沿江向东的古道，多为进山采参的参客所走，因此 也称参路。前面一座小山截断去路，为东去采参的第一道屏障 故被称为大门坎子。西面是宽阔的松花江 (river)。松花江在 冬春时结冰可以通行，夏秋化冻你只好找船家帮忙了。"
  x = -9
  y = 5
  z = -4
  # River actions: yell [boat] / cross
  # - yell boat: summons river_boat to arrive_room (3s)
  # - cross: requires dodge>=270 & neili>=300, moves to arrive_room
    }

  room_exits "damenkan" {
    room_id = rooms.damenkan.id
    river = rooms.chuanchang.id
    southeast = rooms.ermenkan.id
    }

# Generated from C:/files/git/mud/d/guanwai/dongcheng.c by LPCConverter
# Zone: guanwai

    rooms "dongcheng" {
      name = "东城"
      description = "这里是用黄土铺就的街道，街上的行人不多，看起来很冷清。偶尔有几 个身着异域服饰的行人走过，看起来是满族，鲜祖的居民。西面传来嘈杂的 叫卖声。南面是一排黄泥垒成的土房，里面有嬉笑的声音。"
  x = 1
  y = -1
  z = 1
    }

  room_exits "dongcheng" {
    room_id = rooms.dongcheng.id
    northeast = rooms.huandi1.id
    east = rooms.xuedi1.id
    south = rooms.tuyaoguan.id
    west = rooms.jishi.id
    }

# Generated from C:/files/git/mud/d/guanwai/ermenkan.c by LPCConverter
# Zone: guanwai

    rooms "ermenkan" {
      name = "二门坎子"
      description = "漫长的参路蜿蜒的消失在原处的天边，路上依稀还留有一些浅浅的足印 ，看来是前面的参客留下的。白茫茫的雪地反射出耀眼的银光，看得人头昏 眼花。偶尔有几只雪兔飞驰而过，转眼就无影无踪了。"
  x = -8
  y = 4
  z = -4
    }

  room_exits "ermenkan" {
    room_id = rooms.ermenkan.id
    northwest = rooms.damenkan.id
    east = rooms.mantianxing.id
    }

# Generated from C:/files/git/mud/d/guanwai/famu.c by LPCConverter
# Zone: guanwai

    rooms "famu" {
      name = "伐木场"
      description = "这里是鹿鸣峰西坡下的一片森林，长着许多百年的参天大 树，笔直挺拔，都是上好的木材，许多人在这里砍伐(famu)木料， 然后运到中原供达官贵人们建筑豪宅。这里地处深山老林，时常 有凶猛的野兽出没。"
  x = -1
  y = 1
  z = -1
    }

  room_exits "famu" {
    room_id = rooms.famu.id
    southup = rooms.luming.id
    }

# Generated from C:/files/git/mud/d/guanwai/heifengkou.c by LPCConverter
# Zone: guanwai

    rooms "heifengkou" {
      name = "黑风口"
      description = "这里是密林中的险恶之境周围是为茂密的松林，不见天光。 林中传来野兽饥饿之极的嘶吼。四处有不知名草菰和野果，可 你一点也不敢尝尝。林木幽暗深邃，似乎暗藏杀机。你到了此 处，心胆俱裂，只想快点离开。"
  x = -2
  y = 2
  z = -1
    }

  room_exits "heifengkou" {
    room_id = rooms.heifengkou.id
    westdown = rooms.milin3.id
    east = rooms.xiaotianchi.id
    }




  room_items "heifengkou" {
    room_id = rooms.heifengkou.id
    items = [
      { id = items.xiong.id }    ]
  }

# Generated from C:/files/git/mud/d/guanwai/houyuan.c by LPCConverter
# Zone: guanwai

    rooms "houyuan" {
      name = "后院"
      description = "这是胡家的后院，虽然不大，但是收拾得颇为整齐利落，看来是 有人常用心打扫的缘故。东面隐隐的传来打斗声，西面静一些。而北 面望过去是一条铺满碎石子的小路，隐隐飘来阵阵饭香。"
  x = -5
  y = 6
  z = -4
    }

  room_exits "houyuan" {
    room_id = rooms.houyuan.id
    west = rooms.jingxiu.id
    north = rooms.shizilu.id
    south = rooms.xiaowu.id
    }

# Generated from C:/files/git/mud/d/guanwai/huagai.c by LPCConverter
# Zone: guanwai

    rooms "huagai" {
      name = "华盖峰"
      description = "长白东侧最高峰，自古以来，华盖峰就是风雨云雾的故道。云雾起处， 恰似掀开锅盖一般，雾气翻滚，池水云天，一脉相连，气壮华夏，故名华盖 峰。"
  x = 1
  y = -1
  z = 0
    }

  room_exits "huagai" {
    room_id = rooms.huagai.id
    westdown = rooms.tianchi1.id
    north = rooms.tianhuo.id
    }

