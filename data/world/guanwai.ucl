      description = "“天池在长白山巅中心点，群峰环抱，离地高约二十里，故名天池。” 天池碧波盈盈，清澈湛蓝。湖周围峭壁百丈，峰影云影倒映其中，湖光山色、 岚影云天十分诱人。湖岸周遭芳草茵茵，百花吐艳。古人诗云：“周迥八十 里，峭壁立池边。水满疑天池，云低别有天。江山宜漫画，鹿逐结前缘。予 卜携书隐，遨游慰晚年。”"
  x = 0
  y = -1
  z = -1
    }

  room_exits "tianchi1" {
    room_id = rooms.tianchi1.id
    eastup = rooms.huagai.id
    westup = rooms.baiyun.id
    northup = rooms.longmen.id
    south = rooms.tianchi2.id
    }

# Generated from C:/files/git/mud/d/guanwai/tianchi2.c by LPCConverter
# Zone: guanwai

    rooms "tianchi2" {
      name = "白头山天池"
      description = "天池十天九雾，云蒸雾绕，变幻无穷。瞬息万变的雾霭风雨，使天池时 而清亮如蓝天明镜，时而缥缈如轻莹薄纱，时而腾跃如大海波涛，景色大观 令人神往。"
  x = 0
  y = -2
  z = -1
    }

  room_exits "tianchi2" {
    room_id = rooms.tianchi2.id
    north = rooms.tianchi1.id
    }

# Generated from C:/files/git/mud/d/guanwai/tianhuo.c by LPCConverter
# Zone: guanwai

    rooms "tianhuo" {
      name = "天豁峰"
      description = "乘槎河东岸，与龙门峰对峙。峰顶如鹰嘴般的峻峭山峰破石而出，伸向 天池，故又名鹰嘴峰。古书载：“峰起双尖，中辟一线，有豁然开朗、令人 不可思议之趣”，相传为大禹治水所劈，石多赤色，犹如二龙蟠踞，妙趣横 生。"
  x = 1
  y = 0
  z = 0
    }

  room_exits "tianhuo" {
