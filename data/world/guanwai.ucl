# Generated from C:/files/git/mud/d/guanwai/kedian.c by LPCConverter
# Zone: guanwai

    rooms "kedian" {
      name = "客店"
      description = "这是城里唯一的一家小客栈，专门接待过往客商，生意非常兴隆。 店小二里里外外忙得团团转。此间虽偏远，却不因势坑宰客人，住店一 宿只要五两银子。"
  x = -1
  y = -1
  z = 1
valid_leave = [
{
   condition = "!me->query_temp('rent_paid') && dir == 'up'"
direction = "up"
  message = "店小二一下挡在楼梯前，白眼一翻：怎麽着，想白住啊！"
}
,
{
   condition = "me->query_temp('rent_paid') && dir == 'west'"
direction = "west"
  message = "店小二跑到门边拦住：客官已经付了银子，怎麽不住店就走了呢！ 旁人还以为小店伺候不周呢！"
}

]
    }

  room_exits "kedian" {
    room_id = rooms.kedian.id
    up = rooms.kedian2.id
    east = rooms.jishi.id
    west = rooms.majiu.id
    }


  room_characters "kedian" {
    room_id = rooms.kedian.id
    characters = [
      { id = characters.xiaoer.id }    ]
  }

