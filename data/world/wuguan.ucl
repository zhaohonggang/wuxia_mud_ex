    characters "guojing" {
      name = "郭靖"
      description = "他就是人称北侠的郭靖，既是蒙古成吉思汗的金刀 驸马，又是江南七怪、全真派马钰道长、「北丐」 洪七公和「老顽童」周伯通等人的徒弟，身兼数门 武功。他身着一件灰色长袍，体态魁梧，敦厚的面 目中透出一股威严令人不由得产生一股钦佩之情。"
  title = "襄阳城大将"
  nickname = "北侠"
  gender = "男性"
  age = 41
  shen_type = 1
  score = 200000
  startroom = "/d/wuguan/guofu_dating"

  combat = {
    attitude = "peaceful"
    combat_exp = 4000000
    con = 40
    dex = 40
    int = 14
    max_jing = 6000
    max_neili = 8000
    max_qi = 8000
    str = 40
  }

  inquiries = [
    { key = "一灯大师" value = "在下对大师好生感激。" },
    { key = "丐帮" value = "丐帮英雄几百年了，守卫襄阳多亏了他们。" },
    { key = "丘处机" value = "邱道长义薄云天，是真豪杰。" },
    { key = "全金发" value = "那是我六师父。" },
    { key = "南希仁" value = "那是我四师父。" },
    { key = "周伯通" value = "你见到我周大哥了？他现在可好？" },
    { key = "工作" value = "…嗯…这个你去找齐儿吧，他会帮你安排的。" },
    { key = "张阿生" value = "那是我五师父。" },
    { key = "拜师" value = "现在蒙古人围攻襄阳，我哪有心情收徒啊！" },
    { key = "朱聪" value = "那是我二师父。" },
    { key = "杨过" value = "过儿确实有出息。" },
    { key = "柯镇恶" value = "那是我大师父。" },
    { key = "欧阳锋" value = "这个老毒物，害死我六位师父，一待襄阳事了，决不与他干休。" },
    { key = "洪七公" value = "师父除了吃，就是喜欢玩。到处玩，还是为了找吃的。" },
    { key = "练功" value = "东西练武场都可以练的，你去那练吧。" },
    { key = "老顽童" value = "周大哥一贯这样，没点正经。" },
    { key = "蓉儿" value = "蓉儿就是蓉儿了。你问这么多干嘛？" },
    { key = "郭破虏" value = "那是我的小儿子。" },
    { key = "郭芙" value = "这个女儿，又笨又不听话。" },
    { key = "郭襄" value = "襄儿生于乱世，这辈子又多艰厄。但愿她能快乐一世。" },
    { key = "韩宝驹" value = "那是我三师父。" },
    { key = "韩小莹" value = "那是我七师父。" },
    { key = "马钰" value = "马道长于我有半师之谊。" },
    { key = "黄药师" value = "那是我泰山大人。他云游四海，神龙见首不见尾的。" },
    { key = "黄蓉" value = "蓉儿是我的爱妻，你问她做甚？" }
  ]

  chat_chance = 1
chats = [
    "郭靖叹了口气道：蒙古兵久攻襄阳不下，一定会再出诡计。"
