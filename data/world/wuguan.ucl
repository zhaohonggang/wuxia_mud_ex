    rooms "guofu_gate" {
      name = "郭府大门"
      description = "建筑古朴的大宅院出现在你的眼前。只见门楼高挑，门前 立了两个石狮，大门上书两个大字                ######################               ##                  ##               ##     郭    府     ##               ##                  ##               ######################  你从大门瞧进去，好象里面人来人往，都很繁忙的样子。这里 站着位青年，神情威严。接待前来保卫襄阳的各方义士。"
  x = 0
  y = -3
  z = 0
valid_leave = [
{
   # 阻挡条件（原样保留）：me->query("mark/guofu_ok") && ! me->query("mark/guofu_out") && present("wu dunru", environment(me)) && dir == "south"
direction = "south"
  message = "武敦儒伸手将你拦住道：现在襄阳城内不太平，你还是多呆一会吧。"
}
,
{
   # 阻挡条件（原样保留）：me->query("mark/guofu_ok") && present("wu dunru", environment(me)) && dir == "north" && objectp(riding = me->query_temp("is_riding"))
direction = "north"
  message = "武敦儒伸手将你拦住道：不能骑马进郭府，你撞到其他人怎么办？"
}
,
{
   # 阻挡条件（原样保留）：me->query("mark/guofu_over") && present("wu dunru", environment(me)) && dir == "north"
direction = "north"
  message = "武敦儒将你拦住，冷笑道：郭府留你不下，你还是走吧。"
}
,
{
   # 阻挡条件（原样保留）：me->query("combat_exp") > 5000 && ! me->query("mark/guofu_ok") && present("wu dunru", environment(me)) && dir == "north"
direction = "north"
  message = "武敦儒抱拳道：现襄阳正值动乱时期，没师父许可，任何人不得入内。"
}
,
{
   # 阻挡条件（原样保留）：! me->query("mark/guofu_ok") && present("wu dunru", environment(me)) && dir == "north"
direction = "north"
  message = "武敦儒伸手将你拦住道：如果你不打算帮忙打杂，就别进来。"
}

]
    }

