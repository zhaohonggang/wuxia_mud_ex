# Generated from C:/files/git/mud/d/chengdu/eastroad3.c by LPCConverter
# Zone: chengdu

    rooms "eastroad3" {
      name = "东大街"
      description = "你走在东大街上，踩着坚实的青石板地面。向北是一条宽 直的大道。北边可以通往东城门，西南边通向南大街，东南方 便是有名的望江楼。东边不远处有一幢破烂的房屋，但是屋子 的门梁 (liang)已经垮塌，把门封了个严实。"
  x = 2
