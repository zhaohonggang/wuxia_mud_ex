zones "chengdu" {
  name = "chengdu"
}

# Generated from C:/files/git/mud/d/chengdu/baidicheng.c by LPCConverter
# Zone: chengdu

    rooms "baidicheng" {
      name = "白帝城"
      description = "朝辞白帝彩云间，千里江陵一日还。两岸猿声啼不住，千 舟已过万重山。这里就是有名的白帝城了，遥看四周，只见青 山绿水，一片大好风景。庙内塑有刘备及孔明等一干名士的雕 像，凭栏怀古，心潮汹涌，令人神怡。"
  x = 19
  y = 0
  z = -4
    }

  room_exits "baidicheng" {
    room_id = rooms.baidicheng.id
    east = rooms.shudao9.id
    west = rooms.shudao10.id
    }


  room_characters "baidicheng" {
    room_id = rooms.baidicheng.id
    characters = [
      { id = characters.shiren.id },
      { id = characters.shusheng1.id },
      { id = characters.shusheng1.id }    ]
  }

# Generated from C:/files/git/mud/d/chengdu/bingqidian.c by LPCConverter
# Zone: chengdu

    rooms "bingqidian" {
      name = "兵器铺"
      description = "这着是一家小小店面的兵器铺，可是所卖的兵器可大不寻 常。种类固然中土难得一见，能用的人更是稀少。掌柜的拿着 眼瞟得你直发毛。你转脸就看到墙上的招牌。"
  x = -2
  y = 3
  z = 0
    }

  room_exits "bingqidian" {
    room_id = rooms.bingqidian.id
    southeast = rooms.northroad1.id
    }


  room_characters "bingqidian" {
    room_id = rooms.bingqidian.id
    characters = [
      { id = characters.tanghuai.id }    ]
  }

# Generated from C:/files/git/mud/d/chengdu/caotang.c by LPCConverter
# Zone: chengdu

    rooms "caotang" {
      name = "杜甫草堂"
      description = "这里是杜甫流寓成都的故居。草堂里流水回萦，小桥勾连 竹树掩映，显得既庄严肃穆，古朴典雅，又不失幽深静谧，秀 丽清朗。"
  x = -5
  y = 2
  z = 0
    }

  room_exits "caotang" {
    room_id = rooms.caotang.id
    south = rooms.path2.id
    }

# Generated from C:/files/git/mud/d/chengdu/chufang.c by LPCConverter
# Zone: chengdu

    rooms "chufang" {
      name = "酒楼厨房"
      description = "这里是酒后后面的厨房，几个大水池前面有不少的伙计在 摘菜和清洗碗碟，还有一些伙计站在油烟直冒的油锅面前努力 的翻炒着各色菜肴，而一个粗手大脚的中年厨娘大声吆喝，指 手画脚的却不干活。"
  x = 4
  y = 2
  z = 0
    }

  room_exits "chufang" {
    room_id = rooms.chufang.id
    west = rooms.jiudian.id
    }


  room_characters "chufang" {
    room_id = rooms.chufang.id
    characters = [
      { id = characters.chuniang.id }    ]
  }

# Generated from C:/files/git/mud/d/chengdu/eastgate.c by LPCConverter
# Zone: chengdu

    rooms "eastgate" {
      name = "东门"
      description = "这是成都东城门，城门正上方刻着“东门”两个楷书大字 城墙上贴着几张官府告示(gaoshi)。一条笔直的青石板大道向 东西两边延伸。东边是郊外，一片平平展展的平原风光，真是 不愧天府之国的美称。西边是城里。"
  x = 3
  y = 0
  z = 0
    }

  room_exits "eastgate" {
    room_id = rooms.eastgate.id
    west = rooms.eastroad2.id
    east = rooms.fuheqiaoe.id
    }


  room_characters "eastgate" {
    room_id = rooms.eastgate.id
    characters = [
      { id = characters.wujiang.id },
      { id = characters.bing.id },
      { id = characters.bing.id }    ]
  }

# Generated from C:/files/git/mud/d/chengdu/eastroad1.c by LPCConverter
# Zone: chengdu

    rooms "eastroad1" {
      name = "东大街"
      description = "你走在东大街坚实的青石板地面上。南边可以通向东城门 路边有一个简陋的茶摊，一块洗得发白了的旧帆布正顶着头顶 火辣辣的阳光，一张长几上放着几只大号粗瓷碗。碗中盛满着 可口的茶水。往西北通往北大街，东北方一座大店面里传出阵 阵划拳的喧闹。"
  x = 2
  y = 1
  z = 0
    }

  room_exits "eastroad1" {
    room_id = rooms.eastroad1.id
    south = rooms.eastroad2.id
    northwest = rooms.northroad3.id
    northeast = rooms.jiudian.id
    }


  room_characters "eastroad1" {
    room_id = rooms.eastroad1.id
    characters = [
      { id = characters.xiaozei.id }    ]
  }

