# Generated from C:/files/git/mud/d/chengdu/fuheqiaoe.c by LPCConverter
# Zone: chengdu

    rooms "fuheqiaoe" {
      name = "府河桥"
      description = "这里是成都东门外府河桥。成都自古就是川中首府，府河 和南河夹城而过，成为天然的护城河。由于四川外有峡江，秦 岭之险，内仗绵渝坚城之固，成都却因之自来无坐守成功之绩。 往往兵到城下，降旗高扯了。"
  x = 4
  y = 0
  z = 0
    }

