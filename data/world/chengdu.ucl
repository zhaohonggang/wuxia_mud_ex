    east = rooms.majiu.id
    up = rooms.kedian2.id
    northwest = rooms.southroad1.id
    }


  room_characters "kedian" {
    room_id = rooms.kedian.id
    characters = [
      { id = characters.xiaoer.id }    ]
  }

