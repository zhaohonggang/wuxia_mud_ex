# Generated from C:/files/git/mud/d/chengdu/liubeidian.c by LPCConverter
# Zone: chengdu

    rooms "liubeidian" {
      name = "刘备殿"
      description = "这里是武侯祠的刘备殿。正中供着汉昭烈帝高可丈许。后 主却没得供奉，所谓 '扶不起来' 的阿斗吧。而哭庙玉碎的北 地王刘谌得能和英父同祀，令人不胜唏嘘。殿下左右是赵云等 的武将廊和蒋琬为首的文臣廊。"
  x = -2
  y = -2
  z = 0
