    room_id = rooms.jiudian.id
    characters = [
      { id = characters.tanghua.id },
      { id = characters.xiaoer2.id }    ]
  }

# Generated from C:/files/git/mud/d/chengdu/kedian.c by LPCConverter
# Zone: chengdu

    rooms "kedian" {
      name = "锦城驿"
      description = "锦城驿是全西南最大的客店，生意非常兴隆。外地游客多 选择这里落脚，你可以在这里打听到各地的风土人情。店小二 里里外外忙得团团转，沉重的川味官话你是实在听不顺耳。这 是成都督府官办的客栈，接待着各地入川的官差浪人。墙上挂 着一个牌子(paizi)。"
  x = 2
  y = -3
  z = 0
item_desc = {
 paizi = "##==============================##         ##                              ##         ##    楼上雅房，每夜十两白银。  ##         ##                              ##         ##==============================##"
}
valid_leave = [
{
   condition = "! me->query_temp('rent_paid') && dir == 'up'"
direction = "up"
  message = "店小二一下挡在楼梯前，白眼一翻：怎麽着，想白住啊？"
}
,
{
   condition = "me->query_temp('rent_paid') && dir == 'west'"
direction = "west"
  message = "店小二跑到门边拦住：客官已经付了银子，怎麽不住店就走了呢！"
}

]
    }

