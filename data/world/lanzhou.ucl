    rooms "nanmen" {
      name = "兰州南门"
      description = "这是兰州城的南城门，由于这里的环境干燥，经过几年的 风沙侵蚀显得有些破败。城门正上方勉勉强强可以认出南门两 个大字，城墙上贴着几张通缉告示(gaoshi)。许多来边疆做苦 力的罪犯常常经过这里逃回中原，官兵们戒备森严，动不动就 截住行人进行盘问。一条笔直的青石大道向南北两边延伸。南 边是郊外，一些西域来的商人都从这里出城。许多本地人也赶 着牲口从这里经过，到城里去卖掉自己种的瓜果，再买回生活 必需品。北边是城里。"
  x = 0
  y = -3
  z = 0
    }

