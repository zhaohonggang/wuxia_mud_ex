    room_id = rooms.dongdajie1.id
    characters = [
      { id = characters.girl1.id }    ]
  }

# Generated from C:/files/git/mud/d/lanzhou/dongmen.c by LPCConverter
# Zone: lanzhou

    rooms "dongmen" {
      name = "兰州东门"
      description = "这是兰州城的东城门，由于这里的环境干燥，经过几年的 风沙侵蚀显得有些破败。城门正上方勉勉强强可以认出东门两 个大字，城墙上贴着几张通缉告示(gaoshi)。许多来边疆做苦 力的罪犯常常经过这里逃回中原，官兵们戒备森严，动不动就 截住行人进行盘问。一条笔直的青石大道向东西两边延伸。东 边是郊外，许多西域来的商人都是从这里出城，向东到达中原。 许多本地人也赶着牲口从这里经过，到城里去卖掉自己种的瓜 果，再买回生活必需品。西边是城里。"
  x = 2
  y = 0
  z = 0
    }

  room_exits "dongmen" {
    room_id = rooms.dongmen.id
    east = changan.rooms.lzroad.id
    west = rooms.dongdajie1.id
