    rooms "jioudian" {
      name = "迎风酒店"
      description = "方圆数百里内提起兰州迎风酒楼可以说是无人不知，无人 不晓。连西域的人对迎风酒楼的花雕酒赞不绝口。你站在酒店 内，百年陈酿独特的香味，向你阵阵飘来。"
  x = -1
