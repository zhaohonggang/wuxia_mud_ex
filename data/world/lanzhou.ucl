    rooms "beidajie1" {
      name = "北大街"
      description = "你走在一条繁忙的街道上，看着操着南腔北调的人们行色 匆匆，许多人都往南边走去，那里有一个热闹的广场。东边是 一个热闹的菜市场，买卖的人熙熙攘攘。"
  x = 0
  y = 1
  z = 0
    }

  room_exits "beidajie1" {
    room_id = rooms.beidajie1.id
    north = rooms.beidajie2.id
    south = rooms.guangchang.id
    east = rooms.caisicang.id
    }


  room_characters "beidajie1" {
    room_id = rooms.beidajie1.id
