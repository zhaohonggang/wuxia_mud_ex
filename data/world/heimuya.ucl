# Generated from C:/files/git/mud/d/heimuya/chengdedian.c by LPCConverter
# Zone: heimuya

    rooms "chengdedian" {
      name = "成德殿"
      description = "这就是日月神教教主平日发号施令的地方，殿中无窗，殿 口点着明晃晃的蜡烛，大殿彼端高设一座，座中坐着一个白发 老者，自是名震江湖的日月神教教主任我行了。高座正上方立 有一块大匾，写着三个金光耀眼的大字：          ##============================##         ##                            ##         ##     成      德      殿     ##         ##                            ##         ##============================##  殿内四周站满了日月神教的弟子和侍从，正在倾听教主宝训。"
  x = 0
  y = 0
  z = 0
valid_leave = [
{
   condition = "(string)me->query('family/family_name') != '日月神教' & objectp(present('ren woxing',environment(me)))"
direction = ~
  message = "任我行喝道：阁下未免太过放肆，在老夫面前也敢这般横行！"
}

]
    }

  room_exits "chengdedian" {
    room_id = rooms.chengdedian.id
