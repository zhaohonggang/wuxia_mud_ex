zones "heimuya" {
  name = "heimuya"
}

# Generated from C:/files/git/mud/d/heimuya/baigate.c by LPCConverter
# Zone: heimuya

    rooms "baigate" {
      name = "白虎堂大门"
      description = "这是日月神教下第二大堂白虎堂的大门，门前摆放着两座 石狮，镇守着朱漆大门。大门两旁站着数名轻装弟子，双手握 着钢刀，警惕地注视着周围的一切。"
  x = 0
  y = 0
  z = 1
valid_leave = [
{
   condition = "objectp(present('riyue dizi',environment(me))) && dir == 'west' && me->query('family/family_name') != '日月神教'"
direction = "west"
  message = "日月弟子将你拦住，说道：这里乃神教重地，他人不得入内。"
}

]
    }

  room_exits "baigate" {
    room_id = rooms.baigate.id
    up = rooms.basket.id
    down = rooms.chengdedian.id
    west = rooms.dating2.id
    east = rooms.baigate1.id
    }


  room_characters "baigate" {
    room_id = rooms.baigate.id
    characters = [
      { id = characters.dizi4.id },
      { id = characters.dizi4.id }    ]
  }

