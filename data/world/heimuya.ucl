# Generated from C:/files/git/mud/d/heimuya/changtan.c by LPCConverter
# Zone: heimuya

    rooms "changtan" {
      name = "长滩"
      description = "这片长滩不时有日月教教众乘船往来，滩头插着一面日月 教的旗帜。对面的江 (river)上划着几艘日月神教的小船，外 来的船只很多，但是并没有船敢在这里停留，要过对岸只有靠 日月教自己的船只了。"
  x = 0
  y = 0
  z = 4
  # River actions: yell [boat] / cross
  # - yell boat: summons river_boat to arrive_room (3s)
  # - cross: requires dodge>=270 & neili>=300, moves to arrive_room
    }

