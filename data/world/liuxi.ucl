  name = "王重九"
  description = "一位鹤发童颜的老者，青布长衫洗得发白，腰间悬着一柄旧剑。他平日在此授徒练武，剑法看似平实，实则已臻化境。"

  combat = {
    no_kill = true
    max_qi = 2600
    max_jing = 1800
    max_neili = 2400
