# 镇广场的阿婆：任务交付 NPC（A11/N6 v0）
characters "apo" {
  name = "阿婆 Apo"
  description = "一位佝偻着背的老婆婆，坐在广场边的石阶上，浑浊的眼睛望着南边山路的方向。"

  turn_in = {
    quest = "song-yupai"
    item = items.yupai.id
    prompt = "阿婆拉着你的手喃喃道：老婆子的孙女上月进山烧香，被那孽畜惊了马，人虽回来了，陪嫁的玉牌却丢在了山里……你若见着，务必替我讨回来。"
    rumor = "听说柳溪镇来了位少年英雄，寻回了王家小姐遗落山中的血玉牌！"
    rewards = {
      exp = 200
      potential = 50
      score = 10
      weiwang = 5
      coins = 100
    }
  }

  combat = {
    no_kill = true
    max_qi = 60
    max_jing = 80
    str = 5
    dex = 5
    con = 8
    int = 20
    combat_exp = 0
    skills = {}
  }
}

characters "wangshifu" {
  name = "王重九"
  description = "一位鹤发童颜的老者，青布长衫洗得发白，腰间悬着一柄旧剑。他平日在此授徒练武，剑法看似平实，实则已臻化境。"

