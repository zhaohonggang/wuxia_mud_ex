  ]

  combat = {
    no_kill = false
    respawn_delay = 15000
    max_qi = 80
    max_jing = 60
    max_neili = 0
    str = 10
    dex = 10
    con = 10
    int = 5
    combat_exp = 200
    skills = {
      unarmed = 60
      dodge = 1
      parry = 1
    }
    apply = {
      damage = 3
    }
  }
}

# 张记铁铺的伙计：商人 + 问询（A10/N2、N4）
characters "xiaoer" {
  name = "店小二 Xiaoer"
  description = "张记铁铺的年轻伙计，围着油布围裙，一边擦着柜台一边招呼客人。"

  goods = [
    { id = items.baozi.id },
    { id = items.peiyuan_dan.id },
    { id = items.changjian.id },
    { id = items.bupao.id },
    { id = items.douli.id },
    { id = items.yaodai.id }
  ]

  inquiries = {
    柳溪 = "柳溪镇不大，东边是铁铺，西边是练武场，南门外山路直通山中。客官若是生面孔，可莫要往山里乱走。"
    黑虎 = "山路那头有只吊睛黑虎，已伤了好几个过路人！官府贴了告示，谁能除了它，赏钱自然少不了。"
    玉牌 = "玉牌？听说山上那畜生叼走了位过路小姐的玉牌，若客官能取回来，阿婆还等着呢。"
  }

  combat = {
    no_kill = true
    max_qi = 120
    max_jing = 100
    str = 12
    dex = 14
    con = 13
    int = 15
    combat_exp = 300
    skills = {
      unarmed = 30
      dodge = 25
    }
  }
}

