characters "heihu" {
  name = "黑虎"
  description = "一只吊睛白额的猛虎，黄毛黑纹，双目如灯，伏在山路旁的草丛中，尾巴不耐烦地拍打着地面。"

  brain = brains.heihu

  # 击杀掉落（A11/N6）：血玉牌（送还阿婆的任务物）
