# 虚空：NPC 死亡后的停尸房，无出口，60 秒后回出生点重生
rooms "nether" {
  name = "虚空 Nether"
  description = "一片混沌虚无的空间，你的尸体静静地躺在这里。"

  x = 9
  y = 9
  z = 9
}

# ---------------------------------------------------------------------------
# 物品
# ---------------------------------------------------------------------------

items "changjian" {
  name = "长剑 Changjian"
  description = "一柄制式长剑，剑身狭长，开锋犀利，是江湖中人最趁手的兵刃。"

  verbs = [
    "get",
    "drop",
    "wield",
    "unwield"
  ]

  meta = {
    damage = 22
    skill_type = "sword"
    value = 300
    flag = 1
    # b6/D3 多键武器加成：轻巧剑身出手更快（白名单键见 Combat.applies_keys）
    weapon_prop = {
      attack = 3
    }
  }
}

items "bupao" {
  name = "布袍 Bupao"
  description = "一件青布长袍，浆洗得干干净净，聊胜于无的护身衣物。"

  verbs = [
    "get",
    "drop",
    "wear",
    "remove"
  ]

  meta = {
    armor = 2
    value = 50
    weight = 1000
    unit = "件"
    material = "cloth"
    # b6/D3：衣袍属 cloth 槽位（LPC armor_type），多键护甲加成
    armor_type = "cloth"
    armor_prop = {
      defense = 4
    }
  }
}

# b6/D3 新增护具：头/腰两槽位，验证多槽位同时穿戴
items "douli" {
  name = "斗笠 Douli"
