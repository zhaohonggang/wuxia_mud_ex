# NPC
# ---------------------------------------------------------------------------

characters "heihu" {
  name = "黑虎"
  description = "一只吊睛白额的猛虎，黄毛黑纹，双目如灯，伏在山路旁的草丛中，尾巴不耐烦地拍打着地面。"

  brain = brains.heihu

  combat = {
    attitude = "aggressive"
    no_kill = false
    max_qi = 900
    max_jing = 500
    max_neili = 300
    str = 30
    dex = 26
    con = 25
    int = 12
    combat_exp = 8000
    skills = {
      unarmed = 80
      dodge = 70
      parry = 50
      force = 40
    }
    apply = {
      attack = 45
      damage = 35
      armor = 20
    }
  }
}

