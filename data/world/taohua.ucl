zones "taohua" {
  name = "taohua"
}

# Generated from C:/files/git/mud/d/taohua/bingqi.c by LPCConverter
# Zone: taohua

    rooms "bingqi" {
      name = "兵器室"
      description = "这是一间存放兵器的屋子。刀、枪、剑、戟等各种兵器都 按类放在各自的兵器架上。整个屋子落满灰尘，显然已经好久 没人来过。"
  x = 1
  y = 1
  z = 0
    }

  room_exits "bingqi" {
    room_id = rooms.bingqi.id
    west = rooms.qianyuan.id
    }




  room_items "bingqi" {
    room_id = rooms.bingqi.id
    items = [
      { id = items.taojian.id }    ]
  }

# Generated from C:/files/git/mud/d/taohua/chufang.c by LPCConverter
# Zone: taohua

    rooms "chufang" {
      name = "厨房"
      description = "这是桃花岛的厨房，中央摆着大圆桌，周围则放着几张竹 椅。窗口还摆着几盆水仙花。你吸了一下鼻子，好香。也不知 是花香还是饭香。平时桃花岛的弟子和仆人都在这里用餐。看 着可口的饭菜，你忍不住也想叫(serve)一份。"
  x = -1
  y = 1
  z = 0
    }

  room_exits "chufang" {
    room_id = rooms.chufang.id
    east = rooms.qianyuan.id
    }


  room_characters "chufang" {
    room_id = rooms.chufang.id
    characters = [
      { id = characters.cheng.id },
      { id = characters.yapu.id }    ]
  }

# Generated from C:/files/git/mud/d/taohua/dahai.c by LPCConverter
# Zone: taohua

    rooms "dahai" {
      name = "大海"
      description = "你正处在茫茫大海之中。你极目远望，只见海天一线，周 围连个黑点都没有。耳边只有海浪的拍打声。"
  x = 0
  y = 0
  z = 1
    }

  room_exits "dahai" {
    room_id = rooms.dahai.id
    up = rooms.lantian.id
    down = rooms.dating.id
    out = rooms.haitan.id
    }

# Generated from C:/files/git/mud/d/taohua/damen.c by LPCConverter
# Zone: taohua

    rooms "damen" {
      name = "桃花山庄正门"
      description = "这里是桃花岛的正门。门前疏落地种了几株桃花树，更显 得此地主人对桃花的偏爱。门口站着两个小童看守大门。看来 由于地处边远人烟罕至，人们对山庄的防卫不是特别谨慎。门 前有一对白雕(diao)，毛羽如雪，甚为可爱。"
  x = 0
  y = 2
  z = 0
item_desc = {
 diao = "这一对白雕正展翅欲飞。如果是桃花岛的弟子，骑上(ride)就 可以飞到中原，非常便利。"
}
    }

  room_exits "damen" {
    room_id = rooms.damen.id
    east = rooms.road1.id
    north = rooms.tingzi.id
    south = rooms.qianyuan.id
    }


  room_characters "damen" {
    room_id = rooms.damen.id
    characters = [
      { id = characters.shitong.id },
      { id = characters.shitong.id }    ]
  }

# Generated from C:/files/git/mud/d/taohua/daojufang.c by LPCConverter
# Zone: taohua

    rooms "daojufang" {
      name = "道具房"
      description = "这是一间道具房。摆着一些桃花弟子们常用的东西。房里 好象黑乎乎的，靠窗处有一张斑驳长桌和一把靠背椅，虽是白 天还点着小油灯。哑仆看到你进来，就使劲瞪着你，虽然口不 能言，可你还是心中惴惴。"
  x = 1
  y = 0
  z = 0
    }

  room_exits "daojufang" {
    room_id = rooms.daojufang.id
    up = rooms.shufang.id
    west = rooms.dating.id
    }


  room_characters "daojufang" {
    room_id = rooms.daojufang.id
    characters = [
      { id = characters.yapu.id },
      { id = characters.yapu.id }    ]
  }



  room_items "daojufang" {
    room_id = rooms.daojufang.id
    items = [
      { id = items.zhuxiao.id }    ]
  }

# Generated from C:/files/git/mud/d/taohua/dating.c by LPCConverter
# Zone: taohua

    rooms "dating" {
      name = "大厅"
      description = "这里是桃花山庄的正厅。整个大厅十分宽阔。厅中更挂满 了各种名家的书法真迹。但最为显眼的却是正中挂的一幅对联：             ##############################            ##                          ##            ##   桃 花 影 落 飞 神 剑   ##            ##                          ##            ##   碧 海 潮 生 按 玉 箫   ##            ##                          ##            ##############################  其字体遒劲挺拔，气势宏伟之极，想必应是出自黄药师的手笔。"
  x = 0
  y = 0
  z = 0
behavior = "guarded_exit"
behavior_config = {
  guard_npc = "huang yaoshi"
  direction = "south"
  permit_module = "Kantele.Npc.Guarder"
  permit_function = "permit_pass"
}
    }

  room_exits "dating" {
    room_id = rooms.dating.id
    up = rooms.dahai.id
    north = rooms.qianyuan.id
    south = rooms.houyuan.id
    east = rooms.daojufang.id
    west = rooms.wofang.id
    }




  room_items "dating" {
    room_id = rooms.dating.id
    items = [
      { id = items.huang.id }    ]
  }

# Generated from C:/files/git/mud/d/taohua/dong.c by LPCConverter
# Zone: taohua

    rooms "dong" {
      name = "山洞"
      description = "你正处在一个小山洞中。这里光线很暗，只能隐隐约约看 出地上有一堆干草。你突然闻到一股难闻的气味，显然是有人 长期住在这里却不打扫的缘故，可是现在没人在这里。"
  x = 3
  y = 1
  z = 0
    }

  room_exits "dong" {
    room_id = rooms.dong.id
    out = rooms.road5.id
    }

# Generated from C:/files/git/mud/d/taohua/haitan.c by LPCConverter
# Zone: taohua

    rooms "haitan" {
      name = "海滩"
      description = "这是桃花岛前的海滩。往北是一望无际的大海；往南则是一片桃花林。 蓝蓝的海蓝蓝的天，金黄色的沙滩，粉红的桃花，这一切都是那么美。海边 泊着一艘大船(chuan)。"
  x = 0
  y = 0
  z = 1
item_desc = {
 chuan = "这是桃花岛对外联系的大船。岛上的客人或弟子只要 上船(enter)就可以回中原。"
}
    }

  room_exits "haitan" {
    room_id = rooms.haitan.id
    south = rooms.tao_in.id
    }

# Generated from C:/files/git/mud/d/taohua/houyuan.c by LPCConverter
# Zone: taohua

    rooms "houyuan" {
      name = "后院"
      description = "这是山庄的后院。院后是桃花岛的唯一一座山峰：弹指峰。 整个桃花山庄倚山而立，险势天成。南边有两个露天小场，桃 花岛的弟子来来往往，非常忙碌，不少人衣衫尽湿，还有些弟 子鼻青脸肿、带伤而行。"
  x = 0
  y = -1
  z = 0
    }

  room_exits "houyuan" {
    room_id = rooms.houyuan.id
    south = rooms.wuchang3.id
    southwest = rooms.wuchang2.id
    southeast = rooms.wuchang1.id
    east = rooms.siguoshi.id
    west = rooms.xiaowu.id
    north = rooms.dating.id
    }




