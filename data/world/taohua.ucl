# Zone: taohua

    rooms "mudao" {
      name = "墓道"
      description = "这是通往墓室的通道。通道十分宽敞，顶部悬挂着一颗大 大的夜明珠，照得整个墓道如同白昼。墓道尽头便是墓室。"
  x = 0
