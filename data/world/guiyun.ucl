    room_id = rooms.dating.id
    characters = [
      { id = characters.kezhene.id },
      { id = characters.zhucong.id },
      { id = characters.hanbaoju.id },
      { id = characters.nanxiren.id },
      { id = characters.zhangasheng.id },
      { id = characters.quanjinfa.id },
      { id = characters.hanxiaoyin.id }    ]
  }

# Generated from C:/files/git/mud/d/guiyun/duchuan.c by LPCConverter
# Zone: guiyun

    rooms "duchuan" {
      name = "渡船"
      description = "离岸渐远，四望空阔，真是莫知天地之在湖海，抑或是湖海之 在天地。老梢公在船尾悠闲地划着水。"
  x = 0
  y = 0
  z = 1
    }
  room_exits "duchuan" {
    room_id = rooms.duchuan.id
    down = rooms.dating.id
    up = rooms.jinship.id
    }

# Generated from C:/files/git/mud/d/guiyun/huating.c by LPCConverter
# Zone: guiyun

    rooms "huating" {
      name = "花厅"
      description = "这是一间四方型的厅亭，没有牌匾，正面两方木柱，柱上挂了 幅缺了半阙的『诗词』(poem)。厅内摆设了几张桌椅。一个丫环正 在抹拭桌面。"
  x = 0
  y = 1
  z = 0
item_desc = {
 poem = "┌--┐             ┌--┐       │兵│             │  │       │火│             │  │       │有│             │  │       │馀│             │  │       │烬│             │  │       │贫│             │  │       │村│             │  │       │才│             │  │       │数│             │  │       │家│             │  │       └--┘             └--┘"
}
valid_leave = [
{
   # 阻挡条件（原样保留）：(!myfam || myfam["family_name"] != "桃花岛") && (dir == "east" || dir == "west") 
direction = "east"
  message = "归云庄不留外客，你不能住在这里！"
}
,
{
   # 阻挡条件（原样保留）：me->query("gender") != "男性" && dir == "east"
direction = "east"
  message = "男女有别，请到对面住！"
}
,
{
   # 阻挡条件（原样保留）：me->query("gender") != "女性" && dir == "west"
direction = "west"
  message = "男女有别，请到对面住！"
}

]
    }

  room_exits "huating" {
    room_id = rooms.huating.id
    west = rooms.nvxiangfang.id
    east = rooms.nanxiangfang.id
