zones "guiyun" {
  name = "guiyun"
}

# Generated from C:/files/git/mud/d/guiyun/chufang.c by LPCConverter
# Zone: guiyun

    rooms "chufang" {
      name = "厨房"
      description = "这里是归云庄厨房，一个乡下妇人正在灶边忙来忙去，看 来她就是这里的厨娘了。你可以找厨娘要(serve)些吃的。"
  x = 0
  y = 3
  z = 0
    }

  room_exits "chufang" {
    room_id = rooms.chufang.id
    south = rooms.huayuan.id
    }

# Generated from C:/files/git/mud/d/guiyun/damen.c by LPCConverter
# Zone: guiyun

    rooms "damen" {
      name = "大门"
      description = "面前是一座庄院，门楼不甚高大，青砖绿瓦，灰色底的匾上写 着『归云庄』三个大黑字。牌匾较为陈旧，边角处的漆皮已剥落， 露出暗黄色的木质。看来挂在那已不下二十个春秋了。"
  x = 0
  y = -1
  z = 0
valid_leave = [
{
   # 阻挡条件（原样保留）：(!myfam || myfam["family_name"] != "桃花岛") && !me->query_temp("marks/guiyun") && dir == "in" && objectp(present("jia ding", environment(me)))
direction = "in"
  message = "家丁做了个揖，说道：尊驾与敝庄素无往来，庄主不见外客，还是请回吧。"
}

]
    }

  room_exits "damen" {
    room_id = rooms.damen.id
    south = rooms.matou.id
    in = rooms.qianyuan.id
    }


  room_characters "damen" {
    room_id = rooms.damen.id
    characters = [
      { id = characters.jiading.id },
      { id = characters.jiading.id }    ]
  }

# Generated from C:/files/git/mud/d/guiyun/dating.c by LPCConverter
# Zone: guiyun

    rooms "dating" {
      name = "大厅"
      description = "这是归云庄的正厅，由于修建年代久远，看起来已颇为陈旧， 但打扫得十分干净，光线也较为充足，完全没有陈年旧宅的阴晦之 气。四壁挂着一些古人书画精品，皆为上乘之作，显得主人眼光不 凡，胸中大有丘壑。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "dating" {
    room_id = rooms.dating.id
    up = rooms.duchuan.id
    north = rooms.huating.id
    south = rooms.qianyuan.id
    east = rooms.shufang.id
    }


