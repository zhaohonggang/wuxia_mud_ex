# Generated from C:/files/git/mud/d/guiyun/qianyuan.c by LPCConverter
# Zone: guiyun

    rooms "qianyuan" {
      name = "前院"
      description = "这里是归云庄的前院，相当宽敞。左右靠墙各建有几间低 矮的平房，像是家人的住处。正前方几棵树木，湖中清风吹来 落叶萧萧而下。右首有一对白雕(diao)，毛羽如雪。原来这里 是桃花岛为方便弟子回岛的。"
  x = 0
  y = -1
  z = 0
item_desc = {
 diao = "这一对白雕正展翅欲飞。如果是桃花岛的弟子，骑上(ride)就 可以飞到桃花岛，非常便利。"
}
    }

