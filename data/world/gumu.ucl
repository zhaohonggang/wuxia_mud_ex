      description = "此段山路是沿着峭壁开凿出来的，特别崎岖难行。有时峭 壁边必须面贴山璧，侧身而过。尤其是当山凤吹来时，更需特 别小心，不然一失足，就要掉进万丈深渊了。往东南是一块广 大的空地。往北下通往后山脚，远远可以望见一个较大的湖。"
  x = -2
  y = 1
  z = 1
