zones "gumu" {
  name = "gumu"
}

# Generated from C:/files/git/mud/d/gumu/baimatan.c by LPCConverter
# Zone: gumu

    rooms "baimatan" {
      name = "白马潭"
      description = "这个潭为於终南山主峰一带，一条名叫库峪河的上游。潭 边有一块比三间房子还要大的白石头，此石中间低两头高，石 头的前半截伸在水里，後半截留在岸上。由伸在水中的那半截 石头下面还不时冒出一串串白沫，老远看去活似一匹腾空欲飞 的烈马，因此当地人都叫此潭为白马潭。往北是一条崎岖的山 路。"
  x = -2
  y = -1
  z = 1
    }

  room_exits "baimatan" {
    room_id = rooms.baimatan.id
    northup = rooms.shanlu6.id
    }

# Generated from C:/files/git/mud/d/gumu/baoziyan.c by LPCConverter
# Zone: gumu

    rooms "baoziyan" {
      name = "抱子岩"
      description = "一路过来，山路是越来越险。只见光秃秃的山路，左旁尽 是怪石，而右则是万丈深渊，渺不见底。前方不远处的一块巨 石，便是有名的抱子岩。再看几眼，觉那岩生得甚是奇怪，就 如一个妇人抱着个孩子般，细心呵护。往南和西各是一片密林。"
  x = 2
  y = -5
  z = -3
    }

  room_exits "baoziyan" {
    room_id = rooms.baoziyan.id
    south = rooms.shulin9.id
    west = rooms.shulin8.id
    }




  room_items "baoziyan" {
    room_id = rooms.baoziyan.id
    items = [
      { id = items.chen.id }    ]
  }

# Generated from C:/files/git/mud/d/gumu/caodi.c by LPCConverter
# Zone: gumu

    rooms "caodi" {
      name = "草地"
      description = "这里是一片草地，草很深，几乎淹没了小腿。草间散布着 一些奇花，微风吹过，芬芳扑鼻。你听到时而有“嗡嗡嗡”的 声音，看见有一些个头奇大的白色的蜜蜂在草地上飞舞盘旋。"
  x = -5
  y = -6
  z = 6
    }

  room_exits "caodi" {
    room_id = rooms.caodi.id
    north = rooms.shulin3.id
    east = rooms.caodi2.id
    south = rooms.mumen.id
    }

# Generated from C:/files/git/mud/d/gumu/caodi2.c by LPCConverter
# Zone: gumu

    rooms "caodi2" {
      name = "草地"
      description = "这里是一片草地，草很深，几乎淹没了小腿。草间散布着 一些奇花，微风吹过，芬芳扑鼻。你听到时而有“嗡嗡嗡”的 声音，看见有一些个头奇大的白色的蜜蜂在草地上飞舞盘旋。"
  x = -4
  y = -6
  z = 6
    }

  room_exits "caodi2" {
    room_id = rooms.caodi2.id
    southeast = rooms.hanshuitan.id
    west = rooms.caodi.id
    }

# Generated from C:/files/git/mud/d/gumu/caotangsi.c by LPCConverter
# Zone: gumu

    rooms "caotangsi" {
      name = "草堂寺"
      description = "这是一座位於终南山北麓的小寺。寺院中的一口古井，名 为烟雾井。因为每天清晨都会有一股巨大的烟雾，自井里袅袅 升起，不少游客来此，就是为了一观此奇景。往南上是一条崎 岖的山道。往北是一条阴森森的小径。"
  x = -1
  y = 1
  z = 0
    }

  room_exits "caotangsi" {
    room_id = rooms.caotangsi.id
    southup = rooms.shanlu7.id
    }

# Generated from C:/files/git/mud/d/gumu/chongyanggate.c by LPCConverter
# Zone: gumu

    rooms "chongyanggate" {
      name = "重阳宫大门"
      description = "你已走到了终南山半山腰，前面就是全真教的总部重阳宫 了。殿宇依山而筑，高低错落有致。但见周围古木森森，翠竹 成林，景色清幽。前方黄墙碧瓦，飞檐翘檩，正中一道三丈来 高的朱红杉木包铜大门(door)。上方一块大匾，龙飞凤舞地书 着『重阳宫』三个大字。南下是广场。"
  x = 0
  y = 0
  z = 1
    }

  room_exits "chongyanggate" {
    room_id = rooms.chongyanggate.id
    up = rooms.mishi1.id
    down = rooms.daxiaochang.id
    southdown = rooms.daxiaochang.id
    }

# Generated from C:/files/git/mud/d/gumu/daxiaochang.c by LPCConverter
# Zone: gumu

    rooms "daxiaochang" {
      name = "大校场"
      description = "这是一个位於终南山山腰的圆坪，四周群山环抱。山脚下 有一大池。每年腊月，全真派便於此地举行大校，以考察门下 弟子在这一年间的进境。往南是一条崎岖的山道。往西是一条 通往峰顶的山路。往北行便是重阳宫。只见远处十馀幢道观屋 宇疏疏落落的散处山间。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "daxiaochang" {
    room_id = rooms.daxiaochang.id
    up = rooms.chongyanggate.id
    northup = quanzhen.rooms.shijie1.id
    westup = rooms.shanlu7.id
    southdown = rooms.shanlu8.id
    }




  room_items "daxiaochang" {
    room_id = rooms.daxiaochang.id
    items = [
      { id = items.pi.id }    ]
  }

# Generated from C:/files/git/mud/d/gumu/foyezhang.c by LPCConverter
# Zone: gumu

    rooms "foyezhang" {
      name = "佛爷掌"
      description = "只见此处颇为荒凉，是一处寺院的遗址。四周青松翠柏环 绕，寺院的断垣残璧依稀可见，似乎还是一座不小的寺院。往 北是一片平原。"
  x = -1
  y = -4
  z = -3
    }

  room_exits "foyezhang" {
    room_id = rooms.foyezhang.id
    east = rooms.shenheyuan.id
    }

# Generated from C:/files/git/mud/d/gumu/hanshuitan.c by LPCConverter
# Zone: gumu

    rooms "hanshuitan" {
      name = "寒水潭"
      description = "这里是草地的边缘，青草已经很稀疏了，仍然有些许玉蜂 飞过寻觅食物。不远处是一个清波荡漾的大水潭 (tan)，水很 清，隐约可以见过水底的怪石嶙峋，一二游鱼倏地从水底游过， 又不知道躲到哪块石头后面藏身去了。阳光映照下，水面泛起 了一道七色彩虹，望着这般美景，你俗念尽消。"
  x = -3
  y = -7
  z = 6
item_desc = {
 tan = "一口很深的水摊，不知道可不可以潜(qian)下到这水底世界去？"
}
    }

  room_exits "hanshuitan" {
    room_id = rooms.hanshuitan.id
    up = rooms.taiyi2.id
    northwest = rooms.caodi2.id
    }

# Generated from C:/files/git/mud/d/gumu/heifengdong.c by LPCConverter
# Zone: gumu

    rooms "heifengdong" {
      name = "黑凤洞"
      description = "此处位於终南山脉东部的太阳山上。山峰直上直下，像刀 切般的陡峭，山腰上有一个碾盘子粗的石洞，不时冒出一股黑 气，怪可怕的。往西是一片树林。"
  x = 1
  y = -3
  z = -4
    }

  room_exits "heifengdong" {
    room_id = rooms.heifengdong.id
    westup = rooms.shulin7.id
    }

# Generated from C:/files/git/mud/d/gumu/houting.c by LPCConverter
# Zone: gumu

    rooms "houting" {
      name = "后厅"
      description = "这是古墓的后厅，密封得严严实实，没有一丝的缝隙。在 昏暗的灯光下，你发现墙上悬挂着一幅画 (picture)，似乎是 一幅人物的肖像。在厅的中央，摆放着几具棺材(coffin)，其 中只有一具棺材的棺板没有合上，棺材中好象空空如也。"
  x = -1
  y = -9
  z = -10
item_desc = {
 picture = "画中是一个中年道士的背影，看不出什么相貌，画中人一手指 天，画角题着「活死人像」四个大字。"
 coffin = "用厚厚的石板做成的棺材，棺板合上后，就没有一丝的缝隙了。"
}
    }

  room_exits "houting" {
    room_id = rooms.houting.id
    north = rooms.zhengting.id
    }




  room_items "houting" {
    room_id = rooms.houting.id
    items = [
      { id = items.longnv.id },
      { id = items.yang.id }    ]
  }

# Generated from C:/files/git/mud/d/gumu/huangshalin.c by LPCConverter
# Zone: gumu

    rooms "huangshalin" {
      name = "黄沙岭"
      description = "此处位於终南山西部。只见远处王曲原上，孤立着一座由 荒沙堆积而成的山岭，波纹为奇特。据当地人说，这是在商朝， 一位名叫陆亚仙的人，用法力遣来一股黄沙而成。往东是一片 密林。"
  x = -6
  y = -7
  z = 6
    }

  room_exits "huangshalin" {
    room_id = rooms.huangshalin.id
    east = rooms.mumen.id
    }

# Generated from C:/files/git/mud/d/gumu/jinliange.c by LPCConverter
# Zone: gumu

    rooms "jinliange" {
      name = "金莲阁"
      description = "这金莲阁位於终南山山腰间，形势颇为险要。金莲阁後有 一口碗口粗的涌泉，泉水碧绿透明，香甜诱人，在当地颇为有 名，不少人特别来此，只为了取这ㄦ的水来泡茶。那寺前的一 块石碑(shibei)，刻了一收首王维的诗。往南看去是一条山路。 往西走是一条蜿蜒的山路。"
  x = 4
  y = -8
  z = -7
item_desc = {
 shibei = "欲 分 白 太                 投 野 云 乙                 何 中 回 近  终                 处 峰 望 天  南                 宿 变 合 都  山                 ， ， ， ，                 隔 阴 青 连                 水 晴 霭 山  王                 问 众 入 到  维                 樵 壑 看 海                 夫 殊 无 隅                 。 ； 。 ；"
}
    }

  room_exits "jinliange" {
    room_id = rooms.jinliange.id
    southdown = rooms.shanlu11.id
    westup = rooms.shanlu10.id
    }

# Generated from C:/files/git/mud/d/gumu/juyan.c by LPCConverter
# Zone: gumu

    rooms "juyan" {
      name = "老妪岩"
      description = "一路过来，山路是越来越险。只见一块大岩石挡在路中， 自空凭临，宛似一个老妇弯腰俯视，但形状阴森可怖，令人 望而生畏。不少游客在此驻足观看，往南是一片茂密的松林。 往北上是一条陡峭的山路。"
  x = 0
  y = -2
  z = -2
    }

  room_exits "juyan" {
    room_id = rooms.juyan.id
