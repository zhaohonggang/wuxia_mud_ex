# Generated from C:/files/git/mud/d/gumu/kongdi.c by LPCConverter
# Zone: gumu

    rooms "kongdi" {
      name = "空地"
      description = "这是终南山山腰处的一块空地，地势平坦。北面一条小路 直攀山璧而上，通往是终南山主峰。南边和西边是一大片密林， 只闻阵阵琴声自林中传出。往北是一条山路。往南和西各有一 条小径。"
  x = -3
  y = -2
  z = 5
    }

  room_exits "kongdi" {
    room_id = rooms.kongdi.id
