      description = "这里是古墓中的密室，四周密不透风，你只能借着墙上昏 暗的灯光来勉强分辨方向。墙是用整块的青石砌合起来的，接 合的甚是完美，你难以从中找出一丝缝隙。密室中摆放着一些 简单的家居用具，原来这是古墓派祖师林朝英的居室。"
  x = 1
  y = -11
  z = -11
    }

  room_exits "mishi8" {
    room_id = rooms.mishi8.id
    out = city.rooms.guangchang.id
    west = rooms.mishi7.id
    }




  room_items "mishi8" {
    room_id = rooms.mishi8.id
    items = [
      { id = items.lin.id }    ]
  }

# Generated from C:/files/git/mud/d/gumu/mumen.c by LPCConverter
# Zone: gumu

    rooms "mumen" {
      name = "墓门"
      description = "你走过了草地，眼前突然了一片开阔地，突兀地耸立着一 座大墓，墓上砌的石头已经班驳了，看的出来这是座古墓。墓 前没有立碑，也没有任何的标记，不知道这是前朝哪位王公大 臣的墓穴。墓门口被一块的大石头(shi)封闭得丝毫不透。"
  x = -5
  y = -7
  z = 6
item_desc = {
 shi = "这是块巨石，怕不有万斤上下，好象锩着「降龙石」几个字。"
}
    }

  room_exits "mumen" {
    room_id = rooms.mumen.id
    west = rooms.huangshalin.id
    north = rooms.caodi.id
    }


  room_characters "mumen" {
