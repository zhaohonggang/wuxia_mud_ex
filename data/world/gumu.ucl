    characters = [
      { id = characters.sun.id }    ]
  }

# Generated from C:/files/git/mud/d/gumu/puguangsi.c by LPCConverter
# Zone: gumu

    rooms "puguangsi" {
      name = "普光寺"
      description = "这是一个位於终南山下的小寺庙，庙门横额写着 '普光寺' 三个大字。由於此庙是上终南山的必经之路，大多数的游客都 会在此落脚休息，也因此此处香火也颇为鼎盛。庙前的几株松 树下，立着一块石碑(shibei)，几乎快被周围的长草给遮掩了。 往西走是一条小路."
  x = 5
  y = -11
  z = -10
    }

  room_exits "puguangsi" {
    room_id = rooms.puguangsi.id
    west = rooms.shanlu13.id
    }

# Generated from C:/files/git/mud/d/gumu/qianting.c by LPCConverter
# Zone: gumu

    rooms "qianting" {
      name = "前厅"
      description = "这里是古墓的前厅，黑黝黝的，你几乎什么也看不清。全 靠大厅正中间的梁上悬挂着一颗夜明珠，映射出淡淡黄光。厅 柱都是由硕大的石柱砌成的，上面似乎还写着一些什么字--你 怎么也看不清楚了。"
  x = -1
