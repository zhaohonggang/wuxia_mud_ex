# Zone: hengshan

    rooms "yuyang" {
      name = "玉羊游云"
      description = "东峰峭壁崖顶上，白石累累，散布有致，在云雾拂动下，似有 动感，象正在吃草的羊只。这就是和“金鸡报晓”齐名的恒山胜景 “玉羊游云”。"
  x = 1
  y = 1
  z = 2
    }

