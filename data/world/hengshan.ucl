    rooms "xuankong1" {
      name = "悬空寺北楼"
      description = "这里是悬空寺的北门楼，也是北碑亭。登楼俯视，如临深渊， 谷底仰望，如壁间丹凤。向南有悬空栈桥通往南楼。"
  x = -3
  y = 1
  z = -3
    }

