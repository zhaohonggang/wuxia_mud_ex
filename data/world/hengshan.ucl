    }

# Generated from C:/files/git/mud/d/hengshan/zhandao.c by LPCConverter
# Zone: hengshan

    rooms "zhandao" {
      name = "梯式栈道"
      description = "栈道悬于壁，由无数的掾铺成，每节掾宽尺许，九节并排在一 起，每根掾插入岩壁，上铺木板，长约十丈，下临深渊。人必须踏 上悬空的木板，紧攀铁索，屏息静气，缓步挪动，才能过去。"
  x = -3
  y = -2
  z = -2
    }

