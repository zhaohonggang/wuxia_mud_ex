    rooms "xuangengsong" {
      name = "悬根松"
      description = "就在虎风口这个风口险地，却有一株古松，虽被大风吹得树根 裸露，千百年来仍迎风挺立，这就是恒山著名的 '梵宫悬根' 。"
  x = -2
