    rooms "xuankong2" {
      name = "悬空寺南楼"
      description = "这里是悬空寺的南门楼，也是南碑亭。悬空寺于陡崖上凿石穴 插悬梁为基，楼宇间栈桥相连。全寺面东座西，南北危楼对望，断 崖分断，很是艰险。"
  x = -3
