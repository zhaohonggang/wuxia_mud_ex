    characters = [
      { id = characters.sun.id }    ]
  }

# Generated from C:/files/git/mud/d/xiakedao/haigang.c by LPCConverter
# Zone: xiakedao

    rooms "haigang" {
      name = "渔港"
      description = "这里是个小小渔港。南面海面漂浮着几艘小船，抬眼望，海天相 连，无边无际。海鸥掠过浪尖，悠悠翩然。有几个渔夫懒洋洋的呆在 海边，附近停泊了一些小船(boat)。"
  x = -1
  y = 1
  z = 5
item_desc = {
 boat = "这艘船可到侠客岛。"
}
    }

  room_exits "haigang" {
    room_id = rooms.haigang.id
