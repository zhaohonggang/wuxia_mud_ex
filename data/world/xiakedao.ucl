    rooms "pubu" {
      name = "瀑布"
      description = "你猛听得水声响亮，轰轰隆隆，便如潮水大至一般，抬头一看，只 见一条大瀑布(pubu)，犹如银河倒悬，从高崖上直泻下来下面是万丈 悬崖(xuanya)，云雾弥漫，望不到尽头！"
  x = -1
  y = 4
  z = 0
