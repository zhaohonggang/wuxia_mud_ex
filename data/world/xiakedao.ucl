# Generated from C:/files/git/mud/d/xiakedao/haitan.c by LPCConverter
# Zone: xiakedao

    rooms "haitan" {
      name = "海滩"
      description = "这里就是侠客岛了。北边是一望无际的大海；往南则是一片树林。 岛上的空气似乎非常新鲜，咸湿的海风中带着一股花香，这是好大的 一片沙滩，东首石崖下停着四十多艘大小的船只(boat)。"
  x = -3
  y = 12
  z = -5
item_desc = {
 boat = "这是侠客岛对外联系的大船。岛上的客人只要上船(enter)就可以回中原。"
}
    }

