      { id = characters.dizi1.id }    ]
  }

# Generated from C:/files/git/mud/d/xiakedao/duchuan.c by LPCConverter
# Zone: xiakedao

    rooms "duchuan" {
      name = "小舟"
      description = "这是一只几尺见方的小舟，除了船尾划桨的黄衣侠客岛接送弟子 外，再不能坐第三个人了。海面几乎和船帮平齐。还好没什么风浪， 你正暗自庆幸。"
  x = 0
  y = 0
  z = 3
    }
  room_exits "duchuan" {
    room_id = rooms.duchuan.id
    down = rooms.dahai.id
    up = rooms.gudi.id
    }

# Generated from C:/files/git/mud/d/xiakedao/gudi.c by LPCConverter
# Zone: xiakedao

    rooms "gudi" {
      name = "谷底"
      description = "这就是悬崖谷底了，三面是高耸的山峰，一面是大海，四周没有 出口，谷底的烟雾很大，走着走着，你隐隐约约见到前面盘膝坐着一 位老者(Oldman)。"
  x = 0
  y = 0
  z = 4
item_desc = {
 feng = "看什么呀? 这么高的山你是爬不上去的。"
 shanfeng = "看什么呀? 这么高的山你是爬不上去的。"
 oldman = "你仔细一看，这位老者已经仙去很多年了，留下的只是他的遗骨(gu)，好可怜呀!"
 sea = "看什么呀? 你难道想游泳吗?"
}
    }
  room_exits "gudi" {
    room_id = rooms.gudi.id
    down = rooms.duchuan.id
    up = rooms.haibin.id
    }

# Generated from C:/files/git/mud/d/xiakedao/haibin.c by LPCConverter
# Zone: xiakedao

    rooms "haibin" {
      name = "南海之滨"
      description = "这里就是大陆的南端，向南望去是一望无际的碧海，与辽 阔的蓝天相映，让人顿生渺小之感。湛蓝海水、岸边礁石、浪 拍沙滩卷起层层细沫，阳光绕出白云尽情笼照青草绿树，让人 心生退隐江湖之意，只想在此隐居修行，追求武道至高境界。"
  x = 0
  y = 0
  z = 5
    }

  room_exits "haibin" {
    room_id = rooms.haibin.id
    up = rooms.midao1.id
    down = rooms.gudi.id
    north = rooms.xkroad4.id
    west = rooms.zhuwu.id
    }


  room_characters "haibin" {
