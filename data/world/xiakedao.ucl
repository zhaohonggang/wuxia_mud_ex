      { id = characters.dizi.id },
      { id = characters.dizi.id },
      { id = characters.dizi.id },
      { id = characters.dizi.id }    ]
  }

# Generated from C:/files/git/mud/d/xiakedao/dongmen.c by LPCConverter
# Zone: xiakedao

    rooms "dongmen" {
      name = "洞门"
      description = "你的面前突然一亮，眼前赫然出现一道玉石砌成的洞门，门额上 雕有三个大字迎宾馆，两旁石粱雕龙刻凤，不知凝聚着多少名工巧匠 的心血！更体现出主人的富有和奢侈。"
  x = 0
  y = 2
  z = 0
    }

  room_exits "dongmen" {
    room_id = rooms.dongmen.id
    west = rooms.shidong1.id
    in = rooms.yingbin.id
    }


