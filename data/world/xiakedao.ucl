# Generated from C:/files/git/mud/d/xiakedao/road2.c by LPCConverter
# Zone: xiakedao

    rooms "road2" {
      name = "山路"
      description = "小路曲曲折折地通向山顶，脚步声惊起一群飞鸟，扑簌簌地消失 在空中。空气中却有些腥气，路边草丛间不时传来沙沙的轻响，可能 是毒蛇，还是快点离开的好。"
