# Zone: xiakedao

    rooms "road1" {
      name = "山路"
      description = "走在青石铺成的小路上，脚步十分轻捷。两旁都是密林，枝叶遮 天蔽日，阴沉沉的很不舒服。林中鸟雀叽喳，与呼呼的风声混成一片。"
  x = -1
