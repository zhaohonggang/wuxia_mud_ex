zones "xiakedao" {
  name = "xiakedao"
}

# Generated from C:/files/git/mud/d/xiakedao/chashi.c by LPCConverter
# Zone: xiakedao

    rooms "chashi" {
      name = "茶室"
      description = "这是一个石洞，三枝红烛照耀得全洞明亮。洞内坐满了人，一个 童子忙前忙后，满屋的果香和茶香，沁人心脾。屋里四周得体地摆着 些桌子(table)和椅子(chair)。"
  x = 0
  y = 0
  z = 1
item_desc = {
 table = "一张精致的木制小桌，上面放着一些茶具。"
 chair = "一只青竹打制的靠椅，躺上去摇摇晃晃，好舒服耶！"
}
valid_leave = [
{
  direction = "east"
  message = "童子把嘴一撇：吃饱了喝足了还不够，临走怀里还揣上一些！"
}

]
    }

  room_exits "chashi" {
    room_id = rooms.chashi.id
    up = rooms.dahai.id
    down = rooms.dating.id
    east = rooms.neiting.id
    }


  room_characters "chashi" {
    room_id = rooms.chashi.id
    characters = [
      { id = characters.tongzi.id }    ]
  }



  room_items "chashi" {
    room_id = rooms.chashi.id
    items = [
      { id = items.mitao.id },
      { id = items.xiangcha.id }    ]
  }

# Generated from C:/files/git/mud/d/xiakedao/dahai.c by LPCConverter
# Zone: xiakedao

    rooms "dahai" {
      name = "大海"
      description = "你正处在茫茫大海之中。你极目远望，只见海天一线，周围连个 黑点都没有。耳边只有海浪的拍打声。"
  x = 0
  y = 0
  z = 2
    }
  room_exits "dahai" {
    room_id = rooms.dahai.id
    down = rooms.chashi.id
    up = rooms.duchuan.id
    }

# Generated from C:/files/git/mud/d/xiakedao/dating.c by LPCConverter
# Zone: xiakedao

    rooms "dating" {
      name = "大厅"
      description = "这是『侠客岛』的大厅，四周点满了牛油蜡烛，南面放着一个大 屏风。洞内摆着一百来张桌子，宾客正络绎进来，数百名黄衣汉子穿 索般来去，引导宾客入座。"
  x = 0
  y = 0
  z = 0
item_desc = {
 pingfeng = "这是一个非常漂亮的玉石屏风，不知道推(push)开它后面是什么。"
}
    }

  room_exits "dating" {
    room_id = rooms.dating.id
    up = rooms.chashi.id
    north = rooms.shidong5.id
    east = rooms.shufang.id
    west = rooms.wuqiku.id
    }


