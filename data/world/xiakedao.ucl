# Generated from C:/files/git/mud/d/xiakedao/shibi.c by LPCConverter
# Zone: xiakedao

    rooms "shibi" {
      name = "石壁"
      description = "你的面前是块打磨光滑的大石壁(shibi)。 石壁边上点燃着八根 大火把，照耀明亮。石室中已有十多人，有的注目凝思，有的打坐练 功，有的毕目喃喃自语，更有几人在大声争辩。"
  x = 2
  y = 0
  z = 1
item_desc = {
 shibi = "石壁上有首诗：   	:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::: 	::::::　　　　　　　　　　　　　　　　　　　　　　　　　　:::::: 	::::::　　　　　　　　　　　侠客行　　　　　　　　　　　　:::::: 	::::::　　　　　　　　　　　　　　　　　　　　　　　　　　:::::: 	::::::　赵客缦胡缨，吴钩霜雪明。银鞍照白马，飒沓如流星。　:::::: 	::::::　　　　　　　　　　　　　　　　　　　　　　　　　　:::::: 	::::::　十步杀一人，千里不留行，事了拂衣去，深藏身与名。　:::::: 	::::::　　　　　　　　　　　　　　　　　　　　　　　　　　:::::: 	::::::　闲过信陵饮，脱剑膝前横。将炙啖朱亥，持觞劝侯嬴。　:::::: 	::::::　　　　　　　　　　　　　　　　　　　　　　　　　　:::::: 	::::::　三杯吐然诺，五岳倒为轻。眼花耳热后，意气素霓生。　:::::: 	::::::　　　　　　　　　　　　　　　　　　　　　　　　　　:::::: 	::::::　救赵挥金锤，邯郸先震惊，千秋二壮士，煊赫大梁城。　:::::: 	::::::　　　　　　　　　　　　　　　　　　　　　　　　　　:::::: 	::::::　纵死侠骨香，不惭世上英，谁能书阁下，白首太玄经。　:::::: 	::::::　　　　　　　　　　　　　　　　　　　　　　　　　　:::::: 	::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::"
}
    }

