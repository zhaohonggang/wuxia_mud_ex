    characters "wu" {
      name = "乌老大"
      description = "一位身材魁梧的汉子，满面髯须，神情甚是威 武。他便是回疆碧刀门掌门乌老大，他在天山 缥缈峰灵鹫宫下组织了万仙大会，预谋铲除天 山童姥，后来被虚竹子所降服。"
  title = "回疆碧刀门掌门"
  gender = "男性"
  age = 45
  brain = brains.quester

  combat = {
    attitude = "peaceful"
    combat_exp = 2200000
    con = 30
    dex = 30
    int = 30
    max_jing = 2200
    max_neili = 4800
    max_qi = 4500
    str = 30
  }

  inquiries = [
