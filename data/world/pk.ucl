    { skill = "feiyan-zoubi" level = 180 },
    { skill = "hand" level = 180 },
    { skill = "jiuqu-zhegufa" level = 180 },
    { skill = "parry" level = 180 },
    { skill = "martial-cognize" level = 180 },
    { skill = "literate" level = 120 },
    { type = "force" skill = "yaogu-xinfa" },
    { type = "blade" skill = "biyan-dao" },
