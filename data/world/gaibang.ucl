zones "gaibang" {
  name = "gaibang"
}

# Generated from C:/files/git/mud/d/gaibang/chucang.c by LPCConverter
# Zone: gaibang

    rooms "chucang" {
      name = "储藏室"
      description = "这里是丐帮的储藏室，你可以看见一个个锁着的箱子。周 围还悬挂着一些武器和装备。这时有一位丐帮五袋弟子正闭目 养神，看守着这里。"
  x = 1
  y = 0
  z = 0
    }

  room_exits "chucang" {
    room_id = rooms.chucang.id
    west = rooms.undertre.id
    }


  room_characters "chucang" {
    room_id = rooms.chucang.id
    characters = [
      { id = characters.5dai.id },
      { id = characters.staff.id },
      { id = characters.staff.id },
      { id = characters.staff.id }    ]
  }



  room_items "chucang" {
    room_id = rooms.chucang.id
    items = [
      { id = items.gangdao.id }    ]
  }

# Generated from C:/files/git/mud/d/gaibang/inhole.c by LPCConverter
# Zone: gaibang

    rooms "inhole" {
      name = "树洞内部"
      description = "这是杨州城中央广场的老榕树内部，也是丐帮秘密的地下 通道的总交汇处。树洞里丢满了各种垃圾，弭漫着一股臭哄哄 的味道。树洞壁上钉着一块非常醒目的木牌。"
  x = 0
  y = 0
  z = 1
    }

  room_exits "inhole" {
    room_id = rooms.inhole.id
    down = rooms.undertre.id
    out = city.rooms.guangchang.id
    }


  room_characters "inhole" {
    room_id = rooms.inhole.id
    characters = [
      { id = characters.2dai.id },
      { id = characters.1dai.id }    ]
  }



  room_items "inhole" {
    room_id = rooms.inhole.id
    items = [
      { id = items.li.id }    ]
  }

# Generated from C:/files/git/mud/d/gaibang/midao.c by LPCConverter
# Zone: gaibang

    items "midao" {
      name = "丐帮密道"
      description = "这是丐帮极其秘密的地下通道，乃用丐帮几辈人心血掘成。"
  verbs = [
    "get",
    "drop"
  ]
    }

# Generated from C:/files/git/mud/d/gaibang/mishi.c by LPCConverter
# Zone: gaibang

    rooms "mishi" {
      name = "密室"
      description = "这是一间光线阴暗的密室，从地上厚厚的灰尘看得出来这 里很少有人出入，靠西边的地上放着一副脚镣，连着一条铁链 镶在墙上，不知道是用来锁什麽人，南面的墙(wall)是用红杉 木做的，跟另外三面的灰土墙比起来显得有些不寻常。"
  x = -1
  y = 0
  z = 0
item_desc = {
 wall = "这是一堵斑剥淋漓的墙，墙上密密麻麻写满了小字，似乎均与杖法有关。"
}
    }

  room_exits "mishi" {
    room_id = rooms.mishi.id
    east = rooms.undertre.id
    }

# Generated from C:/files/git/mud/d/gaibang/undertre.c by LPCConverter
# Zone: gaibang

    rooms "undertre" {
      name = "树洞下"
      description = "这是老槐树底部，四周光线昏暗，人影晃晃，似乎有几个 黑暗的洞口在你身边，通向四面八方。一位老乞丐大咧咧地坐 在正中的地上。墙壁上画着幅粗糙的路线(map)草图。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "undertre" {
    room_id = rooms.undertre.id
    east = rooms.chucang.id
    west = rooms.mishi.id
    up = rooms.inhole.id
    }


  room_characters "undertre" {
    room_id = rooms.undertre.id
    characters = [
      { id = characters.5dai.id },
      { id = characters.6dai.id },
      { id = characters.7dai.id }    ]
  }



  room_items "undertre" {
    room_id = rooms.undertre.id
    items = [
      { id = items.liang.id },
      { id = items.jian.id }    ]
  }

