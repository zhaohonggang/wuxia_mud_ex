# Zone: yanziwu

    rooms "dannuo" {
      name = "啖糯厅"
      description = "这是一间雅致的大厅，厅上摆着几张紫檀木大桌。桌上银 制餐具一应俱全，桌边一溜犁花木椅。每日慕容世家很多人都 在此用餐。"
  x = 1
  y = 1
  z = 0
    }

  room_exits "dannuo" {
    room_id = rooms.dannuo.id
    east = rooms.huayuan.id
    west = rooms.yimen.id
    }

# Generated from C:/files/git/mud/d/yanziwu/hu.c by LPCConverter
# Zone: yanziwu

    rooms "hu" {
      name = "百曲湖"
      description = "这是一个支流众多的小河，四面都是菱叶。除了桨声和菱 叶与船身相擦的沙沙轻声，四下一片寂静，湖上清风，夹着淡 淡的花香，你不禁心想:  '就算这样一辈子，也好哇！"
  x = 0
  y = 0
  z = 1
    }
  room_exits "hu" {
    room_id = rooms.hu.id
    down = rooms.canheju.id
    up = rooms.huanshi.id
    }

# Generated from C:/files/git/mud/d/yanziwu/huanshi.c by LPCConverter
# Zone: yanziwu

    rooms "huanshi" {
      name = "还施水阁"
      description = "阁中满是书架(jia)， 架上摆着许多颇古旧的书籍，架上 均贴有标签(sign)。这就是慕容世家历经数代才收集积累而成 的武学宝库。"
  x = 0
  y = 0
  z = 2
item_desc = {
 sign = "缺大理段氏六脉神剑，丐帮降龙十八掌、打狗棍法…"
 jia = "上面放着各种武学书籍，却发现没什么有价值的秘籍。"
}
    }

  room_exits "huanshi" {
    room_id = rooms.huanshi.id
    up = rooms.hupan.id
    down = rooms.hu.id
    out = rooms.lanyue.id
    }




