      { id = items.murongbo.id }    ]
  }

# Generated from C:/files/git/mud/d/yanziwu/changlang.c by LPCConverter
# Zone: yanziwu

    rooms "changlang" {
      name = "长廊"
      description = "只见红栏碧瓦，一派富贵气象，不时有几只燕子灵巧的从 廊见飞过，长廊的尽头有一座大花园。长廊上似乎还有一层， 你忍不住想爬上去看看。"
  x = 2
  y = 2
  z = 0
    }

  room_exits "changlang" {
    room_id = rooms.changlang.id
    south = rooms.huayuan.id
    north = rooms.shijian.id
    west = rooms.lixiang.id
    east = rooms.huizhen.id
    }

