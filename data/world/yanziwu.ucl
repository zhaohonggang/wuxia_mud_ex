# Zone: yanziwu

    rooms "hupan" {
      name = "太湖湖畔"
      description = "太湖处江浙之间。她襟带三江，东南之水尽汇于此，周行 五百里，古称五湖。矗立湖 (river)岸，唯见长天远波，放眼 皆碧，七十二峰苍翠挺立在三万六千顷波涛之中，使人心襟大 开直欲仰天长啸，方能表此喜乐。"
  x = 0
  y = 0
  z = 3
  # River actions: yell [boat] / cross
  # - yell boat: summons river_boat to arrive_room (3s)
  # - cross: requires dodge>=270 & neili>=300, moves to arrive_room
    }

