zones "yanziwu" {
  name = "yanziwu"
}

# Generated from C:/files/git/mud/d/yanziwu/biheqiao.c by LPCConverter
# Zone: yanziwu

    rooms "biheqiao" {
      name = "碧荷桥"
      description = "密密匝匝的荷叶上面，一条曲曲折折的小桥通向水中的一 片小洲，洲上花红柳绿，似乎别有洞天。"
  x = 3
  y = 1
  z = 0
    }

  room_exits "biheqiao" {
    room_id = rooms.biheqiao.id
    east = rooms.tingxiang.id
    west = rooms.huayuan.id
    }

# Generated from C:/files/git/mud/d/yanziwu/bozhou.c by LPCConverter
# Zone: yanziwu

    rooms "bozhou" {
      name = "泊舟坞"
      description = "此处一片芦苇，茭白丛中现出一座船坞，大小船只依次排 开。菱花荷叶丛中条条水道 (river)四通八达，由此可乘船离 开燕子坞。湖面系着尾小舟。北面远远望过去有个梯子。"
  x = -2
  y = 2
  z = 0
  # River actions: yell [boat] / cross
  # - yell boat: summons river_boat to arrive_room (3s)
  # - cross: requires dodge>=270 & neili>=300, moves to arrive_room
    }

  room_exits "bozhou" {
    room_id = rooms.bozhou.id
    river = rooms.hupan.id
    northdown = rooms.muti.id
    east = rooms.pindi.id
    }

# Generated from C:/files/git/mud/d/yanziwu/canheju.c by LPCConverter
# Zone: yanziwu

    rooms "canheju" {
      name = "参合居"
      description = "这是慕容世家首脑人物日常起居之地，布置得华丽中不乏 清雅，平实中透着高贵。楠木方桌，大太师椅，以及墙上的字 画都透着一股非凡之气。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "canheju" {
    room_id = rooms.canheju.id
    up = rooms.hu.id
    west = rooms.qiushuan.id
    east = rooms.zuijing.id
    north = rooms.yimen.id
    south = rooms.shuwu.id
    }




