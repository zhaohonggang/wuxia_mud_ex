# Zone: yanziwu

    rooms "chuantang" {
      name = "穿堂"
      description = "不知是什么能工巧匠设计了这条穿堂，九曲回折，雕梁画 栋。再望南就是后院了，向北则是一座大厅堂。"
  x = 1
