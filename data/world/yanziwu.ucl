# Zone: yanziwu

    rooms "cuixia" {
      name = "翠霞堂"
      description = "古朴庄严，气度非凡，你一进门就不由的惊叹。好大一座 厅堂! 西边仿佛有一间小厅，东边则是一片竹林，南面有一道 穿堂，不知通向什么地方。"
  x = 1
