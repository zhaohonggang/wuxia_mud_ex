# Generated from C:/files/git/mud/d/kaifeng/chufang.c by LPCConverter
# Zone: kaifeng

    rooms "chufang" {
      name = "素斋厅"
      description = "这是寺庙中的大小僧人用餐的地方，当然方丈的素斋是专 门有人送过去的，平时相国寺的僧人听钟吃饭，等他们吃完了 也经常把剩下的素斋舍给穷人吃。逢塑望，十五也经常作些斋 席请大施主，高官富贵们品尝，所以素斋厨的僧人是最忙的。"
  x = -5
  y = -12
  z = 0
    }

  room_exits "chufang" {
    room_id = rooms.chufang.id
    west = rooms.zhongyuan.id
    north = rooms.chufang2.id
    }


