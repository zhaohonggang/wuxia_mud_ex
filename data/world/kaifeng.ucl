    rooms "chufang2" {
      name = "素斋厨"
      description = "素斋厨的几个大灶烧得正旺，白色的蒸汽在室顶铺了一层 灶膛间摆满了松柴，和尚们很挑剔，说是用这种柴禾煮出的饭 菜才去近佛。一边的桌上摆着一个饭桶。东面有个小门出去。"
  x = -5
  y = -11
  z = 0
    }

  room_exits "chufang2" {
