    rooms "cangjing" {
      name = "藏经楼"
      description = "藏经楼是一栋两层小楼，阁楼中都是佛家经典，名贵稀少 的都用檀木盒盛放了。收藏在楼上，派有专人职司。你满眼看 去，到处是高低的书架，"
