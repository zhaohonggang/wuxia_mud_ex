      description = "这片菜园子几畦地里种了一些时鲜蔬菜。另外有几个木桩 搭起的菜架子，供一些爬藤的蔬菜生长，不过你举目看去，老 大的一片菜园子，居然疏疏落落的没有几棵菜。"
  x = -2
  y = -11
  z = 0
