    rooms "daxiong" {
      name = "大雄宝殿"
      description = "经过九级石头台阶，正面就是佛祖神像，两边普贤和文殊。 高大的佛像几乎挨到了屋顶，令人凌然生威。正对着门的地方 摆着几张供桌，上面是时鲜的瓜果。供桌两边的大蜡烛比人还 高。两边是十八罗汉。"
  x = -3
  y = -12
  z = 2
    }

