# Zone: kaifeng

    rooms "caifang" {
      name = "柴房"
      description = "这间小柴房堆满了松柴，多是卖柴的汉子因为卖不出去而 拿来换上一餐的。也有些是穷苦人上山砍了奉献给佛祖的，好 在开封边的野猪林多的是松树，所以倒也从没缺过柴禾。"
  x = -3
  y = -10
  z = 0
    }

