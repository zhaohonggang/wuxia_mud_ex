    rooms "fanta" {
      name = "繁塔"
      description = "繁塔建于繁台之上，这是一座六角九层，八十余米高的巨 型佛塔，极为壮观。有诗曰『台高地迥出半天，了望皇都十里 春』，塔高三十余米，青砖砌成砖雕有精美的佛像，共有一百 零八种，七千余尊。塔内存有一百七十八块佛经碑刻。"
  x = -2
  y = -19
