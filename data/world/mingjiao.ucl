    room_id = rooms.fangtang.id
    characters = [
      { id = characters.jiuping.id }    ]
  }

# Generated from C:/files/git/mud/d/mingjiao/foshe.c by LPCConverter
# Zone: mingjiao

    rooms "foshe" {
      name = "佛家竹舍"
      description = "走进这间竹舍，一阵清香飘来，只见几为青衣僧人端坐 于莆团之上，正低声咏念“金刚经”。室中香烟清绕，竹影 流芳，一白眉老僧端坐正中，手持菩提念珠，念念有词。身 后墙壁之上，高悬一条幅(tiao fu)，纸已发黄,但笔力遒劲， 一见可知是件古物。"
  x = 6
  y = -14
  z = -11
    }

  room_exits "foshe" {
    room_id = rooms.foshe.id
    south = rooms.mjfengmen1.id
    }

