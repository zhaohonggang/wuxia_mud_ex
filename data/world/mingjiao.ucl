# Zone: mingjiao

    rooms "gudi4" {
      name = "昆仑仙境"
      description = "放开脚步向前急奔，直奔了两里有馀，才遇一座高峰阻路。 放眼四望，旦见翠谷四周高山环绕，似乎亘古以来从未有人迹 到过。四面雪峰插云，险峻陡绝计无法攀援而入。"
  x = 0
  y = -1
  z = 5
    }

