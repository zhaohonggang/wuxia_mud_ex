    rooms "hsqdating" {
      name = "洪水旗大厅"
      description = "这里是洪水旗的大厅，厅中四壁漆墨，连桌案台椅俱为黑色， 枪曳黑缨，剑垂玄穗，布置得冷漠森严。厅中央摆有茶几，洪水 旗掌旗使唐洋正襟而坐，面带杀气。"
  x = 1
  y = 3
  z = -6
