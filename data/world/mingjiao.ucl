    rooms "gebitan1" {
      name = "戈壁滩"
      description = "终于穿出了密林，眼前是一望无际的戈壁滩，没有路标，也没 有一个行人，天显得很高，远山披雪，苍鹰翱翔，好一派不同于中 土的异域风光。不远处，几只白骨散落地上，似乎是牦牛的尸骨？ 走在这茫茫戈壁之上，你似乎迷路了。"
  x = 8
  y = -13
  z = -11
    }

