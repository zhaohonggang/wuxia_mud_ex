# Generated from C:/files/git/mud/d/mingjiao/donglu.c by LPCConverter
# Zone: mingjiao

    rooms "donglu" {
      name = "昆仑山麓"
      description = "这里是千里昆仑的东麓，由于树木高大茂盛，遮天盖地，甚 是阴暗。北面隐隐有条小路，但是看来许久未曾有人走过，颇为 荒凉阴森。"
  x = 5
  y = -10
  z = -11
    }

  room_exits "donglu" {
    room_id = rooms.donglu.id
    north = rooms.youjing.id
    south = rooms.shanjiao.id
    }

# Generated from C:/files/git/mud/d/mingjiao/eastdian.c by LPCConverter
# Zone: mingjiao

    rooms "eastdian" {
      name = "明教东侧殿"
      description = "这里是东侧殿，是接待来宾的地方。殿内摆着几张桌子，桌 旁围放数把椅子。墙上悬着几幅字画，墙边一排书架，架上摆满 书籍。窗外是茫茫昆仑雪山，雪峰延绵。"
  x = 1
  y = -1
  z = 0
    }

  room_exits "eastdian" {
    room_id = rooms.eastdian.id
    west = rooms.qiandian.id
    }

# Generated from C:/files/git/mud/d/mingjiao/fangtang.c by LPCConverter
# Zone: mingjiao

    rooms "fangtang" {
      name = "明教饭堂"
      description = "这里便是明教的饭堂。摆满了长长的餐桌和长凳，几位年轻教 众正来回忙碌着布置。桌上摆了几盆豆腐，花生，青菜以及大鱼， 大肉，鸡，酒等美味食。东边的走廊通向广场。"
  x = -1
  y = -2
  z = -1
    }

  room_exits "fangtang" {
    room_id = rooms.fangtang.id
    east = rooms.square.id
    }


