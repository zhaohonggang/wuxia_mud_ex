# Generated from C:/files/git/mud/d/mingjiao/gudi5.c by LPCConverter
# Zone: mingjiao

    rooms "gudi5" {
      name = "昆仑仙境"
      description = "向西走了二里多，只见峭壁上有一道大瀑布冲击而下，料想是 雪融而成，阳光照射下尤如一条大玉龙，极是壮丽。瀑布泄在一座 清澈碧绿的深潭(tan) 之中，潭水却也不见满，当是另有泄水的去 路。"
  x = -1
  y = 0
  z = 5
item_desc = {
 tan = "这是瀑布下的一座清澈碧绿的深潭。你附身潭边，凝神瞧去，只见 碧绿的水中十馀条大白鱼(fish)来回游动。"
 fish = "生活在深潭中的白鱼，全身白鳞，足有一尺多长。鱼在深潭中游来 游去，你见了不竟想去捉(zhuo)一条。"
}
    }

  room_exits "gudi5" {
    room_id = rooms.gudi5.id
    east = rooms.gudi3.id
    }

