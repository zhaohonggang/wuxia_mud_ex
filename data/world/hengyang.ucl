    rooms "hengyang_shop" {
      name = "祝融居"
      description = "这里是衡阳城内的一家店铺，衡阳城虽小，南岳衡山却尤为著名。店铺由衡山五峰之一的祝融峰而得名。从红木雕窗放眼望去，整个衡阳古城熙熙攘攘的街道尽收眼底。"
  flags = [
    "no_fight"
  ]
  x = 2
  y = -22
  z = -3
    }

  room_exits "hengyang_shop" {
    room_id = rooms.hengyang_shop.id
    down = rooms.majiu.id
    }

