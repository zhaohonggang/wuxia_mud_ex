    rooms "chaguan" {
      name = "衡阳茶馆"
      description = "你一进来，就闻到一股茶香沁入心脾，精神为之一爽。几 张八仙桌一字排开，四周坐满了客人，或高声谈笑，或交头接 耳。你要想打听江湖掌故和谣言，这里是个好所在。"
  x = 4
  y = -22
  z = -4
