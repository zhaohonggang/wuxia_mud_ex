    rooms "cangjingdian" {
      name = "藏经殿"
      description = "藏经殿深掩祥光峰下，因为藏明太祖所赠「大藏经」故名。 只见这里古木参天，殿宇飘翼，奇花异草，林壑幽深，景色秀 丽，「藏经殿之秀」是衡山大四绝之一。"
  x = -3
  y = -2
  z = -2
