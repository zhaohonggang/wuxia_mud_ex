    rooms "shuiliandong" {
      name = "水帘洞外"
      description = "水帘洞在紫盖峰下，紫盖峰之水经过山涧汇入紫盖仙洞之 中，深不可测，水满则溢，飞瀑(pubu)高二十余丈，数叠垂帘， 飘泄而下，蔚为壮观。明张居正诗曰「误疑瀛海翻琼波，莫拟 银河倒碧流，自是湘妃深隐处，水晶帘挂五云头。」以赞叹这 衡山大四绝之一的 水帘洞之奇 。"
  x = 6
  y = -9
  z = -2
item_desc = {
 pubu = "只见瀑布飞泻而下，气势磅礴，景致壮观，下面却是万丈深渊， 一望无底，水莲洞却偏偏生瀑布之后。"
}
