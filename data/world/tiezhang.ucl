# Generated from C:/files/git/mud/d/tiezhang/wmfeng.c by LPCConverter
# Zone: tiezhang

    rooms "wmfeng" {
      name = "无名峰"
      description = "跨过路上的荆棘和荒草，你终于登上了五指山无名峰的峰顶。由于这里 地处五峰之中，四周有其它山峰阻挡，因此风势很小，常年笼罩在一片云雾 之中。峰顶长满了齐腰的荒草，怪石嶙峋，一片荒凉景色。在山峰顶部的正 中赫然矗立着一座岩石砌就的坟墓，坟墓的前面立着一块一人多高的花岗岩 的墓碑(bei)。"
  x = -2
  y = 11
  z = 6
    }

  room_exits "wmfeng" {
