zones "tiezhang" {
  name = "tiezhang"
}

# Generated from C:/files/git/mud/d/tiezhang/bqshi.c by LPCConverter
# Zone: tiezhang

    rooms "bqshi" {
      name = "兵器室"
      description = "铁掌帮虽是以掌法、轻功著称，但帮中仍存有大量的兵器。以供武功不 够的帮众使用。屋内两侧排列的都是兵器架，上面刀、枪、剑、戟、斧、钺 钩、叉应有尽有。"
  x = 1
  y = 2
  z = 1
    }

  room_exits "bqshi" {
    room_id = rooms.bqshi.id
    south = rooms.zoulang_1.id
    }




  room_items "bqshi" {
    room_id = rooms.bqshi.id
    items = [
      { id = items.gangdao.id },
      { id = items.gangjian.id },
      { id = items.gangzhang.id },
      { id = items.changbian.id }    ]
  }

# Generated from C:/files/git/mud/d/tiezhang/chufang.c by LPCConverter
# Zone: tiezhang

    rooms "chufang" {
      name = "厨房"
      description = "这里是铁掌帮内的厨房。你的正面是一个大炉灶，几乎占去了一大半的 房间。灶上留有很多火眼，可同时做很多种菜。几位帮中的厨子正在来回忙 碌着。整间屋内弥漫着各种饭菜的香味，闻了让人垂涎欲滴。"
  x = -2
  y = 2
  z = 1
    }

  room_exits "chufang" {
    room_id = rooms.chufang.id
    south = rooms.zoulang_3.id
    }




  room_items "chufang" {
    room_id = rooms.chufang.id
    items = [
      { id = items.hsnr.id },
      { id = items.ruzhu.id },
      { id = items.fan.id }    ]
  }

# Generated from C:/files/git/mud/d/tiezhang/dezj.c by LPCConverter
# Zone: tiezhang

    rooms "dezj" {
      name = "第二指节"
      description = "这里已到了中指峰的半山腰了，由于铁掌山排列得象手指一样，每座山 峰又再分为三截，就如手指的指节一般，因此这里又正是位于第二指节的位 置。这里离峰顶已近，透过淡淡的云雾，似已可以看到山路的尽头了。左前 方二十于丈处，黑黝黝的似有一个洞穴(dong)，洞口砌以玉石，修建得极是 齐整。"
  x = 0
  y = 12
  z = 5
item_desc = {
 dong = "一个黑黝黝的山洞。黑暗中偶尔有几点磷光闪过。"
}
valid_leave = [
{
   # 阻挡条件（原样保留）：dir == "in" && objectp(present("mayi zhanglao", environment(me)))
direction = "in"
  message = "麻衣长老喝道：此乃铁掌帮禁地，任何人不得入内，否则有死无生！"
}

]
    }

  room_exits "dezj" {
    room_id = rooms.dezj.id
    in = rooms.dong_1.id
    northup = rooms.shanlu_8.id
    south = rooms.sslin_5.id
    }


  room_characters "dezj" {
    room_id = rooms.dezj.id
    characters = [
      { id = characters.mayi.id },
      { id = characters.mayi.id }    ]
  }

# Generated from C:/files/git/mud/d/tiezhang/dong-1.c by LPCConverter
# Zone: tiezhang

    rooms "dong_1" {
      name = "山洞"
      description = "一个黑漆漆的山洞，一眼竟望不到底。两侧的石壁上生满的苔藓，摸起 来又湿又滑。这石洞似乎是人工开凿的，从四周的石壁上仍能看出斧凿的痕 迹。你站在这里，一股恐惧由然而生，似乎身体随时都会被这片黑暗吞噬掉。"
  x = 0
  y = 12
  z = 5
    }

  room_exits "dong_1" {
    room_id = rooms.dong_1.id
    out = rooms.dezj.id
    }

# Generated from C:/files/git/mud/d/tiezhang/guajia.c by LPCConverter
# Zone: tiezhang

    rooms "guajia" {
      name = "瓜架"
      description = "转过一个小弯，忽然眼前一绿，面前是一片很大的瓜架。在高大的木架 旁，种植着一些蔬菜和瓜类，架子上已经爬满了各种各样的植物，从茂密的 叶子中，垂下各种已经成熟的果实，丝瓜，苦瓜，葫芦……还有一些叫不出 名称的瓜果也缠杂在其中。"
  x = 1
  y = 0
  z = 0
    }

  room_exits "guajia" {
    room_id = rooms.guajia.id
    west = rooms.guangchang.id
    southeast = rooms.shuijing.id
    }




