# Generated from C:/files/git/mud/d/tiezhang/guangchang.c by LPCConverter
# Zone: tiezhang

    rooms "guangchang" {
      name = "广场"
      description = "山路行到这里，忽然变得开阔，你眼前出现了一片很大的广场。一些铁 掌帮的弟子来回穿梭于其间，显得很忙碌。在广场的周围有很多岩石建的房 子。正面的这间尤其显得高大雄伟。左面的房子中不时的涌出阵阵热气，其 间还加杂着鼓风的声音。"
  x = 0
  y = 0
  z = 0
valid_leave = [
{
   # 阻挡条件（原样保留）： (string)me->query("family/family_name") != "铁掌帮" & objectp(present("feng yong", environment(me))) & ! me->query("move_party/绝情谷--铁掌帮", 1) 
direction = ~
  message = "冯勇身形一晃，忽然挡住你，厉声说道：这位不是本帮弟子，休得在本帮乱闯。"
}

]
    }

