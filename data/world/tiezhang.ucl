# Generated from C:/files/git/mud/d/tiezhang/npc/gu.c by LPCConverter
# Zone: tiezhang

    characters "gu" {
      name = "顾炎武"
      description = "顾先生名炎武，字亭林，江苏昆山人士。 顾先生是当世大儒，明亡之后，心伤国变，隐居不仕。 他又高又瘦，面目黝黑。"
  gender = "男性"
  age = 55
  shen_type = 1

  combat = {
    combat_exp = 500
  }

  inquiries = [
    { key = "上官剑南" value = "(: ask_jiannan :)" },
    { key = "二瞻" value = "他乃是当今一位大画家。" },
    { key = "伊璜" value = "查伊璜, 也就是查继佐, 因大力将军所助, 免罪不究。" },
    { key = "反清复明" value = "你也要学一学当年岳武穆尽忠报国, 刺字以决你心?" },
    { key = "口号" value = "天地父母，反清复明。" },
    { key = "吴六奇" value = "吴六奇将军身在曹营心在汉, 实际上是天地会洪顺堂香主。" },
    { key = "大力" value = "大力将军乃广东提督吴六奇将军。" },
    { key = "天地会" value = "天地会是台湾国姓爷延平郡王郑成功手下谋主陈永华所创。" },
    { key = "岳武穆" value = "(: ask_wumu :)" },
    { key = "查士标" value = "二瞻先生有位本家伊璜先生牵连在这场‘明史’大案中。" },
    { key = "武穆遗书" value = "(: ask_yishu :)" },
    { key = "画" value = "这是二瞻先生的丹青。" },
    { key = "陈永华" value = "陈先生暗中联络老兄弟，胸口所刺八字便是会里的口号。" }
  ]

  chat_chance = 3
chats = [
    "顾炎武高声呤道：清风虽细难吹我，明月何尝不照人？ 真是绝唱！",
    "顾炎武道：如此江山，沦于夷狄。我辈忍气吞声。偷生其间，实令人悲愤填膺。",
    "顾炎武道：终有一日驱除胡虏，还我大汉河山，比之徒抒悲愤，更加令人气壮。",
    "顾炎武道：当今之世，便真有桃源乐土，咱们也不能独善其身，去躲了起来。"
]


  skills = [
    { skill = "literate" level = 200 }
  ]

    }

