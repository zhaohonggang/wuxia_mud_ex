    rooms "armor" {
      name = "盔甲店"
      description = "这家盔甲店和街对面的武器店都是同一个老板开的，之所以把它们分 开，只是为了方便顾客购买自己需要的东西，店内四壁上挂满了各式个样 的盔甲，金制的，银制的，铜制的，铁制的，皮制的，品种齐全，应有尽 有。"
  x = 1
  y = 1
  z = 0
    }

