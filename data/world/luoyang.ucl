    rooms "chalou" {
      name = "壶记茶楼"
      description = "你一走进来，就闻到一股茶香沁入心脾，精神为之一爽。几张八仙桌 一字排开，坐满了客人，或高声谈笑，或交头接耳。你要想打听江湖掌故 和谣言，这里是个好所在。后面是休息室，到楼上可以听人说书。"
  x = -1
  y = -2
  z = 0
