      description = "不知为什么洛阳虽大，却只有这一间杂货铺。所以每天人来人往，也 挺热闹。这里无论是油盐酱醋，还是大米白面，各种日常用品也是样样齐 全。中间一张柜台，店主人正坐在柜台后面算帐。据说私底下他也卖一些 贵重的东西。"
  x = -1
  y = -4
