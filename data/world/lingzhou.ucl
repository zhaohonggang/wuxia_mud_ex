zones "lingzhou" {
  name = "lingzhou"
}

# Generated from C:/files/git/mud/d/lingzhou/baxian.c by LPCConverter
# Zone: lingzhou

    rooms "baxian" {
      name = "八仙道观"
      description = "这里是八仙道观，内有八仙殿，供着张果老、铁拐李、吕洞宾等八 仙的塑像，香案上香烟缭绕。靠墙放着几张太师椅，地上放着几个蒲团。 东西两侧是走廊，北边是东二巷， 南边是后院,种着些杨柳和老槐树， 是道士们休息的地方。后院还有一口井，不过看上去有点异样。"
  x = 4
  y = 4
  z = 0
    }

  room_exits "baxian" {
    room_id = rooms.baxian.id
    west = rooms.xiaolu2.id
    }


  room_characters "baxian" {
    room_id = rooms.baxian.id
    characters = [
      { id = characters.laodaoshi.id }    ]
  }

# Generated from C:/files/git/mud/d/lingzhou/beidajie.c by LPCConverter
# Zone: lingzhou

    rooms "beidajie" {
      name = "北大街"
      description = "这是灵州北大街，干净、宽敞、安静。双人合抱的杨树十步一株， 整齐的排在路的两边。西面和东面都是高高的围墙，南面通向城中心， 北面就是西夏皇宫大门了。因为是皇城和城中心的唯一连接通道，便不 容许在两边开店，显得特别清静。"
  x = 0
  y = 1
  z = 0
    }

  room_exits "beidajie" {
    room_id = rooms.beidajie.id
    north = rooms.gonggate.id
    south = rooms.center.id
    }

# Generated from C:/files/git/mud/d/lingzhou/biangate.c by LPCConverter
# Zone: lingzhou

    rooms "biangate" {
      name = "边门"
      description = "这里是皇宫的边门，供侍卫和内侍们出入之用，宫里所需的东西一 般都由此运入，因为比较偏僻，守卫的卫士也不多。"
  x = 1
  y = 4
  z = 0
valid_leave = [
{
   condition = "dir == 'west' && objectp(present('wei shi',environment(me)))"
direction = "west"
  message = "卫士对你大吼一声：放肆！那不是你能进去的地方。"
}

]
    }

  room_exits "biangate" {
    room_id = rooms.biangate.id
    east = rooms.xiaolu3.id
    }


  room_characters "biangate" {
    room_id = rooms.biangate.id
    characters = [
      { id = characters.gongweishi.id },
      { id = characters.gongweishi.id }    ]
  }

# Generated from C:/files/git/mud/d/lingzhou/biaoqiyin.c by LPCConverter
# Zone: lingzhou

    rooms "biaoqiyin" {
      name = "骠骑营"
      description = "这里是皇室禁卫军的驻地，在灵州城西北，骠骑营占地面积庞大， 北面是营房，南面是小校场，西面紧挨着城墙是一排马厩，有东营门 和南营门通向皇宫和大街。骠骑营的军士俱是西夏军中千挑万选的猛 士，平时负责皇城外围的警戒，皇上出巡时便挑起开道护卫的重责， 战时更是一支生力军。"
  x = -2
  y = 0
  z = 0
    }

  room_exits "biaoqiyin" {
    room_id = rooms.biaoqiyin.id
    northwest = rooms.ximen.id
    west = rooms.malan.id
    east = rooms.xidajie.id
    north = rooms.yinfang.id
    south = rooms.xiaoxiaochang.id
    }


  room_characters "biaoqiyin" {
    room_id = rooms.biaoqiyin.id
    characters = [
      { id = characters.xixiabing.id },
      { id = characters.xixiabing.id }    ]
  }

# Generated from C:/files/git/mud/d/lingzhou/center.c by LPCConverter
# Zone: lingzhou

    rooms "center" {
      name = "城中心"
      description = "这里是西夏都城灵州的中心广场，也是四条大街的交汇处，北面是 皇城，南面是商业繁华地段，西面是普通商人区和骠骑营，东面衙门和 王公贵族们的府第。灵州是西域最大的物资集散地和商业中心，也是西 域通往中原的必经之地。各色人等来来往往，马嘶人喊，热闹非凡，广 场空地上卖艺的、要饭的、大腹便便的财主、提笼携鸟的王公贵戚到处 都是，偶尔也有行色匆匆的江湖人士一晃而过。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "center" {
    room_id = rooms.center.id
    west = rooms.xidajie.id
    east = rooms.dongdajie.id
    north = rooms.beidajie.id
    south = rooms.nandajie.id
    }

# Generated from C:/files/git/mud/d/lingzhou/chema.c by LPCConverter
# Zone: lingzhou

    rooms "chema" {
      name = "车马店"
      description = "一家低档的车马客栈，建筑相当陈旧，很不起眼，不过由于价钱低 廉，又是在北门的交通要道上，三教九流多选择这里落脚，生意也相当 不错，你也可以在这里打听到当地的风土人情。     墙上挂着一个牌子(paizi)。"
  x = 1
  y = -1
  z = 0
item_desc = {
 paizi = "楼上雅房，每夜十两白银。"
}
valid_leave = [
{
   condition = "!me->query_temp('rent_paid') && dir == 'up'"
direction = "up"
  message = "店小二一下挡在楼梯前，白眼一翻：怎麽着，想白住啊！"
}
,
{
   condition = "me->query_temp('rent_paid') && dir == 'west'"
direction = "west"
  message = "店小二跑到门边拦住：客官已经付了银子，怎麽不住店就走了呢！ 旁人还以为小店伺候不周呢！"
}

]
    }

  room_exits "chema" {
    room_id = rooms.chema.id
    up = rooms.chema2.id
    west = rooms.nandajie.id
    east = rooms.majiu.id
    }


  room_characters "chema" {
    room_id = rooms.chema.id
    characters = [
      { id = characters.xiaoer.id }    ]
  }

