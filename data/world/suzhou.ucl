# Generated from C:/files/git/mud/d/suzhou/baodaiqiao.c by LPCConverter
# Zone: suzhou

    rooms "baodaiqiao" {
      name = "宝带桥"
      description = "宝带桥横跨于苏州的运河之上，又因桥形宛若长带，被称 为长桥。桥面宽阔，行人在桥上来往，桥边有城里的小贩吆喝、 叫卖着，熙熙攘攘，热闹非凡。宝带桥卧于碧波之上，相应生 辉，分外多娇。这里是中秋赏月的一处绝佳之地。"
  x = 0
  y = -1
  z = 0
    }

  room_exits "baodaiqiao" {
    room_id = rooms.baodaiqiao.id
    south = rooms.nandajie1.id
    north = rooms.zhongxin.id
    }


