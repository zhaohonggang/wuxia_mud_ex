    rooms "bailianchi" {
      name = "白莲池"
      description = "白莲池位于二仙亭的北面，池中种有千叶莲花，池上架彩 莲曲桥，相传吴王夫差与西施曾在此采莲赏荷。"
  x = -2
  y = 2
  z = 0
    }

