# Zone: suzhou

    rooms "bingying" {
      name = "兵营"
      description = "这里是兵营，密密麻麻到处都是官兵，有的在武将的指挥 下列队操练，有的独自在练功，有的坐着、躺着正在休息。南 墙下坐着主帅，不动声色地寻视着四周。看到你进来，他们全 都向你包围了过来，形势看来不太妙。"
  x = -1
