# Zone: suzhou

    rooms "beimen" {
      name = "北门"
      description = "这是苏州府的北城门。出门远远可见西面的虎丘山。放眼 望去尽是绿的田，翠的草和清清的小河。门边官兵身后贴着一 份告示(gaoshi)。南北一条笔直的官道。"
  x = 0
  y = 4
  z = 0
    }

