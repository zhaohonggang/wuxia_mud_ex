    rooms "beidajie2" {
      name = "北大街"
      description = "这是一条宽阔的青石街道，向南北两头延伸。北边是北城 门通向城外。南边显得很繁忙。东边是一座两层的楼阁，名为 春在楼。西面是一座庙庵，南面是一条笔直的大街，十分繁华。"
  x = 0
  y = 3
  z = 0
    }

