layer_wins(object who, int total) { object money = new("/clone/money/" + who->query_temp("gamble_bet/money")); int amount = who->query_temp("gamble_bet/amount"); total = total * amount; money->set_amount(total); message_vision(sprintf("$N赢了%s%s%s！\n", chinese_number(total), money->query("base_unit"), money->query("name")), who); money->move(who); } void player_loses(object who, int total) { object money = new("/clone/money/" + who->query_temp("gamble_bet/money")); total = who->query_temp("gamble_bet/amount"); message_vision(sprintf("庄家将$N押在银盘中的%s%s%s收走。\n", chinese_number(total), money->query("base_unit"), money->query("name")), who); destruct(money); } void gamble_finish() { string win; int total, i; object room = this_object(); object *list; if (res[0]==big[0] && res[1]==big[1]) { total = 36; win = "tc"; } else if (res[0]==res[1] && (res[0]/2*2 == res[0])) { total = 12; win = "sd"; } else { int r = res[0]+res[1]; if (r==7) { total = 6; win = "qx"; }
