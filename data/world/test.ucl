    rooms "beidajie1" {
      name = "北大街"
      description = "这是一条宽阔的青石大街，两旁店铺林立，行人熙熙攘攘。\n北边是玫瑰宴厅，西边是牡丹宴厅，东边通往客店。"
  x = 0
  y = 0
  z = 0
    }
