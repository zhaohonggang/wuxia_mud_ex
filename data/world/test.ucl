    rooms "cave1" {
      name = "岩洞深处"
      description = "岩洞越往里越宽敞，洞壁上长满了发光的苔藓，泛着幽幽的\n蓝绿色光芒。地下有清澈的地下河流过，水声潺潺。洞顶垂下\n无数钟乳石，形态各异。出口在南边。"
  x = 0
  y = 0
  z = 0
    }
  room_exits "cave1" {
    room_id = rooms.cave1.id
  out = rooms.cave.id  }


