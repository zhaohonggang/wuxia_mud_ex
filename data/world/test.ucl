# Zone: test

    rooms "cave" {
      name = "岩洞"
      description = "这里是一个大岩洞，在白驼山特殊的地质条件下经过漫长\n的年代形成的。洞内蜿蜒曲折，也不知延伸到了何处。"
  x = 0
  y = 0
  z = 0
    }
  room_exits "cave" {
