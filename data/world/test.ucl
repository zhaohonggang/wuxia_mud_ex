    rooms "test_guangchang" {
      name = "镇广场"
      description = "这里是柳溪镇的中央广场，青石板铺就的地面被岁月磨得\n光可鉴人。广场中央竖着一根高大的旗杆(qigan)，上书「柳\n溪」二字的杏黄旗在风中猎猎作响。来往的乡民、行脚商人和\n江湖客在此穿行，不时传来小贩的吆喝声。东面是一间热闹的\n客栈，南边传来隐隐的喝喝之声，似乎有人在练武。镇口东北\n方向的官道(yangzhou)直通扬州府。"
  x = 0
  y = 0
  z = 0
    }
