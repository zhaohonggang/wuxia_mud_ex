    rooms "mudan" {
      name = "牡丹宴厅"
      description = "这里是醉仙楼的牡丹宴厅。你走进门，绕过了一道淡绿绸\n屏风，迎面的墙上挂着一副『牡丹争艳图』，工笔彩绘，状极\n清雅，气质卓绝。厅内陈列奢华，正中央一张雕花楠木青漆嵌\n玉大圆桌。四周十二张镶银象牙扶手红木椅，杯碗勺箸，入眼\n生辉，桌上铺着份菜单(menu)。\n"
  x = 0
  y = 0
  z = 0
    }
