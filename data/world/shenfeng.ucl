# Generated from C:/files/git/mud/d/shenfeng/feicui1.c by LPCConverter
# Zone: shenfeng

    rooms "feicui1" {
      name = "翡翠池"
      description = "这里四周群山围绕，就如一只大盆一般，盆子中心碧水莹 然，绿若翡翠，是个圆形的大水池(pool)，隔了这千百年，竟 然并不曾干枯，想来池底另有活水源头。你走近池边，伸下手 去只觉清凉入骨，双手捧起水来但见池水澄净清澈，更无纤毫 苔泥，原来圆池四周都是翡翠，池水才映成绿色。只见洁白的 玉峰映在碧绿的池中，明艳洁净，幽绝清绝。"
  x = 0
  y = 0
  z = 3
item_desc = {
 pool = "池水澄净清澈，更无纤毫苔泥，圆池四周都是翡翠。"
}
    }

  room_exits "feicui1" {
    room_id = rooms.feicui1.id
    down = rooms.bridge2.id
    up = rooms.yongdao5.id
    }




  room_items "feicui1" {
    room_id = rooms.feicui1.id
    items = [
      { id = items.skeleton3.id }    ]
  }

# Generated from C:/files/git/mud/d/shenfeng/feicui2.c by LPCConverter
# Zone: shenfeng

    rooms "feicui2" {
      name = "翡翠池"
      description = "这里是一个四周镶满翡翠的圆池，你身在池中，伸下手去 只觉清凉入骨，双手捧起水来但见池水澄净清澈，更无纤毫苔 泥，原来圆池四周都是翡翠，池水才映成绿色。洁白的玉峰映 在碧绿的池中，显得格外的明艳洁净，幽绝清绝。只见池边长 满了翠绿的青藤(rattan)。池底似乎有个洞(hole)。"
  x = 0
  y = 0
  z = 4
item_desc = {
 rattan = "生长在翡翠池岸边的翠绿青藤，可以由它爬上岸去。"
 hole = "潜藏在池底的一个小洞，你似乎可以钻进去。"
}
    }
  room_exits "feicui2" {
    room_id = rooms.feicui2.id
    down = rooms.yongdao5.id
    up = rooms.shenfeng.id
    }

# Generated from C:/files/git/mud/d/shenfeng/feixu1.c by LPCConverter
# Zone: shenfeng

    rooms "feixu1" {
      name = "高昌废墟"
      description = "陡然间眼前一片空旷，此时朝阳初升，只见景色奇丽，莫 可名状。一座白玉山峰参天而起，峰前一排排的都是房屋。千 百所房屋断垣剩瓦，残破不堪，已没一座完整，但建筑规模宏 大，气象开朗，可见当年是一座十分繁荣的城市。"
  x = -1
  y = 2
  z = 2
    }

  room_exits "feixu1" {
    room_id = rooms.feixu1.id
    west = rooms.feixu2.id
    east = rooms.shibi.id
    }

