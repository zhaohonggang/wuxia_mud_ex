    rooms "huijiang5" {
      name = "绿洲"
      description = "在沙漠的尽头出现了一个绿洲。这儿是南疆难得一见的草 原。草原上的夜晚，天很高、很蓝，星星很亮，青草和小花散 播著芳香。隐隐约约随风声飘来天铃鸟的歌声。这里居住着哈 萨克人, 以放牧羊群为生。灌木丛中有一眼坎儿井。井台上有 个木杯专供口渴的行人喝水。井边是一块瓜地。"
  x = -1
  y = 2
  z = 1
    }

