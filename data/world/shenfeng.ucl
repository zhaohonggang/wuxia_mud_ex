    rooms "huijiang2" {
      name = "帕米尔草原"
      description = "这里已是南疆。独特的地势和气候，竟形成南疆难得一见 的小片草原。因天山挡住了北方寒风，这儿物产丰富，聚居了 不少哈萨克族人。波斯商人也常来此地贩卖土产。"
  x = -2
  y = 3
  z = 2
    }

  room_exits "huijiang2" {
    room_id = rooms.huijiang2.id
