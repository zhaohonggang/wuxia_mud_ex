zones "shenfeng" {
  name = "shenfeng"
}

# Generated from C:/files/git/mud/d/shenfeng/bridge1.c by LPCConverter
# Zone: shenfeng

    rooms "bridge1" {
      name = "独木桥"
      description = "四下无声，仰视苍天，注视雪白的山峰，令人不觉怆然而 发思古之幽情。往前只见一道飞岩，下临绝崖，只有一条狭窄 的独木桥(bridge)通达对崖，危桥在谷风中不停地抖动。"
  x = 0
  y = 0
  z = 1
item_desc = {
 bridge = "这是一条宽约七寸的独木桥，看来只能走(zou)过一人。"
}
    }

  room_exits "bridge1" {
    room_id = rooms.bridge1.id
    up = rooms.bridge2.id
    down = rooms.dadian.id
    south = rooms.xiaojing.id
    }

# Generated from C:/files/git/mud/d/shenfeng/bridge2.c by LPCConverter
# Zone: shenfeng

    rooms "bridge2" {
      name = "独木桥"
      description = "这是一条宽约七寸的独木桥(bridge)，天风凛冽，吹的人 衣襟头发齐飞，只要一不留神，稍一失足，立刻便要粉身碎骨。 两崖相隔，约有五十余丈，往下看，峭壁如刀削，云卷雾涌深 不见底，投块石子下去，也听不到回声！"
  x = 0
  y = 0
  z = 2
item_desc = {
 bridge = "这是一条宽约七寸的独木桥，看来只能走(zou)过一人。"
}
    }

  room_exits "bridge2" {
    room_id = rooms.bridge2.id
    up = rooms.feicui1.id
    down = rooms.bridge1.id
    north = rooms.xiaojing1.id
    }

