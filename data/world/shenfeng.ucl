    rooms "diantang" {
      name = "殿堂"
      description = "走到大殿之后，见是一座较小的殿堂，殿中情景却尤为可 怖，数十具骸骨一堆堆相互纠结，骸骨大都直立如生时，有的 手中握有兵刃，有的却是空手。西侧有一扇小石门。"
  x = 0
