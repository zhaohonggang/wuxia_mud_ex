# Generated from C:/files/git/mud/d/shenfeng/caoyuan5.c by LPCConverter
# Zone: shenfeng

    rooms "caoyuan5" {
      name = "戈壁"
      description = "戈壁平坦如镜，和沙漠上的沙丘起伏全然不同，只见一片 平沙，凝眸远眺，只觉天地相接，万籁无声，身当此境，不禁 也生栗栗之感，顿觉大千无限，一己渺小异常。"
  x = -3
  y = 0
  z = 1
    }

