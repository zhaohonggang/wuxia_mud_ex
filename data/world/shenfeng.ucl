# Generated from C:/files/git/mud/d/shenfeng/huijiang1.c by LPCConverter
# Zone: shenfeng

    rooms "huijiang1" {
      name = "帕米尔高原"
      description = "翻过天山顶峰，便来到帕米尔高原。真是天外有天，你仿 佛来到另一个世界。这儿冰雪消融，春意盎然。从那雪峰直垂 下来的溪涧里，长满了野果树。山风习习，空气清凉如水。山 花烂漫, 几里地外也能闻到馥郁的花香。"
  x = -2
  y = 4
  z = 3
    }

  room_exits "huijiang1" {
    room_id = rooms.huijiang1.id
    southdown = rooms.huijiang2.id
    }




