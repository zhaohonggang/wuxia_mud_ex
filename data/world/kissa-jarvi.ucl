zones "kissa-jarvi" {
  name = "基萨湖 Kissa Järvi"
}

rooms "gates" {
  name = "萨玛蒂之门 The Gates to Sammatti"
  description = "你正站在通往萨玛蒂的大门前面。You are in front of the gates to Sammatti."

  x = 1
  y = 3
  z = 0

  features = [
    {
      keyword = "lake edge"
      short = "湖岸悄然逼近入口。The lake edge creeps close to the entrance."
      long = "湖岸悄然逼近入口。The lake edge creeps close to the entrance."
    }
  ]
}

room_exits "gates" {
  room_id = rooms.gates.id

  north = sammatti.rooms.town_square.id
  south = rooms.path-1.id
}

rooms "path-1" {
  name = "基萨小径 Kissa Path"
  description = "一条远离萨玛蒂的土路。A dirt road leading away from Sammatti."

  map_color = "brown"
  map_icon = "trail"

  x = 1
  y = 2
  z = 0

  features = [
    {
      ref = features.stones
    }
  ]
}

