# Generated from C:/files/git/mud/d/tianlongsi/damen.c by LPCConverter
# Zone: tianlongsi

    rooms "damen" {
      name = "大门"
      description = "你来到了天龙寺大门前，只见气势恢弘的两个大门柱上刻有一付对联 ( duilian )，红漆覆字，颇有点拨众生之意。抬头上望，门楣上一块黑 木大匾，上题“崇圣寺”三个大字，笔意苍松。此乃正式寺名，但大理百 性叫惯了，都称之为“天龙寺”。"
  x = 0
  y = 3
  z = 0
item_desc = {
 duilian = "心性无染本自圆成　但离妄缘即如如佛"
}
    }

  room_exits "damen" {
    room_id = rooms.damen.id
    north = rooms.hongsheng.id
    south = rooms.talin.id
    }


  room_characters "damen" {
    room_id = rooms.damen.id
    characters = [
      { id = characters.guest.id }    ]
  }

