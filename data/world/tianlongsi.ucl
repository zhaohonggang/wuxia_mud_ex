# Zone: tianlongsi

    rooms "munitang" {
      name = "牟尼堂"
      description = "这是高僧们的静修之处。整堂全以松木制成，板门木柱，木料均不去 皮，天然质朴，和一路行来金碧辉煌的殿堂截然不同。"
  x = 0
  y = -7
  z = 0
    }

  room_exits "munitang" {
    room_id = rooms.munitang.id
    north = rooms.banruotai.id
