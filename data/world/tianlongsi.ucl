zones "tianlongsi" {
  name = "tianlongsi"
}

# Generated from C:/files/git/mud/d/tianlongsi/banruotai.c by LPCConverter
# Zone: tianlongsi

    rooms "banruotai" {
      name = "般若台"
      description = "这是个普通的石台，相传当年佛祖曾降临此台传法。再往南去就是本 寺重地----牟尼堂。江湖中传言天龙寺的镇寺之宝----六脉神剑谱就藏于 此中。"
  x = 0
  y = -6
  z = 0
    }

  room_exits "banruotai" {
    room_id = rooms.banruotai.id
    north = rooms.doushuai.id
    south = rooms.munitang.id
    }

# Generated from C:/files/git/mud/d/tianlongsi/baodian.c by LPCConverter
# Zone: tianlongsi

    rooms "baodian" {
      name = "崇圣宝殿"
      description = "这是一座宽广的大殿，正面有一座高约二十余尺的佛祖宝像，通体金 光耀眼。座下香烟缭绕。大殿两旁树立两根檀木大柱，题有一联，云曰： 　　　　　　守口摄意身莫犯　　莫恼一切诸有情"
  x = 0
  y = 0
  z = 0
    }

  room_exits "baodian" {
    room_id = rooms.baodian.id
    up = rooms.dadao1.id
    north = rooms.ta1.id
    }

# Generated from C:/files/git/mud/d/tianlongsi/cibeiyuan.c by LPCConverter
# Zone: tianlongsi

    rooms "cibeiyuan" {
      name = "慈悲院"
      description = "这是僧人们点化顽徒的地方。不少江湖豪客由于厌倦了打打杀杀 的日子，来到此处落发为僧，叛依佛门。墙上一幅佛祖神像，两边各 有一条幅，上书：放下屠刀，立地成佛。"
  x = -1
  y = -3
  z = 0
    }

  room_exits "cibeiyuan" {
    room_id = rooms.cibeiyuan.id
    south = rooms.sanwugong.id
    east = rooms.wuwujing.id
    }

# Generated from C:/files/git/mud/d/tianlongsi/dadao1.c by LPCConverter
# Zone: tianlongsi

    rooms "dadao1" {
      name = "青石大道"
      description = "你走在一条青石大道上，人来人往非常繁忙，不时地有人骑着马匆匆而过。 大道两旁有一些小货摊，似乎是一处集市。这条大道通向边域名城----大理。"
  x = 0
  y = 0
  z = 1
    }

  room_exits "dadao1" {
    room_id = rooms.dadao1.id
    up = rooms.tading.id
    down = rooms.baodian.id
    northeast = rooms.qsjie2.id
    south = rooms.dadao2.id
    }

