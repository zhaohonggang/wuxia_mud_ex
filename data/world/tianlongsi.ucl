    rooms "ta1" {
      name = "舍利塔"
      description = "这是天龙三塔中最高的一座，高约三百余尺，共有十六级。相传塔顶 原本供奉着一颗前代高僧的舍利子，但在当年奸臣杨义贞弑上德帝篡位以 至天下大乱时，舍利子不知何因而失踪了，这也成为天龙寺历代主持的心 腹大事。这个传言也不知是真是假。"
  x = 0
  y = 1
  z = 0
    }

