# Generated from C:/files/git/mud/d/tianlongsi/doushuai.c by LPCConverter
# Zone: tianlongsi

    rooms "doushuai" {
      name = "兜率大士院"
      description = "这是一般参拜者所能到的最远的地方，再往南就是天龙寺历代高僧静 修之处----牟尼堂。那是常人不可轻易打搅的地方，你最好不要擅自闯入 。除非你确信能给高僧们带去好消息。"
  x = 0
  y = -5
  z = 0
    }

