# Generated from C:/files/git/mud/d/hangzhou/jiulou.c by LPCConverter
# Zone: hangzhou

    rooms "jiulou" {
      name = "楼外楼"
      description = "提起“楼外楼”方圆百里无人不知。这里各式名菜是杭州一绝。 来游湖的人们都一定会来这里尝尝。整个大堂闹哄哄的挤满了各式人 等。店小儿跑来跑去，忙着招呼客人。墙上挂着价格牌子(paizi)。"
  x = 2
  y = 0
