    rooms "longjing" {
      name = "龙井"
      description = "只见井(jing)水澈可见底而且清冷异常。龙井原名龙泓涧，传说 此井与海相通，其中必定有龙，祈祷必雨，故名“龙井”。苏东坡曾 有诗“人言山佳水亦佳，下有万古蛟龙潭”。井旁建有茶室。往南便 回大路。"
  x = -7
  y = -5
  z = 0
item_desc = {
