    rooms "jujingyuan" {
      name = "聚景园"
      description = "漫步园中，只见湖傍遍置垂柳。柳树丛中，种了不少碧桃。东风 送暖之时，这里“杨柳千条拂面丝，绿烟金穗不胜吹”。诗人刘禹锡 的“桃红李白皆夸好，须得垂杨相发挥”形容的恰到好处。东面是清 波门，往东北便是柳浪桥。"
  x = -1
  y = -4
  z = 0
