# Generated from C:/files/git/mud/d/hangzhou/loveroom.c by LPCConverter
# Zone: hangzhou

    rooms "loveroom" {
      name = "相约轩"
      description = "楼外楼的相约轩，四面通窗。湖风拂面，淡淡生暖。远望苏堤一 线，映波，锁澜，望山，压堤，东浦，跨虹六桥断续连沿，烟柳笼纱， 流莺娇啼。近处白堤横亘湖上，堤上杨柳覆地，芳草寒茵如一段碧绸 飘然湖面。室内一张精巧的小桌。桌上一纸精致的菜单(menu)。"
  x = 2
