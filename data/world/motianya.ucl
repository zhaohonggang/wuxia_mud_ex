    rooms "mtyadi" {
      name = "崖底"
      description = "你的面前是一座笔直的山峰，高若千丈，峰顶在云雾中隐约可见， 山峰光秃秃的，更无置手足处，山峰垂下一条铁链(lian)，仔细一看， 铁链并无锈迹，似乎有人用它爬(climb)上爬下。"
  x = 0
  y = 0
  z = -1
    }

