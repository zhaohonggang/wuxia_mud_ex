      description = "这是一条山路，两旁是茂盛的森林，有一个女孩在这眼望南边发 呆，南边就是摩天崖了，一股阴森恐怖的气氛随之而来，你不禁告诉 自己，还是快走吧。"
  x = 0
  y = 1
  z = -1
