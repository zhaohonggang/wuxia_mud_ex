# Generated from C:/files/git/mud/d/motianya/mtdating.c by LPCConverter
# Zone: motianya

    rooms "mtdating" {
      name = "崖顶"
      description = "这就是摩天崖了。上面光秃秃的，连一棵小树也没有，峰顶到也 十分开阔，但身周云雾缭绕，当真是置身云端之中，使人心惊肉跳。 东面有一个小木屋。"
  x = 0
  y = 0
  z = 0
valid_leave = [
{
   condition = "dir == 'east' && objectp(ob = present('xie yanke',this_object())) && living(ob)"
direction = "east"
  message = "谢烟客把手一拦，喝道：“给我回来！”"
}

]
    }

  room_exits "mtdating" {
    room_id = rooms.mtdating.id
    down = rooms.mtyadi.id
    east = rooms.mtxiaowu.id
    }


  room_characters "mtdating" {
    room_id = rooms.mtdating.id
    characters = [
      { id = characters.xieyan.id }    ]
  }

