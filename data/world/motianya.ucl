    { key = "石破天" value = "他..." }
  ]

  chat_chance = 8
chats = [
    "石中玉说道: 叮当，你在哪呀，我好想你呀。",
    "石中玉叹道: 也不知道我的叮当怎么样了。",
    "石中玉说道: 腊八粥可是好东西...",
    "石中玉说道: 唉，谁能帮我杀了外面的老头，兄弟我谢谢你了！"
]


