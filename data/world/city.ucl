    rooms "qiyuan1" {
      name = "棋苑"
      description = "棋苑共分四个大间，是手谈休栖的好地方。这里的南北和东三个方 向各有一间棋室，在每个棋室的门外都贴着请勿打扰棋局的牌子。"
  x = 2
  y = 0
  z = 0
valid_leave = [
{
   condition = "(room->query_temp('action') == 1) && (dir == 'north' || dir == 'south' || dir == 'west')"
direction = ~
  message = "那间棋室已经有人开始下棋了，请勿打扰"
}

]
    }

  room_exits "qiyuan1" {
    room_id = rooms.qiyuan1.id
    west = rooms.liaotian.id
    north = rooms.qiyuan4.id
    south = rooms.qiyuan3.id
    east = rooms.qiyuan2.id
    }

# Generated from C:/files/git/mud/d/city/qiyuan/qiyuan2.c by LPCConverter
# Zone: city

    rooms "qiyuan2" {
      name = "棋室"
      description = "棋苑共分四个大间，是手谈休栖的好地方。这个房间里有一张石桌，上面划着 一张围棋盘。桌角摆放着棋子。另外还有两张石凳，颜色一白一黑。在门口的墙壁 上贴着一张下棋指南(help)。"
  x = 3
  y = 0
  z = 0
valid_leave = [
{
   condition = "me->query_temp('weiqi_seat')"
   all_dirs = true
direction = ~
  message = "你现在还坐着呢，怎么离开啊？"
}

]
    }

  room_exits "qiyuan2" {
    room_id = rooms.qiyuan2.id
    west = rooms.qiyuan1.id
    }




  room_items "qiyuan2" {
    room_id = rooms.qiyuan2.id
    items = [
      { id = items.table.id },
      { id = items.seat.id }    ]
  }

