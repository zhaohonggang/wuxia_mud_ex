zones "wanjiegu" {
  name = "wanjiegu"
}

# Generated from C:/files/git/mud/d/wanjiegu/backyard.c by LPCConverter
# Zone: wanjiegu

    rooms "backyard" {
      name = "后院"
      description = "后院是一大片开阔的草地，绿草如荫，几朵野花点缀其间，草 地中间放着一块大石刻成的棋盘，一个黄眉老僧和一个青袍客正在 下棋。北边有一间石屋，门口被一块大石头(rock)挡住了。"
  x = 0
  y = 1
  z = 0
item_desc = {
 rock = "一块很大的石头，挡住了石屋的入口。"
}
    }

  room_exits "backyard" {
    room_id = rooms.backyard.id
    south = rooms.hall.id
    }


  room_characters "backyard" {
    room_id = rooms.backyard.id
    characters = [
      { id = characters.monk.id },
      { id = characters.duan_duanyq.id }    ]
  }




# Generated from C:/files/git/mud/d/wanjiegu/bed_room.c by LPCConverter
# Zone: wanjiegu

    rooms "bed_room" {
      name = "卧室"
      description = "这是钟谷主的卧室，室内大红的帏帐挂在大红的木床之上。墙 上贴满了各种花花绿绿的东西。床边有个小柜，柜上放着一盏豆油 灯。"
  x = -1
  y = 1
  z = 0
    }

  room_exits "bed_room" {
    room_id = rooms.bed_room.id
    south = rooms.left_room.id
    }


  room_characters "bed_room" {
    room_id = rooms.bed_room.id
    characters = [
      { id = characters.zhongling.id }    ]
  }

# Generated from C:/files/git/mud/d/wanjiegu/bridge.c by LPCConverter
# Zone: wanjiegu

    rooms "bridge" {
      name = "铁索桥"
      description = "一座横跨澜沧江的铁索桥，此桥共有四道铁索，两条在下，上 铺木板，以供行走，两条在旁，作为扶手。一踏上桥，几条铁索便 即晃动。江水荡荡，如快马奔腾从脚底飞过，只要一个失足，卷入 江水，任你多好的水性也难活命。"
  x = 5
  y = -3
  z = -1
    }

  room_exits "bridge" {
    room_id = rooms.bridge.id
    east = rooms.port.id
    west = rooms.port2.id
    }

# Generated from C:/files/git/mud/d/wanjiegu/drug_room.c by LPCConverter
# Zone: wanjiegu

    rooms "drug_room" {
      name = "药房"
      description = "刚进这间屋子，就有一股浓重的药味扑面而来。房子中间有一 个练药用的石臼，还有几只药匙放在一边。靠墙一排架子，架子上 摆满了药瓶，数百个瓶子上都写着药物的名字。"
  x = 1
  y = 1
  z = 0
    }

  room_exits "drug_room" {
    room_id = rooms.drug_room.id
    south = rooms.right_room.id
    }




  room_items "drug_room" {
    room_id = rooms.drug_room.id
    items = [
      { id = items.mortar.id }    ]
  }

# Generated from C:/files/git/mud/d/wanjiegu/entrance.c by LPCConverter
# Zone: wanjiegu

    rooms "entrance" {
      name = "大森林"
      description = "这里是好大一座森林，黑压压的一片望不到边。最特别是左首 一排并列着九株参天大松树，每颗树都高耸入云。树下草丛茂密， 挡住了去路。"
  x = 0
  y = -3
  z = 0
item_desc = {
 grass = "一片茂密的草丛，你可以试着把它拨开(pushaside)。"
}
    }

  room_exits "entrance" {
    room_id = rooms.entrance.id
    east = rooms.shan_road4.id
    }

# Generated from C:/files/git/mud/d/wanjiegu/grassland.c by LPCConverter
# Zone: wanjiegu

    rooms "grassland" {
      name = "草地"
      description = "这是一大片草地，前面一排松树挡住了去路。只见一株大松上 削下了丈许长、尺许宽的一片，漆着白漆，写着九个大字，“姓段 者入此谷杀无赦”。树上挂着一个铁锤。"
  x = 0
  y = -2
  z = 0
item_desc = {
 hammer = "一个铁锤，可以用来敲(knock)东西。"
}
    }

  room_exits "grassland" {
    room_id = rooms.grassland.id
    in = rooms.tunnel2.id
    }

