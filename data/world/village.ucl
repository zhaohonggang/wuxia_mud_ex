zones "village" {
  name = "village"
}

# Generated from C:/files/git/mud/d/village/alley1.c by LPCConverter
# Zone: village

    rooms "alley1" {
      name = "小巷"
      description = "这是一条黑暗、肮脏的小巷，空气中仿佛飘扬着一股罪恶的气息，西 北边通向小巷深处，正人君子是不会往那边走去的。往东走就会回到村中 大路了。"
  x = -1
  y = -2
  z = 0
    }

  room_exits "alley1" {
    room_id = rooms.alley1.id
    northwest = rooms.alley2.id
    east = rooms.sroad3.id
    }

# Generated from C:/files/git/mud/d/village/alley2.c by LPCConverter
# Zone: village

    rooms "alley2" {
      name = "小巷尽头"
      description = "这里是小巷的尽头，一只破木箱上摆着几样粗制的赌具，地上乱扔着 些鸡骨头，空气中有一股鸡香、酒香和汗臭混杂在一起的味道。看来这里 是村内地痞、流氓聚集的地方。"
  x = -2
  y = -1
  z = 0
    }

  room_exits "alley2" {
    room_id = rooms.alley2.id
    southeast = rooms.alley1.id
    }


  room_characters "alley2" {
    room_id = rooms.alley2.id
    characters = [
      { id = characters.punk.id },
      { id = characters.dipi.id }    ]
  }

# Generated from C:/files/git/mud/d/village/bighouse1.c by LPCConverter
# Zone: village

    rooms "bighouse1" {
      name = "前厅"
      description = "这是一间很普通的青砖瓦房，但在这个小村子里已是首屈一指的“豪 宅”了。这里是前厅，厅里的摆设很简单，乡下土财主都很财迷，就算有 几个钱儿，也是舍不得花。东边是个小门通向内室。"
  x = 1
  y = -1
  z = 0
    }

  room_exits "bighouse1" {
    room_id = rooms.bighouse1.id
    east = rooms.bighouse2.id
    west = rooms.sroad4.id
    }

# Generated from C:/files/git/mud/d/village/bighouse2.c by LPCConverter
# Zone: village

    rooms "bighouse2" {
      name = "内室"
      description = "这里是一间寝室，屋子中间有一张大床，床上的被褥居然是绸缎的， 看来这个土财主对自己并不是十分刻薄。屋里摆着几只木箱子，墙角里有 一只大柜子(cabinet)。"
  x = 2
  y = -1
  z = 0
    }

  room_exits "bighouse2" {
    room_id = rooms.bighouse2.id
    west = rooms.bighouse1.id
    }

# Generated from C:/files/git/mud/d/village/eexit.c by LPCConverter
# Zone: village

    rooms "eexit" {
      name = "东村口"
      description = "这里是华山脚下，虽然远离县城，却没有什麽山贼草寇在附近出没。 往东就是上山的路了。西边是一个小村庄，村子里人家并不多，村民们过 着日出而作，日落而息的宁静生活。"
  x = 4
  y = 0
  z = 0
    }

  room_exits "eexit" {
    room_id = rooms.eexit.id
    east = huashan.rooms.path1.id
    west = rooms.eroad1.id
    }


