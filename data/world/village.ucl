    greet_delay = 0
    add_actions = ["buy"]
  }

  accept = [
    { kind = "item_id" id = "hand letter" accept = true msg = ["{npc}说道：这把剑虽不起眼，可也是小人的心血，总算对得起岳掌门。{npc}把name交给了{name}。", "冯铁匠眼也不抬，说道：要剑自己进去拿。"] },
    { kind = "any" accept = false }
  ]
    }

