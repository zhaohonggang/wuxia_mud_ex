    rooms "cangjinglou" {
      name = "藏经楼"
      description = "这里是报国寺藏经楼。阁楼上密密麻麻排了好多书架，架 上摆满了经书。有两个身穿白衣的小师太正在一角静静地读着 经书。"
  x = 19
