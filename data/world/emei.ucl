# Zone: emei

    rooms "bashisipan1" {
      name = "八十四盘"
      description = "八十四盘，道路艰险陡峭，迂回盘折，令人不能喘息。路 左是蔽日遮天的冷杉林，路右是深不见底的绝壁峡谷。由此往 上至接引殿，北下到洗象池。"
  x = 0
  y = 6
  z = -3
    }

  room_exits "bashisipan1" {
    room_id = rooms.bashisipan1.id
