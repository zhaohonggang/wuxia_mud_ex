zones "emei" {
  name = "emei"
}

# Generated from C:/files/git/mud/d/emei/bailongdong.c by LPCConverter
# Zone: emei

    rooms "bailongdong" {
      name = "白龙洞"
      description = "白龙洞据说是「白蛇传」中的白娘子修炼成仙之处。这里 楠木参天，林荫夹道，株株秀挺俊拔，枝叶分披上捧，如两手 拥佛，传为古时一高僧按「法华经」口诵一字植树一株，共植 六万九千七百七十七株，时称古德林。这里北上至万年庵，南 下是清音阁。"
  x = 9
  y = 10
  z = -14
    }

  room_exits "bailongdong" {
    room_id = rooms.bailongdong.id
    southeast = rooms.gudelin1.id
    northup = rooms.wannianan.id
    west = rooms.gudelin2.id
    east = rooms.qingyinge.id
    }

