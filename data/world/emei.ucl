# Generated from C:/files/git/mud/d/emei/qianfoan.c by LPCConverter
# Zone: emei

    rooms "qianfoan" {
      name = "千佛庵"
      description = "此处是洪椿坪千佛庵。山间小坪坝，四面层峦叠障，峰环 岭护；两侧深谷幽岚，溪涧玲叮。坪上古木扶疏，亭亭如盖山 阴沁透，白雾飘游，极为幽静清凉。此处常见雨雾霏霏，林中 迷迷蒙蒙，乃山中雾气所为。正所谓「山行本无雨，空翠湿人 衣」。这就是誉为奇观的「洪椿晓雨」。此处殿美景幽，气象 新异，令人心醉。沿途南上是「九十九道拐」，北下经黑龙江 栈道至清音阁。"
  x = 9
  y = 9
  z = -12
    }

