# Generated from C:/files/git/mud/d/emei/chunyangdian.c by LPCConverter
# Zone: emei

    rooms "chunyangdian" {
      name = "纯阳殿"
      description = "纯阳殿海拔一千余米，四面古木苍翠，幽静宜人。殿前有 一石，叫普贤石，据说普贤菩萨登山时曾坐在这里休息过。在 此可纵观峨嵋诸峰，仰望金顶，悬崖峭壁，离天咫尺。这里西 上至神水庵，东下是归云阁。"
  x = 13
  y = 10
  z = -16
    }

  room_exits "chunyangdian" {
    room_id = rooms.chunyangdian.id
    westup = rooms.shenshuian.id
    eastdown = rooms.guiyunge.id
    }

# Generated from C:/files/git/mud/d/emei/chuwujian.c by LPCConverter
# Zone: emei

    rooms "chuwujian" {
      name = "储物间"
      description = "这里便是峨嵋华藏庵的储物间，四周都是架子。一个架上 放满了各样兵器，有长剑，拂尘，长鞭等，琳琅满目。另一个 架上放了各种防具。还有一个架上摆了许多小柜子，原来是装 满药品的药柜。一位师太负责管理这里的物品，正忙碌着整理 防具。后面好象有个小楼梯。门外就是斋堂了。"
  x = 1
  y = -3
  z = 0
    }

  room_exits "chuwujian" {
    room_id = rooms.chuwujian.id
    north = rooms.hcazhaitang.id
    up = rooms.cangjingge.id
    }




