      description = "这里是一个天然形成的石洞，里面深邃广大。洞顶悬挂着许多钟 乳石，不时传来几声滴答的水声。走在洞中，洞内阴暗潮湿，身旁忽 然传来一阵“咝咝”的声音。"
  x = -4
  y = -2
  z = -1
