# Zone: wudu

    rooms "huating2" {
      name = "栖凤亭"
      description = "这里是一个花园中的小亭子，雕梁画栋，古色古香。亭子 当中立着座青铜香炉(lu)，炉中正冒着许许清烟，也不知是燃 着什么东西，烟味颇为刺鼻。"
  x = 3
  y = 0
  z = 0
item_desc = {
 lu = "这是一座青铜香炉，模样颇为古旧，香炉周围似乎有移动过的痕迹。"
