# Zone: wudu

    rooms "caoping" {
      name = "卧龙岗上"
      description = "山顶上有一大片开阔地，蓝蓝的天上飘着几朵白云，脚下是绿油 油的草地，浅浅的刚好可以盖过脚面，散发着一种诱人的芳香舒服的 人直想躺在上面打滚。前面有几间简陋的竹舍。"
  x = 2
  y = -3
  z = 4
    }

