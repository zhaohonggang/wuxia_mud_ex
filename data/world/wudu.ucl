zones "wudu" {
  name = "wudu"
}

# Generated from C:/files/git/mud/d/wudu/baidu1.c by LPCConverter
# Zone: wudu

    rooms "baidu1" {
      name = "百毒窟外"
      description = "这里是五毒教饲养毒物的地方，山壁旁有一个天然的石洞，里面 黑漆漆的看不清楚。一阵山风吹来，你闻到一股腥味。洞口有几个五 毒教弟子正在闲聊。"
  x = -4
  y = -1
  z = -1
valid_leave = [
{
   condition = "((string)me->query('family/family_name') != '五毒教' & objectp(present('jiao tu',environment(me)))) && dir == 'south'"
direction = ~
  message = "五毒教徒忽然挡住你，厉声喝道：这位鬼头鬼脑的想干什么？"
}

]
    }

  room_exits "baidu1" {
    room_id = rooms.baidu1.id
    north = rooms.wdsl4.id
    south = rooms.baidu2.id
    }


  room_characters "baidu1" {
    room_id = rooms.baidu1.id
    characters = [
      { id = characters.jiaotu.id },
      { id = characters.jiaotu.id },
      { id = characters.jiaotu.id },
      { id = characters.jiaotu.id }    ]
  }

