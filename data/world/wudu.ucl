    characters "cunzhang" {
      name = "苗三斤"
      aliases = ["miao sanjin", "miao"]
      description = "这是本村的村长，凡是村里各家各户，老老少少的事他没有不知道的。"
  gender = "男性"
  age = 58
  shen_type = 1

  combat = {
    attitude = "peaceful"
    combat_exp = 800
    con = 20
    dex = 20
    int = 20
    max_qi = 300
    str = 20
  }

  inquiries = [
    { key = "here" value = "此乃桃花村也。" },
    { key = "name" value = "我是苗三斤．因为村里我酒量最大，所以大家选我当了村长。" },
    { key = "桃花峪" value = "你问桃花峪啊，那可是个鬼地方，据说山谷里有瘴气，进去的人都死了。" }
  ]

  chat_chance = 10
chats = [
    "村长叹道：翠兰的爹爹到现在还没回来，会不会出事啊。",
    "村长自言自语道：天天到那种地方去，早晚要出事的。"
]


  carry = [
    { id = items.cloth.id },
    { id = items.hanyan.id }
  ]

    }

