zones "taishan" {
  name = "taishan"
}

# Generated from C:/files/git/mud/d/taishan/baihe.c by LPCConverter
# Zone: taishan

    rooms "baihe" {
      name = "白鹤泉"
      description = "相传从前这里有一个白鹤泉，它的水清凉甘甜，为泰山之最。 这泉水长年涌流不断，喷出的水象仙鹤扑扇着翅膀洗澡一样，因以 为名。可惜后来有一个自私自利的小官，独霸了泉水，后来更因迷 信风水之说，把泉眼堵塞，白鹤泉从此便干涸了。现在只剩下一座 刻着「白鹤泉」三字的石坊以为纪念。从这里继续北上，便是上山 之路。"
  x = -1
  y = -8
  z = -9
    }

  room_exits "baihe" {
    room_id = rooms.baihe.id
    southdown = rooms.daizong.id
    northup = rooms.yitian.id
    }

# Generated from C:/files/git/mud/d/taishan/baozang.c by LPCConverter
# Zone: taishan

    rooms "baozang" {
      name = "宝藏岭"
      description = "这里是泰山的一个名胜。岭上有一座状似狮子的巨石，称为狮 子崖。最出名的还是要数在东北面的东岳庙，也称上岳庙，是古代 封禅的地方，那里有一块唐玄宗的纪泰山铭。"
  x = 4
  y = 0
  z = 1
    }

  room_exits "baozang" {
    room_id = rooms.baozang.id
    westup = rooms.bixia.id
    }

# Generated from C:/files/git/mud/d/taishan/beitian.c by LPCConverter
# Zone: taishan

    rooms "beitian" {
      name = "北天门"
      description = "这里位于石马山的北麓，是岱顶的北面出口，路口有一石坊， 上面写着「玄武」二字。"
  x = -1
  y = 2
  z = 2
    }

  room_exits "beitian" {
    room_id = rooms.beitian.id
    southdown = rooms.zhangren.id
    }

# Generated from C:/files/git/mud/d/taishan/bixia.c by LPCConverter
# Zone: taishan

    rooms "bixia" {
      name = "碧霞祠"
      description = "这是一座历史悠久而宏伟壮丽的祠院。相传建于唐代以前，宋 、元、明、清各代均曾增建。祠院设有东西两殿，分别称为东西宝 库，储存着进香客的捐施，两殿的屋瓦都是由铁铸成。从四方八面 来泰山上香的男女，都是先到碧霞祠，然后才到其他的庙宇。从这 里往东南走便可到达宝藏岭。"
  x = 3
  y = 0
  z = 2
    }

  room_exits "bixia" {
    room_id = rooms.bixia.id
    eastdown = rooms.baozang.id
    west = rooms.weipin.id
    }

# Generated from C:/files/git/mud/d/taishan/daizong.c by LPCConverter
# Zone: taishan

    rooms "daizong" {
      name = "岱宗坊"
      description = "位于泰安县城以北约一里，此处是登泰山的入口。相传当年碧 霞元君被姜子牙戏弄，诱她投掷绣花鞋以定泰山地界，结果碧霞元 君只能把绣花鞋从山顶掷到此处。从此泰山便以此为起点。"
  x = -1
  y = -9
  z = -10
    }

  room_exits "daizong" {
    room_id = rooms.daizong.id
    west = huanghe.rooms.huanghe5.id
    south = rooms.taishanjiao.id
    northup = rooms.baihe.id
    }

# Generated from C:/files/git/mud/d/taishan/dongtian.c by LPCConverter
# Zone: taishan

    rooms "dongtian" {
      name = "东天门"
      description = "这里是岱顶的东面出口。往东依次经过伏虎门峡口、鹰愁涧等， 便可下山。"
  x = 3
  y = 1
  z = 1
    }

  room_exits "dongtian" {
    room_id = rooms.dongtian.id
    west = rooms.tanhai.id
    }

# Generated from C:/files/git/mud/d/taishan/doumo.c by LPCConverter
# Zone: taishan

    rooms "doumo" {
      name = "斗母宫"
      description = "上了一段山路，游人一般都会在这里稍为休息。这里的地势已 经比泰山邻近的徂徕山为高，从这里往东北走便是石经峪。"
  x = -1
  y = -6
  z = -7
    }

  room_exits "doumo" {
    room_id = rooms.doumo.id
    southdown = rooms.yitian.id
    eastup = rooms.shijin.id
    }


  room_characters "doumo" {
    room_id = rooms.doumo.id
    characters = [
      { id = characters.jian_ke.id }    ]
  }

# Generated from C:/files/git/mud/d/taishan/ertian.c by LPCConverter
# Zone: taishan

    rooms "ertian" {
      name = "二天门"
      description = "这里又叫「中天门」。一般的登山者来到这里都已累极，但是 这里才是泰山的一半啊！面对前面险峻的十八盘，很多人都不禁犹 豫起来。"
  x = 0
  y = -4
  z = -4
    }

  room_exits "ertian" {
    room_id = rooms.ertian.id
    southdown = rooms.huima.id
    northup = rooms.wudafu.id
    }


