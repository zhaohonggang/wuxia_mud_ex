  }

# Generated from C:/files/git/mud/d/taishan/fengchan.c by LPCConverter
# Zone: taishan

    rooms "fengchan" {
      name = "封禅台"
      description = "如今这里是推选天下武林总盟主之处，各路英雄如能技压群雄， 比武夺魁，便能问鼎盟主宝座，成为统领中原武林的领袖。高台上 摆放着汉白玉宝座，盟主便在此坐堂议事。台上高高立着一竿旗， 上书：替天行道 四个大字。 盟主左右各侍立着两位白衣武士，两 边都放着一长排虎皮交椅，时常有武林前辈高手前来参见盟主。"
  x = 0
  y = 1
  z = 2
    }

  room_exits "fengchan" {
    room_id = rooms.fengchan.id
    down = rooms.yuhuang.id
    }


  room_characters "fengchan" {
    room_id = rooms.fengchan.id
    characters = [
      { id = characters.wei_shi1.id },
      { id = characters.wei_shi1.id },
      { id = characters.wei_shi1.id },
      { id = characters.wei_shi1.id }    ]
  }

# Generated from C:/files/git/mud/d/taishan/huima.c by LPCConverter
# Zone: taishan

    rooms "huima" {
      name = "回马岭"
      description = "此处又名天关，到了这里，马匹已不能再前进。据说当年唐玄 宗上泰山封禅，来到这里，因陡峭难攀，累死了白马，要改乘小轿 上山。"
  x = 0
  y = -5
  z = -5
    }

  room_exits "huima" {
    room_id = rooms.huima.id
    southdown = rooms.shijin.id
    northup = rooms.ertian.id
    }


