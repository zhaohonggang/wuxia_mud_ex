      { id = characters.tiao_fu.id },
      { id = characters.jian_ke.id }    ]
  }

# Generated from C:/files/git/mud/d/taishan/kedian.c by LPCConverter
# Zone: taishan

    rooms "kedian" {
      name = "客栈"
      description = "这是一家在泰山山脚一的一个小客栈，由于泰山游人如织，因此这 里生意非常兴隆。外地游客多选择在这里落脚，你可以在这里打听到各 地的风土人情。店小二里里外外忙得团团转，接待着南腔北调的客人。 墙上挂着一个牌子(paizi)。"
  x = 0
  y = -10
  z = -10
item_desc = {
 paizi = "楼上雅房，每夜五两白银。"
}
valid_leave = [
{
   condition = "!me->query_temp('rent_paid') && dir == 'up'"
direction = "up"
  message = "店小二一下挡在楼梯前，白眼一翻：怎麽着，想白住啊！"
}
,
{
   condition = "me->query_temp('rent_paid') && dir == 'west'"
direction = "west"
  message = "店小二跑到门边拦住：客官已经付了银子，怎麽不住店就走了呢！ 旁人还以为小店伺候不周呢！"
}

]
    }

  room_exits "kedian" {
    room_id = rooms.kedian.id
    up = rooms.kedian2.id
    west = rooms.taishanjiao.id
    }


  room_characters "kedian" {
    room_id = rooms.kedian.id
    characters = [
      { id = characters.xiaoer.id }    ]
  }

# Generated from C:/files/git/mud/d/taishan/kedian2.c by LPCConverter
# Zone: taishan

    rooms "kedian2" {
      name = "客店二楼"
      description = "这是一间很大的客房，陈设十分简陋。靠墙放了十几张小木床， 不少客人正和衣而卧，满屋子都是呼呼的打酣声。西边有张床是空的， 你蹑手蹑脚地走了过去。"
  x = 0
  y = -10
  z = -9
    }

  room_exits "kedian2" {
    room_id = rooms.kedian2.id
    down = rooms.kedian.id
    }

# Generated from C:/files/git/mud/d/taishan/lianhua.c by LPCConverter
# Zone: taishan

    rooms "lianhua" {
      name = "莲花峰"
      description = "莲花峰其实是由五座山峰攒簇而成，状如莲花，因以为名。东 面有危崖万仞，叫五花崖。登上莲花峰后，可看到在盘道中的游人 如小蚁般往来穿梭，故此莲花峰又叫望人峰。往上走便是莲花峰的 峰顶。"
  x = 2
  y = 0
  z = 0
    }

  room_exits "lianhua" {
    room_id = rooms.lianhua.id
    northup = rooms.shixin.id
    westup = rooms.tianjie.id
    }

