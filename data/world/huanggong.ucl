# Generated from C:/files/git/mud/d/huanggong/zoulang1.c by LPCConverter
# Zone: huanggong

    rooms "zoulang1" {
      name = "走廊"
      description = "这是一条走廊。房顶一侧支在西面的高墙上，另一侧则与东 侧的清和殿屋顶相连。彩梁画栋，连顶棚也用彩漆绘满了各种飞 天的图形，每幅精美的雕画似乎都在诉说一个娓娓动人的故事。 往西通往后院，南北都有房间。"
  x = -1
  y = 0
  z = 0
    }

