    rooms "shanfang" {
      name = "御膳房"
      description = "皇宫里的膳食与平常民间的自然不同,这里就是负责皇上用膳的御 膳房.你不禁想把这里的美味都尝一遍,可别忘了这可是皇宫啊."
  x = 1
