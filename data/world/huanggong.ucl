# Generated from C:/files/git/mud/d/huanggong/shufang.c by LPCConverter
# Zone: huanggong

    rooms "shufang" {
      name = "御书房"
      description = "皇上用功读书的御书房.四下齐整地排着几排书架,看来都是些名典 巨著,你暗自道,原来皇上也读这么多书啊.书房正中有张精雕的檀香木 桌(desk),桌上摆着几本封面精美的帛书."
  x = 1
  y = 1
  z = 0
item_desc = {
 desk = "一张制作精良的檀香木书桌."
}
    }

