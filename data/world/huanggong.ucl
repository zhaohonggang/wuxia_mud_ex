    room_id = rooms.shufang.id
    south = rooms.tinglang1.id
    }

# Generated from C:/files/git/mud/d/huanggong/tinglang1.c by LPCConverter
# Zone: huanggong

    rooms "tinglang1" {
      name = "厅廊"
      description = "飞檐雕栏的厅廊.两边是喜人的花草,站在这儿,隐约听得到后宫里 嫔妃宫女们嬉笑的声音,宫里的人来来往往的,显得井井有条,看来宫里 的规矩挺严的.有几个官员神情紧张地站在这儿,等着皇上召见."
  x = 1
  y = 0
  z = 0
    }

  room_exits "tinglang1" {
    room_id = rooms.tinglang1.id
    south = rooms.tinglang2.id
    north = rooms.shufang.id
    }

