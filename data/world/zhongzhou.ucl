 paizi = "######################         ##                  ##         ##     公平交易     ##         ##                  ##         ##  存钱： deposit  ##         ##                  ##         ##  取钱： withdraw ##         ##                  ##         ##  兑换： convert  ##         ##                  ##         ##  查帐： check    ##         ##                  ##         ##                  ##         ######################"
}
    }

