# Generated from C:/files/git/mud/d/foshan/pm_restroom.c by LPCConverter
# Zone: foshan

    rooms "pm_restroom" {
      name = "英雄会馆"
      description = "英雄会馆也是凤老爷的家业。常来这里的人，都是有能耐 有来头的。英雄会馆里围着黑压压的一群人，南方有一扇紧紧 关闭的小门。只有在每月一次的店铺拍卖时「南霸天」凤天南 才会将它打开，在那里会见各处的商贾。小门旁挂着的一块红 木牌子(paizi)上标写着各家店铺拍卖的底价。"
  x = -2
  y = -1
  z = 0
valid_leave = [
{
   condition = "(me->query('balance') < 5000000 || me->query('weiwang') < 3000) && dir == 'south' && ! wizardp(me)"
direction = "south"
  message = "凤一鸣拦住你，冷笑道：以阁下的财产和地位，尚不足以进去。"
}

]
    }

  room_exits "pm_restroom" {
    room_id = rooms.pm_restroom.id
    north = rooms.street2.id
    }


  room_characters "pm_restroom" {
    room_id = rooms.pm_restroom.id
    characters = [
      { id = characters.fengyiming.id }    ]
  }

# Generated from C:/files/git/mud/d/foshan/pmc.c by LPCConverter
# Zone: foshan

    rooms "pmc" {
      name = "英雄会馆后厅"
      description = "英雄会馆乃是佛山大豪「南霸天」凤天南的家业。常来这 里的人，都是有能耐有来头的。现在英雄会馆里正围着黑压压 的一大群人，都是来自各地的知名商贾。凤天南座于中堂，犀 利的目光似乎要把你刺透一般。西墙挂着的牌子 (paizi)上面 写着此次拍卖大会的规则，一定要好好看看。"
  x = 0
  y = 0
  z = 1
    }

  room_exits "pmc" {
    room_id = rooms.pmc.id
    down = rooms.street4.id
    north = rooms.pm_restroom.id
    }

