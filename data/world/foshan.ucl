zones "foshan" {
  name = "foshan"
}

# Generated from C:/files/git/mud/d/foshan/beidimiao.c by LPCConverter
# Zone: foshan

    rooms "beidimiao" {
      name = "北帝庙"
      description = "北帝庙坐北朝南。院子中一个大水塘，塘中石龟石蛇，昂 然盘踞。大殿神像石板上血迹殷然。北帝神像立于大殿的正中。"
  x = -3
  y = 1
  z = 0
    }

  room_exits "beidimiao" {
    room_id = rooms.beidimiao.id
    south = rooms.street1.id
    }

# Generated from C:/files/git/mud/d/foshan/dangpu.c by LPCConverter
# Zone: foshan

    rooms "dangpu" {
      name = "英雄典当"
      description = "当铺里一张高高的柜台，柜台后面坐着当铺的朝奉。这家 当铺是凤老爷所开，十多年来从没人来闹过事，朝奉也就很放 心。柜台上挂着一个木牌子(paizi)。"
  x = 1
  y = -1
  z = 0
item_desc = {
 paizi = "##==================##         ##                  ##         ##     公平交易     ##         ##                  ##         ##  卖出：   sell   ##         ##                  ##         ##  买进：   buy    ##         ##                  ##         ##  估价：   value  ##         ##                  ##         ##                  ##         ##==================##"
}
    }

  room_exits "dangpu" {
    room_id = rooms.dangpu.id
    north = rooms.street5.id
    }


  room_characters "dangpu" {
    room_id = rooms.dangpu.id
    characters = [
      { id = characters.chaofeng.id }    ]
  }

# Generated from C:/files/git/mud/d/foshan/eastgate.c by LPCConverter
# Zone: foshan

    rooms "eastgate" {
      name = "东门"
      description = "这里是佛山镇的东门。再往东走，不久就要离开佛山去往 福建了。西面一条东西向的大街是佛山镇的主要街道。"
  x = 2
  y = 0
  z = 0
    }

  room_exits "eastgate" {
    room_id = rooms.eastgate.id
    west = rooms.street5.id
    east = rooms.road8.id
    }

# Generated from C:/files/git/mud/d/foshan/majiu.c by LPCConverter
# Zone: foshan

    rooms "majiu" {
      name = "马厩"
      description = "这里是佛山镇的马厩，常年供应新鲜草料。佛山民风淳朴 马夫们会把马牵到马厩好生照看，将它们喂饱饮足，再洗刷得 干乾净净，一直伺候到客人上路。马厩雨檐下的烂木柱上钉着 一块破木牌(paizi)。马厩中堆放著几堆草料。"
  x = 0
  y = -2
  z = 0
    }

  room_exits "majiu" {
    room_id = rooms.majiu.id
    north = rooms.yingxionglou.id
    up = rooms.foshan_shop.id
    }


  room_characters "majiu" {
    room_id = rooms.majiu.id
    characters = [{ id = characters.mafu.id }, { id = characters.zaohongma.id }, { id = characters.huangbiaoma.id }, { id = characters.ziliuma.id }]
  }



  room_items "majiu" {
    room_id = rooms.majiu.id
    items = []
  }

# Generated from C:/files/git/mud/d/foshan/nanling.c by LPCConverter
# Zone: foshan

    rooms "nanling" {
      name = "南岭山口"
      description = "这里是南岭的一个山口。南面就是佛山了，北面是横亘湖 南广东的五岭。这里地气非常炎热，百物速生快长，口音也渐 渐远异中原了。"
  x = -1
  y = 2
  z = 0
    }

  room_exits "nanling" {
    room_id = rooms.nanling.id
    south = rooms.northgate.id
    northup = hengyang.rooms.hsroad9.id
    }

# Generated from C:/files/git/mud/d/foshan/northgate.c by LPCConverter
# Zone: foshan

    rooms "northgate" {
      name = "北门"
      description = "这里是佛山镇的北门。出北门再向北，翻过南岭可达中原。 南面一条东西向的大街是佛山镇的主要街道。"
  x = -1
  y = 1
  z = 0
    }

  room_exits "northgate" {
    room_id = rooms.northgate.id
    north = rooms.nanling.id
