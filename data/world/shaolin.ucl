# Zone: shaolin

    rooms "banruo1" {
      name = "般若堂一部"
      description = "这是一间极为简陋的禅房。环视四周，除了几幅佛竭外，室 内空荡荡地别无他物。地上整齐的摆放着几个破烂且发黑的黄布 蒲团，几位须发花白的老僧正在坐在上面闭目入定。这里是本寺 十八罗汉参禅修行的地方，不少绝世武功便是在此悟出。"
  x = -2
  y = 4
  z = 0
    }

  room_exits "banruo1" {
    room_id = rooms.banruo1.id
    north = rooms.banruo2.id
    south = rooms.zoulang1.id
    }




