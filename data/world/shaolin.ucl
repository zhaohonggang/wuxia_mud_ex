# Generated from C:/files/git/mud/d/shaolin/beilin3.c by LPCConverter
# Zone: shaolin

    rooms "beilin3" {
      name = "地下室"
      description = "这里是佛塔底下的地下密室。密室虽小，却也五脏俱全，石 桌石椅，石几石床，连室内放的几件器皿，也都是石制的。看来 似乎很久以前有人在这里住过。正中的石桌 (table)上平放着一 块薄薄的石板，上面好象刻着些什么。"
  x = 0
  y = 0
  z = 12
item_desc = {
 table = "这是一整块巨石雕成的石桌，上面刻了些奇怪的图形。"
}
    }

  room_exits "beilin3" {
    room_id = rooms.beilin3.id
    down = rooms.bagua7.id
    up = rooms.beilin2.id
    }




