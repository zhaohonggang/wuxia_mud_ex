      description = "面前是一条波涛翻滚的大江 (river)。浊流滚滚，万舟竞 发。两岸渡船来来往往，江边一长溜摆满了鱼摊，渔家就将船 泊在岸边，几个破萝支一块木板，板上摆满了活蹦乱跳的汉江 鲤鱼。过去不远，是有名的老河口。"
  x = 0
  y = 0
  z = 15
