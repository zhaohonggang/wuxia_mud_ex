    rooms "shijie4" {
      name = "石阶"
      description = "水声越来越大，山间充满了浓浓的水气。石阶上，断裂的山 隙中，都流出一道道细细的泉水，汇成一股澄碧的小溪，向山下 蜿蜒流去。周围绿意荡漾，鸟语鹦声，如置身仙境。"
  x = 0
