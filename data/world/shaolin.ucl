# Generated from C:/files/git/mud/d/shaolin/andao3.c by LPCConverter
# Zone: shaolin

    rooms "andao3" {
      name = "暗道"
      description = "这是一个阴暗潮湿的地道，四壁用粗糙的片岩垒垛而成，一 颗颗水珠沿着墙壁滚下来，溅在地上。也许是因为长时间无人通 行的缘故，整个地道弥漫着一股腐尸般的恶臭。"
  x = 0
  y = 0
  z = 3
valid_leave = [
{
  direction = ~
  message = "你试着推了推顶上的砖盖，触手冰凉，纹丝不动。 看来已被铁汁浇透，坚如铁板一般。看来你只能另想办法了。"
}

]
    }

  room_exits "andao3" {
    room_id = rooms.andao3.id
    down = rooms.gulou7.id
    up = rooms.zhonglou1.id
    in = rooms.bagua0.id
    }

# Generated from C:/files/git/mud/d/shaolin/bagua.c by LPCConverter
# Zone: shaolin

    rooms "bagua" {
      name = "八卦阵阵心"
      description = "这里就是洪荒古阵的中心。站在这里，才能看清楚四周 的情形，只见周围暮蔼沉沉，云气弥漫，不见边际。一道道 闪电如奔蛇般穿梭其间，发出阵阵闷雷。间夹着几声惨厉的 哭叫声，与雷电着地的劈裂声混合在一起，整个场面说不出 的诡异可惧。阵心正中处有一口深潭(tan)，望之深不见底。"
  x = 0
  y = 0
  z = 4
item_desc = {
 tan = "深潭边的岩石上刻着四个巨大的古篆：“万古寒潭”， 再有五个小字：“苍松子谨书”。 潭边都是极硬的玄武岩， 潭水澄碧透明，鱼虾不生。水面隐隐泛着一股幽幽的深绿色， 走近便觉一股彻骨寒气扑面而来。  粗看似乎只有几十丈深， 仔细望下去却是越看越深，直如无底深渊一般！"
}
    }

  room_exits "bagua" {
    room_id = rooms.bagua.id
    down = rooms.zhonglou7.id
    up = rooms.andao3.id
    }

# Generated from C:/files/git/mud/d/shaolin/bagua0.c by LPCConverter
# Zone: shaolin

    rooms "bagua0" {
      name = "八卦阵"
      description = "这是便是八卦阵，四壁全由粗糙的片岩垒垛而成。巨石 狰狞，缺口及合缝处犬牙交错，如洪荒怪兽，其势似欲择人 而噬。壁上刻着一行小篆：“八卦通天地，金刚泣鬼神”。 四周灰尘厚积，蛛网密布，看来已久无人行。地上似乎躺着 几具尸体，早已腐烂化灰，脚步经过，连尸首身上的衣物也 随风飘散。"
  x = 0
  y = 0
  z = 3
valid_leave = [
{
   # 阻挡条件（原样保留）：check_dirs(me, dir)
direction = ~
  message = "你踩动了机关，掉进僧监。"
}

]
    }
  room_exits "bagua0" {
    room_id = rooms.bagua0.id
    }

