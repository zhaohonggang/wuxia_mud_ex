    rooms "hantan1" {
      name = "万古寒潭"
      description = "这是寒潭之中。四周水声哗哗，似乎有一股暗流在极力牵扯 着你往下沉。透过潭水隐约可见潭周的岩壁，被数万年水流冲激 磨削得十分光滑。虽然口中含了辟水珠，身上却仍然感觉到丝丝 寒意侵入肌肤，而且越是往下，水底的吸力越强，寒意更甚。"
  x = 0
  y = 0
  z = 18
    }
