    rooms "shijie3" {
      name = "石阶"
      description = "石级到这里似乎变得宽阔了些。清新的山风扑面而来，令人 精神顿为一爽。远处传来淙淙水声，渐行渐远。山壁上挂满 了厚密的藤萝，随风轻轻摇弋。"
  x = 1
  y = 0
