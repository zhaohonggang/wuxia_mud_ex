# Generated from C:/files/git/mud/d/shaolin/gulou.c by LPCConverter
# Zone: shaolin

    rooms "gulou" {
      name = "鼓楼小院"
      description = "这是一座砖木结构的宝塔，塔高七层，塔身作八角形，飞檐 翘翎，檐角上挂满了一串串小铜铃，随风叮叮作响。塔身墙上镂 空雕绘着无数佛陀们的坐像。一个个形态维肖，看来出自名匠之 手。塔底入口处开了一扇拱形的小木门，门扇两侧用彩漆涂绘， 画的是释祖在灵山对诸天众佛讲经时的情形。"
  x = -1
  y = 0
  z = 0
    }

  room_exits "gulou" {
    room_id = rooms.gulou.id
    in = rooms.gulou1.id
    east = rooms.guangchang2.id
    }


  room_characters "gulou" {
    room_id = rooms.gulou.id
    characters = [
      { id = characters.seng_bing3.id },
      { id = characters.seng_bing3.id }    ]
  }

# Generated from C:/files/git/mud/d/shaolin/gulou1.c by LPCConverter
# Zone: shaolin

    rooms "gulou1" {
      name = "鼓楼一层"
      description = "这里是塔楼的底层，一缕缕阳光从墙上的花砖缝隙里透射 进来，在青砖地上投下别致的光影，如同一格格棋盘相似。往 上看，长长的木楼梯盘绕而上，似乎永无尽头。墙角，梯级都 相当洁净，看来经常有僧人打扫。"
  x = -1
  y = 0
  z = 0
    }

  room_exits "gulou1" {
    room_id = rooms.gulou1.id
    out = rooms.gulou.id
    up = rooms.gulou2.id
    }


  room_characters "gulou1" {
    room_id = rooms.gulou1.id
    characters = [
      { id = characters.saodi_seng.id }    ]
  }

# Generated from C:/files/git/mud/d/shaolin/gulou2.c by LPCConverter
# Zone: shaolin

    rooms "gulou2" {
      name = "鼓楼二层"
      description = "每个楼层上都铺设了结实的木楼板，八角形的墙身上则开 了四扇大窗。从窗孔看，墙体也是极为厚实。从这里往外眺望， 可以看到围绕塔周的小园以及北边的竹林，随风飘来阵阵竹叶 的清香。"
  x = -1
  y = 0
  z = 1
    }

  room_exits "gulou2" {
    room_id = rooms.gulou2.id
    down = rooms.gulou1.id
    up = rooms.gulou3.id
    }

# Generated from C:/files/git/mud/d/shaolin/gulou3.c by LPCConverter
# Zone: shaolin

    rooms "gulou3" {
      name = "鼓楼三层"
      description = "塔身往上似乎越来越窄，楼梯也渐为挤仄。扶手上不少朽 坏处续接了新木，漆色也是新旧不同。从窗孔往外望，往北可 以看到竹林中的藏经楼和方丈楼露出飞檐一角，往西则是后殿 的屋顶，屋脊上塑了个大大的“佛”字。"
  x = -1
  y = 0
  z = 2
    }

  room_exits "gulou3" {
    room_id = rooms.gulou3.id
    down = rooms.gulou2.id
    up = rooms.gulou4.id
    }

# Generated from C:/files/git/mud/d/shaolin/gulou4.c by LPCConverter
# Zone: shaolin

    rooms "gulou4" {
      name = "鼓楼四层"
      description = "到这里楼梯大概只能容一人上下，墙身也略薄了些。视线 越过窗棂，南边的练武场，罗汉堂，般若堂历历在目，不少僧 人正汇集在练武场上习武，吆喝声一阵阵传进耳鼓。北边的藏 经楼，方丈楼也尽露全貌。"
  x = -1
  y = 0
  z = 3
    }

  room_exits "gulou4" {
    room_id = rooms.gulou4.id
    down = rooms.gulou3.id
    up = rooms.gulou5.id
    }

# Generated from C:/files/git/mud/d/shaolin/gulou5.c by LPCConverter
# Zone: shaolin

    rooms "gulou5" {
      name = "鼓楼五层"
      description = "一眼望去，只见蓝天白云，青山列列，令人将尘俗之气， 顿为一一扫。南至前三殿，北到方丈楼，整个少林寺尽在眼底。 北面竹林随风起伏，犹如一片竹海。东西面围绕全寺的是密密 匝匝的松林，一眼往不到边。"
  x = -1
  y = 0
  z = 4
    }

  room_exits "gulou5" {
    room_id = rooms.gulou5.id
    down = rooms.gulou4.id
    up = rooms.gulou6.id
    }

# Generated from C:/files/git/mud/d/shaolin/gulou6.c by LPCConverter
# Zone: shaolin

    rooms "gulou6" {
      name = "鼓楼六层"
      description = "沿窗洞吹进一阵阵凌厉的山风，寒意浸人。北望可见松林的 尽头，少室山的顶峰处，有一片小小的平地，正中植着三棵巨松； 中间又似乎有什么东西正闪闪发光。楼上传来一阵阵沉闷的鼓声。"
  x = -1
  y = 0
  z = 5
    }

  room_exits "gulou6" {
    room_id = rooms.gulou6.id
    down = rooms.gulou5.id
    up = rooms.gulou7.id
    }

# Generated from C:/files/git/mud/d/shaolin/gulou7.c by LPCConverter
# Zone: shaolin

    rooms "gulou7" {
      name = "鼓楼七层"
      description = "这里就是鼓楼之顶。直入眼帘的便是一只大鼓。大鼓鼓身通红， 似由白杨木箍成。两头包以水牛皮，用一匝大铜钉钉在鼓身边缘。 鼓心有一圈白渍，看来是因为多次击打形成的。整个大鼓放在一 个一人高的架子上，架子底层搁着两根大鼓槌。尽管山风吹人欲 倒，谁都禁不住想击一下鼓(drum)试试。往外看，有个很大的汉 白玉窗台(out)，上面足可站一个人。"
  x = -1
  y = 0
  z = 6
    }

