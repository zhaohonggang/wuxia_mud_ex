    rooms "shijie2" {
      name = "石阶"
      description = "长长的石阶往上依然看不到尽头。身边的山壁受着长年风雨 的浸润，长出了薄薄的青苔。上面依稀有些刻凿的痕迹。有一行 字特别清晰：“金刚伏邪魔，宝塔镇群妖”"
  x = 1
  y = -1
