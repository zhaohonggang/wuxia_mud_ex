    room_id = rooms.beilin3.id
    items = [
      { id = items.book_stone.id }    ]
  }

# Generated from C:/files/git/mud/d/shaolin/bydian.c by LPCConverter
# Zone: shaolin

    rooms "bydian" {
      name = "白衣殿"
      description = "这是白衣殿，供奉白衣观音大士。大士高居须弥座上，手托 净瓶，眉含微愁，唇绽浅笑，仿佛对人间疾苦既存忧心，又觉释 怀。殿中放了红木大香案，香案上供品齐备，香火十分旺盛。"
  x = 1
  y = 7
  z = 0
    }

  room_exits "bydian" {
    room_id = rooms.bydian.id
    west = rooms.guangchang5.id
    }

# Generated from C:/files/git/mud/d/shaolin/chufang.c by LPCConverter
# Zone: shaolin

    rooms "chufang" {
      name = "厨房"
      description = "炊烟缭绕，蒸汽腾腾，香味扑鼻而来。靠墙是一排数丈长的 灶台，支着十来口大锅，最大的一口饭锅上方竟有人从梁上悬空 而下，手持木棍在搅拌。除了烧饭的僧人外，几位火工头陀忙着 劈柴运薪，灶下炉火熊熊。一位中年僧人正来回催促着。"
  x = -1
  y = 3
  z = 0
    }

  room_exits "chufang" {
    room_id = rooms.chufang.id
    south = rooms.fanting1.id
    }


  room_characters "chufang" {
    room_id = rooms.chufang.id
    characters = [
      { id = characters.shaofan_seng.id },
      { id = characters.shaofan_seng.id }    ]
  }

# Generated from C:/files/git/mud/d/shaolin/chufang2.c by LPCConverter
# Zone: shaolin

    rooms "chufang2" {
      name = "厨房"
      description = "这里是一间厨房。厨房很大，可能也是因为兼作仓库的缘 故。灶头砌在北首，一根大烟囱直通出屋顶。房子四壁被常年 烟火熏得发黑，连房梁也是焦黑焦黑。墙角堆满了柴火，另一 边放了些晒干的辣椒，稻谷等。东边的墙灰剥落了一块，露出 犬牙交错的砖缝来。屋角边有个大洞。"
  x = 0
  y = 0
  z = 13
    }

  room_exits "chufang2" {
    room_id = rooms.chufang2.id
    up = rooms.duchuan.id
    down = rooms.beilin2.id
    southwest = rooms.houshan.id
    }

# Generated from C:/files/git/mud/d/shaolin/cjlou.c by LPCConverter
# Zone: shaolin

    rooms "cjlou" {
      name = "藏经阁一楼"
      description = "不愧为中原佛法的总源，少林寺此处藏经之富，天下罕有其 匹。这里都是密密麻麻，高及顶棚的书架，书架间仅有容身一人 通行的空隙。几排大书架中间，间隔地放着数丈长的书桌。目光 及处，你看到桌上放了几本佛经。"
  x = -3
  y = 7
  z = 0
valid_leave = [
{
  direction = "up"
  message = "道一说道: 你未经许可，不能上二楼。"
}

]
    }

  room_exits "cjlou" {
    room_id = rooms.cjlou.id
    up = rooms.cjlou1.id
    east = rooms.zhulin5.id
    }




