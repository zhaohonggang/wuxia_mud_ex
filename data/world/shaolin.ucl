    rooms "houshan" {
      name = "小院"
      description = "你站在最中间的土屋前。土屋似乎是用本地的山岭土夯筑的， 结实而且耐水。屋顶是茅草铺的，角上露出几个被风吹开的破洞。 左边的屋子好象是间猪舍，右边的土屋门边挂着几串晒干的辣椒。 正中间土屋的门是开着的。"
  x = -1
  y = -1
  z = 13
