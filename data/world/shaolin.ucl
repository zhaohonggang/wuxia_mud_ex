    rooms "smdian" {
      name = "山门殿"
      description = "这里便是少林寺的前殿山门殿了。只见殿内青砖铺地，两侧 分列哼、哈二将。身躯雄伟，面相忿怒，头带宝冠，上半身裸露， 手执金刚杵，一鼓鼻，一张口，露牙睁目，凶猛可畏。两边各放 一红木供桌，陈列香烛，以供僧俗叩拜。自此的左右各有一间偏 殿，供比丘们打坐诵经之用。南面是一道三丈来高的朱红杉木包 铜大门(gate)。"
  x = 0
  y = -3
  z = -1
    }

  room_exits "smdian" {
    room_id = rooms.smdian.id
    north = rooms.taijie.id
    west = rooms.smdian2.id
    east = rooms.smdian1.id
    }


  room_characters "smdian" {
    room_id = rooms.smdian.id
    characters = [
      { id = characters.seng_bing3.id },
      { id = characters.seng_bing3.id },
      { id = characters.xiang_ke.id }    ]
  }

# Generated from C:/files/git/mud/d/shaolin/smdian1.c by LPCConverter
# Zone: shaolin

    rooms "smdian1" {
      name = "东侧殿"
      description = "这里是东侧殿。房间四周悬挂着达摩祖师、观音大士的画 像，以及一些寺内元老的字画。地下散乱地放着许多蒲团，木 鱼等。看来此处是本派弟子打坐修行之所。几位年轻僧人正肃 容入定，看来已颇得禅宗三昧。"
  x = 1
  y = -3
  z = -1
    }

  room_exits "smdian1" {
    room_id = rooms.smdian1.id
    west = rooms.smdian.id
    }




  room_items "smdian1" {
    room_id = rooms.smdian1.id
    items = [
      { id = items.muchui.id }    ]
  }

