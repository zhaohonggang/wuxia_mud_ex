    rooms "hantan2" {
      name = "万古寒潭"
      description = "这是寒潭之中。从这里已可感觉到深水下的巨大压力，彻骨 冰凉的潭水在身体四周凝成一层薄薄的冰壳，四肢也已开始麻木， 令你感到举手投足都甚为困难。水中的吸力也渐渐加强，你不由 自主地往下沉去。"
  x = 0
  y = 0
  z = 19
    }
  room_exits "hantan2" {
    room_id = rooms.hantan2.id
    down = rooms.hantan1.id
    up = rooms.hantan3.id
    }

