# Zone: shaolin

    rooms "guangchang5" {
      name = "广场"
      description = "这是千佛殿前的一个广场。往北上了台阶就是供奉西天诸佛 的千佛殿。往西是供奉地藏王菩萨的地藏殿，往东是供奉白衣观 音大士的白衣殿。这里每年都有不少香客聚集举办水陆大法会。"
  x = 0
  y = 7
  z = 0
