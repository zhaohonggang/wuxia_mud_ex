    }

# Generated from C:/files/git/mud/d/shaolin/zhonglou4.c by LPCConverter
# Zone: shaolin

    rooms "zhonglou4" {
      name = "钟楼四层"
      description = "到这里楼梯大概只能容一人上下，墙身也略薄了些。视线 越过窗棂，南边的练武场，罗汉堂，般若堂历历在目，不少僧 人正汇集在练武场上习武，吆喝声一阵阵传进耳鼓。北边的藏 经楼，方丈楼也尽露全貌。"
  x = 1
  y = 0
  z = 3
    }

  room_exits "zhonglou4" {
    room_id = rooms.zhonglou4.id
    down = rooms.zhonglou3.id
    up = rooms.zhonglou5.id
    }

# Generated from C:/files/git/mud/d/shaolin/zhonglou5.c by LPCConverter
# Zone: shaolin

    rooms "zhonglou5" {
      name = "钟楼五层"
      description = "一眼望去，只见蓝天白云，青山列列，令人将尘俗之气， 顿为一一扫。南至前三殿，北到方丈楼，整个少林寺尽在眼底。 北面竹林随风起伏，犹如一片竹海。东西面围绕全寺的是密密 匝匝的松林，一眼往不到边。"
  x = 1
  y = 0
  z = 4
    }

  room_exits "zhonglou5" {
    room_id = rooms.zhonglou5.id
    down = rooms.zhonglou4.id
    up = rooms.zhonglou6.id
    }

# Generated from C:/files/git/mud/d/shaolin/zhonglou6.c by LPCConverter
# Zone: shaolin

    rooms "zhonglou6" {
      name = "钟楼六层"
      description = "沿窗洞吹进一阵阵凌厉的山风，寒意浸人。北望可见松林的 尽头，少室山的顶峰处，有一片小小的平地，正中植着三棵巨松； 又似乎有什么东西正闪闪发光。头顶上的楼板开了个大洞，挂下 一口大钟。从这里只能看到巨钟的下边缘，内里黑洞洞的，什么 也看不见。"
  x = 1
  y = 0
  z = 5
    }

