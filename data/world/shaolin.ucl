# Generated from C:/files/git/mud/d/shaolin/zhonglou2.c by LPCConverter
# Zone: shaolin

    rooms "zhonglou2" {
      name = "钟楼二层"
      description = "每个楼层上都铺设了结实的木楼板，八角形的墙身上则开 了四扇大窗。从窗孔看，墙体也是极为厚实。从这里往外眺望， 可以看到围绕塔周的小园以及北边的竹林，随风飘来阵阵竹叶 的清香。"
  x = 1
  y = 0
  z = 1
