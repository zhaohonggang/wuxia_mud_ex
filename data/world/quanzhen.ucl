# Generated from C:/files/git/mud/d/quanzhen/baishulin1.c by LPCConverter
# Zone: quanzhen

    rooms "baishulin1" {
      name = "柏树林"
      description = "绕过翠屏谷的山壁，眼前是一片大柏树林，想是由于山壁 挡住了视线，在山下的山路上根本想不到这里的柏树竟会有这 么密这么高。你踏进柏树林中，阳光全被头顶的树叶遮住，越 往树林深处，光线越是幽暗。"
  x = 0
  y = 0
  z = 1
    }

  room_exits "baishulin1" {
    room_id = rooms.baishulin1.id
    up = rooms.fu_midao.id
    down = rooms.datang1.id
    southdown = rooms.cuipinggu.id
    northup = rooms.baishulin3.id
    east = rooms.baishulin2.id
    }

# Generated from C:/files/git/mud/d/quanzhen/baishulin2.c by LPCConverter
# Zone: quanzhen

    rooms "baishulin2" {
      name = "柏树林"
      description = "你走进了柏树林的深处，脚下踩着厚厚的落叶，松松软软。 这里的光线非常阴暗，你几乎什么都看不清了。突然一只松鼠 从你眼前的树枝上猛地跳了过去，吓了你一跳。"
  x = 1
  y = 0
  z = 1
    }

  room_exits "baishulin2" {
    room_id = rooms.baishulin2.id
    west = rooms.baishulin1.id
    northup = rooms.baishulin4.id
    }

