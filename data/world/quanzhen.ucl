# Generated from C:/files/git/mud/d/quanzhen/baishulin4.c by LPCConverter
# Zone: quanzhen

    rooms "baishulin4" {
      name = "柏树林"
      description = "这里是树林的边缘，光线亮的多了。参天的柏树也稀疏了 很多。旁边有一丛灌木(frutex)杂生。灌木再往前就是悬崖了。"
  x = 1
