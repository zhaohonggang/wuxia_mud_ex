        material = "bamboo"
      }

      # LPC: clone/weapon/zhujian.c   (inherit SWORD)
      #   注意：kungfu/class/lingjiu/zhujian.c 也叫 zhujian，但那是 NPC；
      #   兵械库（bingqiku / bingqifang / liangong / wuqiku）引用的是这把剑。
    }
