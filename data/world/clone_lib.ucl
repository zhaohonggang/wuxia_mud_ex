# LPC: C:/files/git/mud/kungfu/class/shaolin/xingzhe.c
    characters "shaolin_xingzhe" {
      name = "行者"
      aliases = ["shaolin_xingzhe", "xingzhe", "walker"]
      description = "他是一位云游四方的行者，风霜满面，行色匆匆，似乎正在办一件急事。"
  title = "少林刀僧"
  gender = "男性"
  age = 35
  shen_type = 1
  score = 100

  combat = {
    attitude = "heroism"
    combat_exp = 20000
    con = 20
    dex = 25
    int = 20
    max_jing = 100
    max_neili = 500
    max_qi = 500
    str = 25
  }

  chat_chance = 3
chats = [
    "行者说道：据说本寺後山山顶上有一个蕴含无上降魔大法的金刚伏魔圈，内有佛家法宝。",
    "行者说道：易筋经分为修行篇，攻防篇，身法篇与拳术篇四部，百年前便都已散失各处。",
    "行者说道：大金刚拳刚猛狠辣，最厉害的一招名称叫做如来笑，最合佛家超渡世人的本意。",
    "行者说道：本寺十八罗汉大阵威力无比，能破阵出关者可说是凤毛麟角，万里挑一的人才。",
    "行者说道：本寺弟子自上而下，依次是五圣僧，十八罗汉，九尊者，九禅师，九比丘等。",
    "行者说道：戒律院主持是玄痛大师，全寺上下众僧见了他，真是大气也不敢吭一声。",
    "行者说道：少林寺藏经楼藏经之富，天下罕有。佛法经典，武功秘籍，可以说是无所不包。",
    "行者说道：本寺弟子如要习武防身，可到後殿武器库和防具库领取器械，用後归还所司。",
    "行者说道：少林历代有许多高僧在寺内钟楼顶上勤修佛法，七层窗外平台上更是禅定妙处。",
    "行者说道：少林绝艺七十二，专精一门，固是大有好处，但如能融贯数艺，则威力更强。",
    "行者说道：本寺弟子如能较技战胜师尊辈，便可名列与彼同班，拜师学习更高深的武艺。"
]


  skills = [
    { skill = "force" level = 50 },
    { skill = "unarmed" level = 50 },
    { skill = "blade" level = 50 },
    { skill = "dodge" level = 50 },
    { skill = "parry" level = 50 },
    { skill = "shaolin-shenfa" level = 50 },
    { skill = "cibei-dao" level = 50 },
    { skill = "shaolin-xinfa" level = 50 },
