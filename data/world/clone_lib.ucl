# 标准库物品：原 LPC /clone 下的物件在 mud/d 转换中无处落放，
# 集中放在本区，商人跨区引用（loader.dereference 支持 <区>.items.<名>.id）。

zones "clone_lib" {
  name = "标准库"
}

