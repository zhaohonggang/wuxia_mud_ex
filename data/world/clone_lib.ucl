chats = [
    "小昭低声吟道：天涯思君不可忘 武当山顶松柏长",
    "小昭低声吟道：宝刀百炼生玄光 字作丧乱意彷徨",
    "小昭低声吟道：皓臂似玉梅花妆 浮槎北溟海茫茫",
    "小昭低声吟道：谁送冰舸来仙乡 穷发十载泛归航",
    "小昭低声吟道：七侠聚会乐未央 百岁寿宴摧肝肠",
    "小昭低声吟道：有女长舌如利枪 针其膏兮药其肓",
    "小昭低声吟道：不悔仲子逾我墙 当道时见中山狼",
    "小昭低声吟道：奇谋妙计梦一场 剥极而复参九阳",
    "小昭低声吟道：青翼出没一笑扬 倚天长剑飞寒芒",
    "小昭低声吟道：祸起萧墙破金汤 与子共穴相扶将",
    "小昭低声吟道：排难解纷当六强 群雄归心约三章",
    "小昭低声吟道：灵芙醉客绿柳庄 太极初传柔克刚",
    "小昭低声吟道：举火燎天何煌煌 俊貌玉面甘损伤",
    "小昭低声吟道：百尺高塔任回翔 恩断义绝紫衫王",
    "小昭低声吟道：四女同舟何所望 东西永隔如参商",
    "小昭低声吟道：刀剑齐失人云亡 冤蒙不白愁欲狂",
    "小昭低声吟道：箫长琴短衣流黄 新妇素手裂红裳",
    "小昭低声吟道：屠狮有会孰为殃 夭矫三松郁青苍",
    "小昭低声吟道：天下英雄莫能当 君子可欺之以方",
    "小昭低声吟道：秘笈兵书此中藏 不识张郎是张郎"
]


