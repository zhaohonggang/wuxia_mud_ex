    items "laozi8" {
      name = "道德经「第八章」"
      description = "第八章 上善若水。水善利万物而不争，处众人之所恶，故几于道。 居善地，心善渊，与善仁，言善信，政善治，事善能，动善时。 夫唯不争，故无尤。"
  verbs = [
    "get",
    "drop"
  ]

