    items "laozi2" {
      name = "道德经「第二章」"
      description = "第二章 天下皆知美之为美，斯恶已。皆知善之为善，斯不善已。 有无相生，难易相成，长短相形，高下相盈，音声相和，前后相 随。恒也。 是以圣人处无为之事，行不言之教；万物作而弗始，生而弗有， 为而弗恃，功成而不居。夫唯弗居，是以不去。"
  verbs = [
    "get",
    "drop"
  ]

