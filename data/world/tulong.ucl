      description = "一踏进石门，一阵金光照射，人人眼花撩乱，凝神屏气，个个张大了口合不 拢来。原来里面竟是个极大的洞穴，四面堆满了金砖银块，珍珠宝石，不计 其数。只是金银珠宝都隐在透明的坚冰之后。料想当年闯王的部属把金银珠 宝藏入之后，浇上冷水。该地终年酷寒，坚冰不融，金珠就似藏在水晶之中 一般。"
  x = 0
  y = 0
  z = 11
    }

  room_exits "baozang" {
    room_id = rooms.baozang.id
    up = rooms.changlang.id
    down = rooms.road1.id
    out = rooms.shimen.id
    }

# Generated from C:/files/git/mud/d/tulong/yubifeng/changlang.c by LPCConverter
# Zone: tulong

    rooms "changlang" {
      name = "长廊"
      description = "这是一条长长的走廊，四处透着浓浓的寒气。出去就是山庄大门，沿这里走 过去可以直达大厅，周围一尘不染，非常安静。"
  x = 0
  y = 0
  z = 12
    }

  room_exits "changlang" {
    room_id = rooms.changlang.id
    up = rooms.fengdi.id
    down = rooms.baozang.id
    north = rooms.dating.id
    out = rooms.damen.id
    }

# Generated from C:/files/git/mud/d/tulong/yubifeng/damen.c by LPCConverter
# Zone: tulong

    rooms "damen" {
      name = "山庄大门"
      description = "转过了几株雪松,只见前面一座五开间极大的石屋，屋前屋后都是白雪。 大门外写着“玉笔峰山庄”几个大字，此处气候酷寒，上下艰难，当初不 知道庄主花了多少的心思才能在此建成如此石室，不禁令人啧啧称奇。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "damen" {
    room_id = rooms.damen.id
    up = rooms.boat.id
    in = rooms.changlang.id
    }

# Generated from C:/files/git/mud/d/tulong/yubifeng/dating.c by LPCConverter
# Zone: tulong

    rooms "dating" {
      name = "大厅"
      description = "那厅极大，四角各生着一盆大炭火。厅上居中挂着一副木板对联，写着 廿二个大字：'不来辽东大言天下无敌手,邂逅冀北方信世间有英雄'。 上款是“希孟仁兄正之”，下款是“妄人苗人凤深惭昔年狂言醉后涂鸦”。"
  x = 0
  y = 1
  z = 12
    }

