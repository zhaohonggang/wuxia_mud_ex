# Generated from C:/files/git/mud/d/tulong/tulong/haigang.c by LPCConverter
# Zone: tulong

    rooms "haigang" {
      name = "东海之滨"
      description = "这里就是大海之滨，浪花拍打着礁石，发出阵阵响声，海 面上一群群海鸥欧欧地叫着，不时有鱼儿跃出海面，溅起层层 浪花。边上有艘大船(boat)，船上坐着几个渔夫打扮的人，乘 船可渡过大海到达海的另一端。西面一直走就是燕京了，东面 是一望无际的大海。极目眺望不禁让人心胸开扩神舒意畅，的 确是一个好居处。"
  x = 0
  y = -1
  z = 4
item_desc = {
 boat = "这是一艘大帆船，造得很结实，看来可以出远海的。"
}
    }

