characters "town_crier" {
  name = "报讯人 Town Crier"
  description = "一个嗓门洪亮的矮个子男人。A small man with a loud voice."

  initial_events = [
    {
      topic = "characters/emote"
      delay = 3000
      data = {
        id = "looking"
        message = "环顾四周，想找个人聊聊。 looks around for someone to talk to."
      }
    }
  ]

  brain = brains.town_crier
}

characters "villager" {
  name = "村民 Villager"
  description = "萨玛蒂的一名村民。A villager of Sammatti."

  brain = brains.villager
}

characters "wandering_villager" {
  name = "村民 Villager"
  description = "萨玛蒂的一名村民。A villager of Sammatti."

  initial_events = [
    {
      topic = "characters/move"
      delay = 5000
      data = {
        id = "wander"
      }
    }
  ]

  brain = brains.wandering_villager
}
