zones "sammatti" {
  name = "萨玛蒂 Sammatti"
}

rooms "town_square" {
  name = "城镇广场 Town Square"
  description = "你正站在小镇的广场中央。You are in the town square."

  map_icon = "wooden-sign"

  x = 0
  y = 0
  z = 0

  features = [
    {
      keyword = "Lohikäärme"
      short = "东边是小酒馆洛希卡迈。To the east is Lohikäärme, a small inn."
      long = "东边是小酒馆洛希卡迈。To the east is Lohikäärme, a small inn."
    },
    {
      keyword = "Seppä"
      short = "西边是当地的铁匠铺塞帕。To the west is Seppä, the local blacksmith."
      long = "西边是当地的铁匠铺塞帕。To the west is Seppä, the local blacksmith."
    }
  ]
}

room_exits "town_square" {
  room_id = rooms.town_square.id

  north = rooms.marketplace.id
  east = rooms.inn.id
  west = rooms.blacksmith.id

  south = "kissa-jarvi.rooms.gates.id"
}

room_characters "town_square" {
  room_id = rooms.town_square.id

  characters = [
    {
      id = characters.town_crier.id
    },
    {
      id = characters.wandering_villager.id
    }
  ]
}

room_items "town_square" {
  room_id = rooms.town_square.id

  items = [
    {
      id = global.items.longsword.id
    },
    {
      id = global.items.potion.id
    }
  ]
}

rooms "marketplace" {
  name = "集市 Marketplace"
  description = "小贩们在你四周叫卖着各自的货物。There are sellers hawking their wares all around you."

  map_icon = "shop"

  x = 0
  y = 1
  z = 0
}

room_exits "marketplace" {
  room_id = rooms.marketplace.id

  east = rooms.well.id
  north = rooms.guild_hall.id
  south = rooms.town_square.id
  west = rooms.main-street-1.id
}

rooms "inn" {
  name = "洛希卡迈酒馆 Lohikäärme"
  description = "小酒馆的店内。桌边摆着几把椅子，一段小楼梯通向楼上。The interior of the small inn. There are several chairs sitting around a table. A small staircase leads upstairs."

  map_color = "yellow"
  map_icon = "stein"

  x = 1
  y = 0
  z = 0
}

room_exits "inn" {
  room_id = rooms.inn.id

  west = rooms.town_square.id
  up = rooms.inn_upstairs.id
}

room_characters "inn" {
  room_id = rooms.inn.id

  characters = [
    {
      id = characters.villager.id
      name = "塔皮奥 Tapio"
    }
  ]
}

rooms "inn_upstairs" {
  name = "洛希卡迈楼上 Lohikäärme Upstairs"
  description = "小酒馆的楼上。一段小楼梯通向楼下。The upstairs of the small inn. A small staircase leads downstairs."

  x = 1
  y = 0
  z = 1
}

room_exits "inn_upstairs" {
  room_id = rooms.inn_upstairs.id

  down = rooms.inn.id
}

rooms "well" {
  name = "镇口水井 Town Well"
  description = "小镇的一口水井。A small well for the town"

  map_color = "green"
  map_icon = "well"

  x = 1
  y = 1
  z = 0

  features = [
    {
      keyword = "well"
      short = "路旁有一口井，吊着水桶。A well with a bucket dangling is off to the side of the road in this part of town."
      long = "路旁有一口井，吊着水桶。A well with a bucket dangling is off to the side of the road in this part of town."
    }
  ]
}

room_exits "well" {
  room_id = rooms.well.id

  north = rooms.park-3.id
  east = rooms.park-1.id
  west = rooms.marketplace.id
}

