      { id = items.xiang.id }    ]
  }

# Generated from C:/files/git/mud/d/quanzhou/chiqian.c by LPCConverter
# Zone: quanzhou

    rooms "chiqian" {
      name = "赤嵌城"
      description = "此地为台湾府驻所。台湾开化未久，国姓爷东征，收 复此城，围困红毛鬼达两年之久，终致金瓯无缺。     城外海港，有舟(zhou)船来往澎湖。"
  x = 0
  y = 0
  z = 3
item_desc = {
 zhou = "一条兵舟，往返澎湖的交通兵船。"
}
    }

