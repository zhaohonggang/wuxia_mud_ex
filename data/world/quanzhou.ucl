    rooms "nanhu1" {
      name = "嘉兴南湖"
      description = "这里是烟波浩淼的南湖。湖上几只画舫在游荡，船上的游客和青 楼女子在嘻笑。湖水很深，没有船是渡不过去的。但不知是谁在湖底 钉了一些木桩。桩顶潜在水面之下一两寸的地方。即使是不懂轻功的 人走上去也像是水上漂的样子。"
  x = 1
