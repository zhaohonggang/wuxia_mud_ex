# Generated from C:/files/git/mud/d/quanzhou/majiu1.c by LPCConverter
# Zone: quanzhou

    rooms "majiu1" {
      name = "马厩"
      description = "这是泉州城的马厩，常年供应新鲜草料。泉州商业发达，因此这里生 意兴隆，马夫们好生照看马匹，将它们喂饱饮足，再洗刷得干乾净净，一 直伺候到客人上路。马厩雨檐下的烂木柱上钉着一块破木牌(paizi)。     马厩中堆放著几堆草料，正中有一口泔槽。"
  x = 1
  y = -1
  z = 0
    }

