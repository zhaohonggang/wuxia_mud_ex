    rooms "jiaxing" {
      name = "嘉兴城"
      description = "这里是江南名城嘉兴。城东是风景如画的南湖。城北早先有座醉仙楼， 当年全真七子之一的丘处机和江南七怪就在那里盟约寻找忠良之后。不知 道什么原因店主把它迁到扬州了。"
  x = -1
