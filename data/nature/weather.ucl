    },
    {
      hour = 9
      time_msg = "炎阳似火"
      desc_msg = "太阳白花花地烤着街道，蝉声嘶鸣，空气都是烫的。"
      outcolor = "yellow"
    },
    {
      hour = 12
      time_msg = "正午酷暑"
      desc_msg = "正午的日头毒辣，狗都躲进树荫吐着舌头，街上几乎无人走动。"
      outcolor = "yellow"
    },
    {
      hour = 15
      time_msg = "午后蒸笼"
      desc_msg = "暑气蒸腾，热浪在地面上颤巍巍地流动，教人只想寻个凉处。"
      outcolor = "yellow"
    },
    {
      hour = 18
      time_msg = "夕照仍炎"
      desc_msg = "日头偏西仍不减威风，把人的影子拉得又长又烫。"
      outcolor = "red"
    },
    {
      hour = 21
      time_msg = "夏夜溽热"
      desc_msg = "夜虽黑下来，余热未散，扑扇声和蛙鸣混作一片。"
      outcolor = "white"
    }
  ]
}

