      outcolor = "blue"
    },
    {
      hour = 6
      time_msg = "雨后初霁"
      desc_msg = "雨停了，满街积水映着天光，蝉声被雨水洗得格外清亮。"
      outcolor = "green"
    },
    {
      hour = 9
      time_msg = "闷热回潮"
      desc_msg = "日头一出，地上腾起一股湿热的水气，闷得人透不过气。"
      outcolor = "white"
    },
    {
      hour = 12
      time_msg = "午后暴雨"
      desc_msg = "午后天边涌起墨云，哗啦啦一场急雨，把行人浇得四散躲避。"
      outcolor = "blue"
    },
    {
      hour = 15
      time_msg = "阵雨如注"
      desc_msg = "阵雨时来时去，屋檐挂起一道道水帘，天地一片白茫茫。"
      outcolor = "blue"
    },
    {
      hour = 18
      time_msg = "晚雨湿街"
      desc_msg = "暮色里又飘起细雨，灯火倒映在湿滑的石板路上，朦朦胧胧。"
      outcolor = "blue"
    },
    {
      hour = 21
      time_msg = "夜雨闷雷"
      desc_msg = "远处闷雷滚动，雨丝斜织，暑气在雨声中再添几分黏腻。"
      outcolor = "blue"
    }
  ]
}

phases "summer_sun" {
  table = [
    {
      hour = 0
      time_msg = "暑夜星繁"
      desc_msg = "天热得连风都是烫的，唯有檐下还存着一丝凉气。"
      outcolor = "white"
    },
    {
      hour = 3
      time_msg = "薄明初凉"
