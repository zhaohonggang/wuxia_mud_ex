# Q2-T2 天象时段表（数据源，由 lib/kantele/world/weather/data.ex 编译期加载）
# 四季 × 3 天气 = 12 套表；每套 8 段，每 3 游戏时一档（hour = 0,3,6,9,12,15,18,21）。
# 字段对齐 LPC adm/etc/nature：hour / time_msg（时辰语）/ desc_msg（天象描写）/ outcolor（展示色）。

phases "spring_rain" {
  table = [
    {
      hour = 0
      time_msg = "夜深雨巷"
      desc_msg = "细雨敲窗，檐角水珠滴答不绝，镇中石板路泛起一片湿亮。"
      outcolor = "blue"
    },
    {
      hour = 3
      time_msg = "拂晓微雨"
      desc_msg = "天蒙蒙亮，春雾混着雨丝贴着街面流动，连脚步声都显得潮润。"
      outcolor = "blue"
    },
    {
      hour = 6
      time_msg = "晨雨初歇"
      desc_msg = "雨势渐缓，柳条垂着水珠，山间新绿被洗得发亮。"
      outcolor = "green"
    },
    {
      hour = 9
      time_msg = "午前薄雨"
      desc_msg = "云层低垂，细雨时断时续，镇口茶棚里挤满了躲雨的行人。"
      outcolor = "white"
    },
    {
      hour = 12
      time_msg = "午间雨幕"
      desc_msg = "雨声渐密，打在青瓦上如万点鼓点，官道上溅起蒙蒙白雾。"
      outcolor = "blue"
    },
    {
      hour = 15
      time_msg = "午后云开"
      desc_msg = "雨住云开一线，阳光斜照，水珠在树梢上闪闪发亮。"
      outcolor = "yellow"
    },
    {
      hour = 18
      time_msg = "暮色残雨"
      desc_msg = "暮色四合，余雨未净，远山笼着一层淡淡的水气。"
      outcolor = "white"
    },
    {
      hour = 21
      time_msg = "初更再雨"
      desc_msg = "初更时分又飘起细雨，家家灯火映在湿漉漉的街面上。"
      outcolor = "blue"
    }
  ]
}

phases "spring_sun" {
  table = [
    {
      hour = 0
      time_msg = "春夜微凉"
      desc_msg = "月光如水，风里混着嫩草与泥土的气息，四下静谧。"
      outcolor = "white"
    },
    {
      hour = 3
      time_msg = "曙色初露"
      desc_msg = "东方泛起鱼肚白，早起的鸟雀已在枝头啾鸣。"
      outcolor = "green"
    },
    {
      hour = 6
      time_msg = "清晨新晴"
      desc_msg = "朝阳爬上柳梢，露珠在草尖上滚落，空气清新得醉人。"
      outcolor = "yellow"
    },
    {
      hour = 9
      time_msg = "日上三竿"
      desc_msg = "晴空万里，春风和暖，官道上人来人往，正是赶路的好时辰。"
      outcolor = "yellow"
    },
    {
      hour = 12
      time_msg = "正午春阳"
      desc_msg = "日头正中，晒得石板路微微发烫，柳荫下有人打起了盹。"
      outcolor = "yellow"
    },
    {
      hour = 15
      time_msg = "午后暖阳"
      desc_msg = "日光斜照，桃花杏花开得正好，蜂蝶绕着花枝打转。"
      outcolor = "yellow"
    },
    {
      hour = 18
      time_msg = "夕照满山"
      desc_msg = "落日熔金，把镇子的屋脊和远山都镀上一层金边。"
      outcolor = "red"
    },
    {
      hour = 21
      time_msg = "春夜灯市"
      desc_msg = "星疏月朗，微风送爽，灯影把酒旗拉得老长。"
      outcolor = "white"
    }
  ]
}

phases "spring_wind" {
  table = [
    {
      hour = 0
      time_msg = "夜风穿巷"
      desc_msg = "风一阵紧似一阵，窗纸扑扑作响，杨花飞得满街都是。"
      outcolor = "white"
    },
    {
      hour = 3
      time_msg = "晓风抖梢"
      desc_msg = "天未大亮，风却先醒了，把屋檐下晾的衣衫吹得猎猎作响。"
      outcolor = "white"
    },
    {
      hour = 6
      time_msg = "晨风扬尘"
      desc_msg = "春风浩荡，卷起古道上的浮土，行人个个眯眼掩面。"
      outcolor = "yellow"
    },
    {
      hour = 9
      time_msg = "长风贯镇"
      desc_msg = "风越刮越急，酒旗猎猎，茶棚的布帘被吹得鼓鼓囊囊。"
      outcolor = "white"
    },
    {
      hour = 12
      time_msg = "当午疾风"
      desc_msg = "午后风势不减，飞沙走石，树梢被压得抬不起头。"
      outcolor = "grey"
    },
    {
      hour = 15
      time_msg = "风卷残云"
      desc_msg = "云被风撕扯成一片片，天光忽明忽暗，风声呜呜直响。"
      outcolor = "white"
    },
    {
      hour = 18
      time_msg = "傍晚风凉"
      desc_msg = "暮风渐凉，吹得人衣袂飘飘，归鸦被风托着掠过头顶。"
      outcolor = "white"
    },
    {
      hour = 21
      time_msg = "初更风吼"
      desc_msg = "入夜风更紧，吹得灯笼摇摇晃晃，街上几乎没了人迹。"
      outcolor = "blue"
    }
  ]
}

phases "summer_rain" {
  table = [
    {
      hour = 0
      time_msg = "暑夜骤雨"
      desc_msg = "夜半一声闷雷，倾盆大雨瞬间浇透全镇，暑气被冲散了大半。"
      outcolor = "blue"
    },
    {
      hour = 3
      time_msg = "雷雨未歇"
