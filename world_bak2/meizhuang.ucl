zones "meizhuang" {
  name = "meizhuang"
}

# Generated from C:/files/git/mud/d/meizhuang/chufang.c by LPCConverter
# Zone: meizhuang

    rooms "chufang" {
      name = "厨房"
      description = "你顺着香味走到了梅庄的厨房，一位厨师正站在灶台后面笑眯眯 的看着你，他手上拿着一柄铁勺，用力的把锅里煮着的一大堆食物搅 匀，梅庄的弟子们如果饿了，就到这里来问这位厨师能不能吃饭，一 般来说，他们都不会遭到拒绝的。"
  x = 0
  y = 0
  z = 1
    }

  room_exits "chufang" {
    room_id = rooms.chufang.id
    up = rooms.didao1.id
    down = rooms.gate.id
    east = rooms.zoulang3.id
    }

# Generated from C:/files/git/mud/d/meizhuang/dating.c by LPCConverter
# Zone: meizhuang

    rooms "dating" {
      name = "四雅清风"
      description = "你已经到了梅庄的大厅门口，门内的匾额(bian)龙飞凤舞的写着 “四雅清风”四个大字，笔法娟秀中透着挺拔，不失为一笔好字。透 过后门，你看到里面一尘不染，一张石桌和几个石凳都安放得整整齐 齐。"
  x = 1
  y = -6
  z = 1
    }

  room_exits "dating" {
    room_id = rooms.dating.id
    south = rooms.tianjing.id
    north = rooms.keting.id
    }

