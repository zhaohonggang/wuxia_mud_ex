# Generated from C:/files/git/mud/d/meizhuang/gate.c by LPCConverter
# Zone: meizhuang

    rooms "gate" {
      name = "梅庄大门"
      description = "走过一大片梅林，走上一条青石板大路，来到一座朱门白墙的大 庄院外，行到近处，见大门外写着“梅庄”两个大字，旁边署着“虞 允文题”四字。那虞允文是南宋破金的大功臣，这几个字儒雅之中透 着勃勃英气。"
  x = 0
  y = 0
  z = 0
    }

  room_exits "gate" {
    room_id = rooms.gate.id
    up = rooms.chufang.id
    south = rooms.xiaolu.id
    }

# Generated from C:/files/git/mud/d/meizhuang/houting.c by LPCConverter
# Zone: meizhuang

    rooms "houting" {
      name = "后厅"
      description = "这里是孤山梅庄的后厅，后厅内相当的宽敞明亮，四周的墙上悬 挂满了各朝名人的真迹，正堂坐着一个极高极瘦的黑衣老者，那老者 眉清目秀，只是脸色泛白，似乎是一具僵尸模样，令人一见之下，心 中便感到一阵凉意。大厅往南是一条走廊。"
  x = 1
  y = 1
  z = 1
    }

  room_exits "houting" {
    room_id = rooms.houting.id
    south = rooms.zoulang3.id
    }




  room_items "houting" {
    room_id = rooms.houting.id
    items = [
      { id = items.heibai.id }    ]
  }

# Generated from C:/files/git/mud/d/meizhuang/huashi.c by LPCConverter
# Zone: meizhuang

    rooms "huashi" {
      name = "画室"
      description = "这里是丹青生的画室，俗话说：书画不分家，所以丹青生的书法 也有相当的功力，虽然不及他三哥秃笔翁很多，但他将他的剑法融于 他的书法当中，也可谓是银钩铁画了。这里的陈设和书室差不多，唯 一不同的是这里的墙上并没有挂丹青生的丹青妙笔，而是挂了许多前 朝名家的名画，属于丹青生自己的是一幅写着《兵车行》的中堂。"
  x = 2
  y = -2
  z = 1
    }

  room_exits "huashi" {
    room_id = rooms.huashi.id
    west = rooms.zoulang1.id
    }




  room_items "huashi" {
    room_id = rooms.huashi.id
    items = [
      { id = items.danqing.id }    ]
  }

