    rooms "qhpo" {
      name = "奇槐坡"
      description = "这里就是奇槐坡了，这里种着大大小小，千奇百怪的槐树，有的 槐树一直向天，有的又曲折盘绕，你从这里隐隐约约听到一阵阵的琴 声，似有似无，若隐若现。"
  x = 3
