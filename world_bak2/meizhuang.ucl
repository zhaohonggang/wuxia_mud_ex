# Zone: meizhuang

    rooms "laofang" {
      name = "牢房"
      description = "这里有一张铁床，上面还依稀有一个人(man)，似乎被铁镣锁着， 躺在那里一动不动。"
  x = 0
  y = 2
  z = 3
item_desc = {
 man = "这个人如同稀泥一般，双目涣散，没有一点神采。整个人似乎只剩下 了一个干枯的躯壳，然而却还有一口气，如果不是铁镣锁着，也许可 以把他搬下床来。"
}
    }

