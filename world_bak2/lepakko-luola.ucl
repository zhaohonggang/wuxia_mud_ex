zones "lepakko-luola" {
  name = "蝙蝠洞 Lepakko Luola"
}

rooms "cave-outside" {
  name = "洞穴入口 Cave Entrance"
  description = "一块岩石从地面隆起，可以看到一个洞穴入口。A rock juts up out of the ground and an entrance to a cave can be seen."

  x = 0
  y = 0
  z = 0
}

room_exits "cave-outside" {
  room_id = rooms.cave-outside.id

  north = kissa-jarvi.rooms.lake-4.id
  down = rooms.cave-entrance.id
}

rooms "cave-entrance" {
  name = "洞口之内 Cave Entrance"
  description = "洞穴的岩壁微微泛潮。The walls of the cave are slightly damp."

  x = 0
  y = 0
  z = -1
}

room_exits "cave-entrance" {
  room_id = rooms.cave-entrance.id

  up = rooms.cave-outside.id
}
