# Zone: qingcheng

    rooms "zhuhezhuang" {
      name = "驻鹤庄"
      description = "驻鹤庄相传为仙人休息赏玩之所。常有成群丹顶鹤栖息、飞鸣 于林间。"
  x = 2
  y = 0
