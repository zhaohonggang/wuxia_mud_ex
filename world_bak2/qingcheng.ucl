zones "qingcheng" {
  name = "qingcheng"
}

# Generated from C:/files/git/mud/d/qingcheng/chaoyangdong.c by LPCConverter
# Zone: qingcheng

    rooms "chaoyangdong" {
      name = "朝阳洞"
      description = "你来到朝阳洞。洞深广数丈，相传是宁封子栖息处。这里也是 观日好去处，“古洞常临光照耀”，正是指旭日东升，霞光透过绿 荫，射到洞口，一片璀灿绚丽的景色。"
  x = 1
  y = 1
  z = 3
    }

  room_exits "chaoyangdong" {
    room_id = rooms.chaoyangdong.id
    northup = rooms.sanwanjiudao.id
    westdown = rooms.zushidian.id
    }


  room_characters "chaoyangdong" {
    room_id = rooms.chaoyangdong.id
    characters = [
      { id = characters.hong.id }    ]
  }

# Generated from C:/files/git/mud/d/qingcheng/gulongqiao.c by LPCConverter
# Zone: qingcheng

    rooms "gulongqiao" {
      name = "古龙桥"
      description = "你走在古龙桥上。望见岩壁上一个大裂槽。宽二十余丈深，深 达六、七丈，传说是张天师降魔时以笔划山而过的仙家痕迹。"
  x = 0
  y = 0
  z = 1
    }

  room_exits "gulongqiao" {
    room_id = rooms.gulongqiao.id
    southdown = rooms.tianshidong.id
    northup = rooms.zushidian.id
    }

# Generated from C:/files/git/mud/d/qingcheng/huyingting.c by LPCConverter
# Zone: qingcheng

    rooms "huyingting" {
      name = "呼应亭"
      description = "呼应亭高居彭祖峰顶，是青城最高处。登临长啸，余音回荡， 众山皆应。看雪岭光腾，红吞沧海，锦江春涨，绿到瀛洲。夏日夜 分，有圣灯浮云，传说是神仙朝贺张天师所点仙灯，看来让人感叹 不已。"
  x = 1
  y = 2
  z = 6
    }

  room_exits "huyingting" {
    room_id = rooms.huyingting.id
    eastdown = rooms.shangqing.id
    }


  room_characters "huyingting" {
    room_id = rooms.huyingting.id
    characters = [
      { id = characters.hou.id }    ]
  }

# Generated from C:/files/git/mud/d/qingcheng/jianfugong.c by LPCConverter
# Zone: qingcheng

    rooms "jianfugong" {
      name = "建福宫"
      description = "建福宫旧称丈人观，以其座落丈人峰下故也。相传五岳丈人宁 封子修道于此。院内树木假山，相互掩映；周围林木苍翠，浓荫蔽 日，炎夏来此，十分凉爽。这里也是上山的起点。"
  x = 4
  y = -2
  z = -3
    }

  room_exits "jianfugong" {
    room_id = rooms.jianfugong.id
    northwest = rooms.path1.id
    south = rooms.xiaoqiao.id
    }


  room_characters "jianfugong" {
    room_id = rooms.jianfugong.id
    characters = [
      { id = characters.ji.id },
      { id = characters.shen.id }    ]
  }

# Generated from C:/files/git/mud/d/qingcheng/maguchi.c by LPCConverter
# Zone: qingcheng

    rooms "maguchi" {
      name = "麻姑池"
      description = "上清殿右是麻姑池，亦称天池。池深数尺，形如半月，水色清 澈，四季久雨不盈，长旱不涸。"
  x = 3
  y = 2
  z = 5
    }

  room_exits "maguchi" {
    room_id = rooms.maguchi.id
    west = rooms.shangqing.id
    }

# Generated from C:/files/git/mud/d/qingcheng/path1.c by LPCConverter
# Zone: qingcheng

    rooms "path1" {
      name = "盘山磴道"
      description = "你走在盘山磴道上。山木蔽日，幽静宜人。过了“青城”木牌 楼，西上就是天然图画了。东南方向是建福宫。"
  x = 3
  y = -1
  z = -3
    }

  room_exits "path1" {
    room_id = rooms.path1.id
    westup = rooms.tianran.id
    southeast = rooms.jianfugong.id
    }

# Generated from C:/files/git/mud/d/qingcheng/path2.c by LPCConverter
# Zone: qingcheng

    rooms "path2" {
      name = "青城山路"
      description = "你走在青城山路上。山木蔽日，幽静宜人。西上就是天师洞， 东边是天然图画。"
  x = 1
  y = -1
  z = -1
    }

  room_exits "path2" {
    room_id = rooms.path2.id
    eastdown = rooms.tianran.id
    westup = rooms.tianshidong.id
    }

# Generated from C:/files/git/mud/d/qingcheng/qcroad1.c by LPCConverter
# Zone: qingcheng

    rooms "qcroad1" {
      name = "青石大道"
      description = "你走在青石大道上。两边是稀硫的树林和连片的田野。一条条 小溪和路平行，溪流清澈见底，水流甚急。"
  x = 5
  y = -5
  z = -3
    }

  room_exits "qcroad1" {
    room_id = rooms.qcroad1.id
    west = rooms.qcroad2.id
    south = rooms.fuheqiaon.id
    }

# Generated from C:/files/git/mud/d/qingcheng/qcroad2.c by LPCConverter
# Zone: qingcheng

    rooms "qcroad2" {
      name = "青泥小道"
      description = "你走在青泥小道上。左边不远传来阵阵水响，原来那里就是天 下知名都江堰。拦河分流，使岷江之水分注到无数小小溪流中，才 免了连年的水祸，灌溉出了这富饶的成都平原。"
  x = 4
  y = -5
  z = -3
    }

  room_exits "qcroad2" {
    room_id = rooms.qcroad2.id
    east = rooms.qcroad1.id
    north = rooms.qcroad3.id
    }

# Generated from C:/files/git/mud/d/qingcheng/qcroad3.c by LPCConverter
# Zone: qingcheng

    rooms "qcroad3" {
      name = "青石大道"
      description = "你走在青石大道上。远远传来细细的水声，掩盖在路边密密树 林的风声中。望北可以看到一座大山了，苍苍翠翠，象一块清清纯 纯的碧玉。"
  x = 4
  y = -4
  z = -3
    }

  room_exits "qcroad3" {
    room_id = rooms.qcroad3.id
    north = rooms.xiaoqiao.id
    south = rooms.qcroad2.id
    }

# Generated from C:/files/git/mud/d/qingcheng/sandaoshi.c by LPCConverter
# Zone: qingcheng

    rooms "sandaoshi" {
      name = "三岛石"
      description = "三岛石上刻“降魔”二字，相传为张天师当年降魔，因巨石当 道，挥剑力劈，石裂为三，成为三块相连的岛石。石裂处自然生成 石梯。"
  x = 1
  y = -1
  z = 0
    }

  room_exits "sandaoshi" {
    room_id = rooms.sandaoshi.id
    eastdown = rooms.tingquanting.id
    west = rooms.tianshidong.id
    }

# Generated from C:/files/git/mud/d/qingcheng/sanqingdian.c by LPCConverter
# Zone: qingcheng

    rooms "sanqingdian" {
      name = "三清殿"
      description = "古常道观的中心是三清殿。殿中供奉三清教主：玉清原始天尊、 上清灵宝天尊和太清太上老君。原始天尊手拿圆珠，象征洪元；灵 宝天尊怀抱太极图，象征混元；太上老君手持扇子，象征太初。殿 旁有一对联(lian)，著墨极浓。"
  x = 0
  y = 0
  z = 0
item_desc = {
 lian = "一      地      生      法      二      天      二      天      生      法      三      道      三      道      生      法      万      自      物      然"
}
    }

  room_exits "sanqingdian" {
    room_id = rooms.sanqingdian.id
    south = rooms.tianshidong.id
    }

# Generated from C:/files/git/mud/d/qingcheng/sanwanjiudao.c by LPCConverter
# Zone: qingcheng

    rooms "sanwanjiudao" {
      name = "三弯九倒"
      description = "山势越来越陡峭，石梯几近壁立，拐过观日亭，远远看到青城 山巅，高台山之阳的飞檐流瓦，上清宫到了。"
  x = 1
  y = 2
  z = 4
    }

  room_exits "sanwanjiudao" {
    room_id = rooms.sanwanjiudao.id
    eastup = rooms.shangqing.id
    southdown = rooms.chaoyangdong.id
    }

# Generated from C:/files/git/mud/d/qingcheng/shangqing.c by LPCConverter
# Zone: qingcheng

    rooms "shangqing" {
      name = "上清宫"
      description = "上清宫是老君道场。宫前山门，矮树搭就，甚为灵动。宫内殿 堂古色清雅，正殿供奉太上老君、吕纯阳和张三丰塑像。山前摩崖 石刻 '天下第五名山' 气势浑厚，很是壮观。"
  x = 2
  y = 2
  z = 5
    }

  room_exits "shangqing" {
    room_id = rooms.shangqing.id
    south = rooms.songfengguan.id
    east = rooms.maguchi.id
    west = rooms.yuanyangjing.id
    westup = rooms.huyingting.id
    westdown = rooms.sanwanjiudao.id
    }

# Generated from C:/files/git/mud/d/qingcheng/songfengguan.c by LPCConverter
# Zone: qingcheng

    rooms "songfengguan" {
      name = "松风观"
      description = "这里是松风观，是青城派总所。青城派威镇川中，以其人才辈 出之故。当今掌门人余沧海道长，虽其貌不扬，身形矮小，却是青 城一代宗师。观中陈设奢华，显见青城派财力不菲。"
  x = 2
  y = 1
  z = 5
    }

  room_exits "songfengguan" {
    room_id = rooms.songfengguan.id
    north = rooms.shangqing.id
    }


  room_characters "songfengguan" {
    room_id = rooms.songfengguan.id
    characters = [
      { id = characters.hai.id }    ]
  }

# Generated from C:/files/git/mud/d/qingcheng/tianran.c by LPCConverter
# Zone: qingcheng

    rooms "tianran" {
      name = "天然图画"
      description = "这里岩壁矗立，绿树映辉，牌阁在山垭间巍然屹立。四顾峰奇 石异，云雾缥缈，远近观赏，如在画中。阁左“天生桥”，一石丈 余飞插石壁之间，十分险峻。"
  x = 2
  y = -1
  z = -2
    }

  room_exits "tianran" {
    room_id = rooms.tianran.id
    north = rooms.zhuhezhuang.id
    westup = rooms.path2.id
    eastdown = rooms.path1.id
    }

# Generated from C:/files/git/mud/d/qingcheng/tianshidong.c by LPCConverter
# Zone: qingcheng

    rooms "tianshidong" {
      name = "天师洞"
      description = "天师洞以东汉张陵在此讲道修炼而得名，又名古常道观。洞在 山腰混元顶下峭壁间。中塑天师像，沿岩壁有廊可通。正殿名三皇 殿，重檐回廊，雄锯高台，气势宏伟。内供伏羲、神农、轩辕三皇 石刻造像。"
  x = 0
  y = -1
  z = 0
    }

  room_exits "tianshidong" {
    room_id = rooms.tianshidong.id
    east = rooms.sandaoshi.id
    west = rooms.yinxing.id
    eastdown = rooms.path2.id
    north = rooms.sanqingdian.id
    northup = rooms.gulongqiao.id
    }

# Generated from C:/files/git/mud/d/qingcheng/tingquanting.c by LPCConverter
# Zone: qingcheng

    rooms "tingquanting" {
      name = "听泉亭"
      description = "沿石梯向下，就是海棠溪。这里是溪上的听泉亭，四顾山环水 绕，古藤蔓蔓，飞泉溅落池中，如琴弦轻拨，如珠落玉盘，清绝幽 绝。"
  x = 2
  y = -1
  z = -1
    }

  room_exits "tingquanting" {
    room_id = rooms.tingquanting.id
    westup = rooms.sandaoshi.id
    }


  room_characters "tingquanting" {
    room_id = rooms.tingquanting.id
    characters = [
      { id = characters.luo.id }    ]
  }

# Generated from C:/files/git/mud/d/qingcheng/xiaoqiao.c by LPCConverter
# Zone: qingcheng

    rooms "xiaoqiao" {
      name = "小桥"
      description = "小桥横跨小溪上。溪水清澈，游鱼卵石斑驳可数。桥北面就是 青城建福宫了。青城是道家发轫之处，号道教的“第五洞天”，相 传东汉张陵在此结庐传授五斗米道，至今宫阙连绵，传道嗣法不绝。"
  x = 4
  y = -3
  z = -3
    }

  room_exits "xiaoqiao" {
    room_id = rooms.xiaoqiao.id
    north = rooms.jianfugong.id
    south = rooms.qcroad3.id
    }

# Generated from C:/files/git/mud/d/qingcheng/yinxing.c by LPCConverter
# Zone: qingcheng

    rooms "yinxing" {
      name = "古银杏树"
      description = "观前古银杏树相传为张天师手植，高可十余丈，腰围七、八人 合抱，枝叶扶疏，苍盖如云。"
  x = -1
  y = -1
  z = 0
    }

  room_exits "yinxing" {
    room_id = rooms.yinxing.id
    east = rooms.tianshidong.id
    }

# Generated from C:/files/git/mud/d/qingcheng/yuanyangjing.c by LPCConverter
# Zone: qingcheng

    rooms "yuanyangjing" {
      name = "鸳鸯井"
      description = "上清殿左有鸳鸯井，一方一圆，泉流暗通。圆者水浊，方者水 清。井水一温一凉，昔人题诗曰：“谁知上界神仙客，也与炎凉世 态同”。"
  x = 1
  y = 2
  z = 5
    }

  room_exits "yuanyangjing" {
    room_id = rooms.yuanyangjing.id
    east = rooms.shangqing.id
    }

